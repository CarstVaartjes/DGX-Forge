def _open_staged_candidate(request: dict[str, Any]) -> int:
    root = _path(UPDATE_STAGING_ROOT)
    expected_owner = _agent_owner()
    parent = -1
    state_root = -1
    directory = -1
    try:
        # The unprivileged agent legitimately owns its fixed state root because
        # operation journals, credentials, caches, and update staging live there.
        # Walk root-owned /var/lib first, then accept only the two fixed 0700
        # service-owned components; no caller-controlled suffix is permitted.
        parent = _open_directory_ancestry(root.parent.parent)
        state_root = os.open(
            root.parent.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        os.close(parent)
        parent = -1
        state_metadata = os.fstat(state_root)
        if (
            state_metadata.st_uid != expected_owner
            or stat.S_IMODE(state_metadata.st_mode) != 0o700
        ):
            raise SupervisorError("candidate state root is unsafe")
        directory = os.open(
            root.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=state_root,
        )
        os.close(state_root)
        state_root = -1
    except SupervisorError:
        raise
    except (FileNotFoundError, OSError) as error:
        raise SupervisorError("staged candidate is unavailable") from error
    finally:
        if parent >= 0:
            os.close(parent)
        if state_root >= 0:
            os.close(state_root)
    descriptor = -1
    try:
        metadata = os.fstat(directory)
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise SupervisorError("candidate staging directory is unsafe")
        descriptor = os.open(
            f"{request['sha256']}.agent",
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
        candidate = os.fstat(descriptor)
        if (
            candidate.st_uid != expected_owner
            or stat.S_IMODE(candidate.st_mode) != 0o500
            or not stat.S_ISREG(candidate.st_mode)
            or candidate.st_nlink != 1
            or candidate.st_size != request["size"]
        ):
            raise SupervisorError("staged candidate path is unsafe")
        return descriptor
    except SupervisorError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise SupervisorError("staged candidate is unavailable") from error
    finally:
        os.close(directory)


def _write_atomic_at(
    directory: int, name: str, raw: bytes, *, mode: int, label: str
) -> None:
    temporary = f".{name}.{secrets.token_hex(12)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            mode,
            dir_fd=directory,
        )
        os.fchmod(descriptor, mode)
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.rename(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=directory)
        except OSError:
            pass
        raise SupervisorError(f"{label} publication failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _cleanup_slot_staging(directory: int) -> None:
    changed = False
    try:
        names = os.listdir(directory)
    except OSError as error:
        raise SupervisorError("slot staging cleanup failed") from error
    for name in names:
        if SLOT_STAGING.fullmatch(name) is None:
            continue
        descriptor = -1
        try:
            descriptor = os.open(
                name,
                os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=directory,
            )
            metadata = os.fstat(descriptor)
            if (
                metadata.st_uid != _owner()
                or not stat.S_ISREG(metadata.st_mode)
                or metadata.st_nlink != 1
                or metadata.st_size > EXECUTABLE_LIMIT
            ):
                raise SupervisorError("slot staging path is unsafe")
            os.unlink(name, dir_fd=directory)
            changed = True
        except SupervisorError:
            raise
        except OSError as error:
            raise SupervisorError("slot staging cleanup failed") from error
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    if changed:
        try:
            os.fsync(directory)
        except OSError as error:
            raise SupervisorError("slot staging cleanup failed") from error


def _install_candidate(request: dict[str, Any]) -> None:
    source = _open_staged_candidate(request)
    before = os.fstat(source)
    target_path = _slot_path(request["target_slot"])
    _mkdirs(target_path.parent, 0o755)
    target = _open_directory_ancestry(target_path.parent)
    temporary = f".dgx-forge-agent.{secrets.token_hex(12)}.new"
    destination = -1
    try:
        _cleanup_slot_staging(target)
        destination = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o555,
            dir_fd=target,
        )
        hasher = hashlib.sha256()
        header = b""
        total = 0
        while True:
            chunk = os.read(source, min(1024 * 1024, request["size"] + 1 - total))
            if not chunk:
                break
            if len(header) < 64:
                header += chunk[: 64 - len(header)]
            total += len(chunk)
            if total > request["size"]:
                raise SupervisorError("staged candidate size changed")
            hasher.update(chunk)
            offset = 0
            while offset < len(chunk):
                offset += os.write(destination, chunk[offset:])
        after = os.fstat(source)
        if (
            _file_identity(before) != _file_identity(after)
            or total != request["size"]
            or hasher.hexdigest() != request["sha256"]
        ):
            raise SupervisorError("staged candidate digest is invalid")
        _verify_elf_header(header)
        os.fchmod(destination, 0o555)
        os.fsync(destination)
        os.close(destination)
        destination = -1
        os.rename(
            temporary,
            target_path.name,
            src_dir_fd=target,
            dst_dir_fd=target,
        )
        os.fsync(target)
        identity = {
            "build_digest": request["build_digest"],
            "platform_version": request["platform_version"],
            "schema_version": 1,
            "sha256": request["sha256"],
        }
        _write_atomic_at(
            target,
            "identity.json",
            _canonical(identity),
            mode=0o444,
            label="slot identity",
        )
    except SupervisorError:
        try:
            os.unlink(temporary, dir_fd=target)
        except OSError:
            pass
        raise
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=target)
        except OSError:
            pass
        raise SupervisorError("candidate installation failed") from error
    finally:
        if destination >= 0:
            os.close(destination)
        os.close(target)
        os.close(source)
    installed = _open_slot(request["target_slot"], request["sha256"])
    os.close(installed)


def _consume_activation_request(
    directory: int,
    expected_identity: tuple[int, ...],
    name: str = "activation-request.json",
) -> None:
    try:
        current = os.stat(
            name, dir_fd=directory, follow_symlinks=False
        )
        if _file_identity(current) != expected_identity:
            raise SupervisorError("activation request changed during application")
        os.unlink(name, dir_fd=directory)
        os.fsync(directory)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("activation request cannot be consumed") from error


def _service(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            [_systemctl(), *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            timeout=10,
            check=check,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise SupervisorError("fixed service coordination failed") from error


def _service_main_pid() -> int:
    try:
        result = subprocess.run(
            [
                _systemctl(),
                "show",
                "--property=MainPID",
                "--value",
                "dgx-forge-agent.service",
            ],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            timeout=10,
            check=True,
        )
        rendered = result.stdout.decode("ascii").strip()
    except (OSError, UnicodeDecodeError, subprocess.SubprocessError) as error:
        raise SupervisorError("agent service PID is unavailable") from error
    if not rendered.isdecimal() or not 1 <= int(rendered) <= 2**31 - 1:
        raise SupervisorError("agent service PID is invalid")
    return int(rendered)


def _running_candidate_matches(
    state: dict[str, Any], marker_pid: int
) -> bool:
    executable = slot = -1
    try:
        if _service_main_pid() != marker_pid:
            return False
        executable = os.open(
            f"/proc/{marker_pid}/exe",
            os.O_RDONLY | os.O_CLOEXEC,
        )
        executable_metadata = os.fstat(executable)
        if not stat.S_ISREG(executable_metadata.st_mode):
            return False
        slot = _open_slot(state["active_slot"], state["expected_sha256"])
        slot_metadata = os.fstat(slot)
        if (
            executable_metadata.st_dev != slot_metadata.st_dev
            or executable_metadata.st_ino != slot_metadata.st_ino
        ):
            return False
        return _service_main_pid() == marker_pid
    except (OSError, SupervisorError):
        return False
    finally:
        if executable >= 0:
            os.close(executable)
        if slot >= 0:
            os.close(slot)


def _initial_state(slot: str, digest: str) -> dict[str, Any]:
    return {
        "activation_deadline": None,
        "active_slot": slot,
        "boot_attempts": 0,
        "expected_sha256": digest,
        "generation": 1,
        "previous_slot": None,
        "rollback_performed": False,
        "schema_version": 1,
        "slot_sha256": {"A": digest if slot == "A" else None, "B": digest if slot == "B" else None},
        "status": "stable",
    }


def initialize(slot: str, digest: str) -> int:
    descriptor = _open_slot(slot, digest)
    os.close(descriptor)
    _read_slot_identity(slot, digest)
    directory = _state_directory(create=True)
    lock = _lock(directory, exclusive=True)
    try:
        _cleanup_staging(directory)
        try:
            current = _read_state(directory)
        except SupervisorError as error:
            if "unavailable" not in str(error):
                raise
            _publish(directory, _initial_state(slot, digest))
        else:
            if current != _initial_state(slot, digest):
                raise SupervisorError("supervisor is already initialized differently")
        _replace_activation_challenge(INACTIVE_CHALLENGE)
    finally:
        os.close(lock)
        os.close(directory)
    return 0


def _pending_activation_state(
    state: dict[str, Any], slot: str, digest: str
) -> dict[str, Any]:
    slot_sha256 = dict(state["slot_sha256"])
    slot_sha256[slot] = digest
    return {
        **state,
        "generation": state["generation"] + 1,
        "previous_slot": state["active_slot"],
        "active_slot": slot,
        "slot_sha256": slot_sha256,
        "expected_sha256": digest,
        "activation_deadline": _now() + ACTIVATION_SECONDS,
        "boot_attempts": 0,
        "status": "pending",
        "rollback_performed": False,
    }


def activate(slot: str, digest: str) -> int:
    descriptor = _state_directory(create=False)
    lock = _lock(descriptor, exclusive=True)
    try:
        _cleanup_staging(descriptor)
        state = _read_state(descriptor)
        if state["status"] != "stable" or state["active_slot"] == slot:
            raise SupervisorError("activation slot is not inactive")
        new_fd = _open_slot(slot, digest)
        os.close(new_fd)
        _read_slot_identity(slot, digest)
        old_digest = state["slot_sha256"][state["active_slot"]]
        assert isinstance(old_digest, str)
        old_fd = _open_slot(state["active_slot"], old_digest)
        os.close(old_fd)
        _publish(descriptor, _pending_activation_state(state, slot, digest))
    finally:
        os.close(lock)
        os.close(descriptor)
    _service("--no-block", "restart", "dgx-forge-agent-supervisor.service")
    return 0


def apply_request() -> int:
    request_directory, request, request_identity = _read_activation_request()
    state_directory = _state_directory(create=False)
    lock = _lock(state_directory, exclusive=True)
    published = False
    consumption_error: SupervisorError | None = None
    try:
        _cleanup_staging(state_directory)
        state = _read_state(state_directory)
        _verify_activation_authorization(request, state_directory)
        authorization = request["authorization"]
        target = authorization["target_slot"]
        previous = authorization["previous_slot"]
        expected_target = "B" if state["active_slot"] == "A" else "A"
        if (
            state["status"] != "stable"
            or previous != state["active_slot"]
            or target != expected_target
            or authorization["previous_sha256"]
            != state["slot_sha256"][state["active_slot"]]
            or authorization["previous_generation"] != state["generation"]
        ):
            raise SupervisorError("activation request does not match stable state")
        active_digest = state["slot_sha256"][state["active_slot"]]
        assert isinstance(active_digest, str)
        active = _open_slot(state["active_slot"], active_digest)
        os.close(active)
        _install_candidate(authorization)
        _consume_activation_authorization(request, state_directory)
        _publish(
            state_directory,
            _pending_activation_state(state, target, authorization["sha256"]),
        )
        published = True
        try:
            _consume_activation_request(request_directory, request_identity)
        except SupervisorError as error:
            consumption_error = error
    finally:
        os.close(lock)
        os.close(state_directory)
        os.close(request_directory)
    if published:
        _service("--no-block", "restart", "dgx-forge-agent-supervisor.service")
    if consumption_error is not None:
        raise consumption_error
    return 0


def apply_rollback_request() -> int:
    request_directory, request, request_identity = _read_rollback_request()
    state_directory = _state_directory(create=False)
    lock = _lock(state_directory, exclusive=True)
    published = False
    consumption_error: SupervisorError | None = None
    try:
        _cleanup_staging(state_directory)
        state = _read_state(state_directory)
        _verify_rollback_authorization(request, state_directory)
        authorization = request["authorization"]
        previous_slot = state["previous_slot"]
        if (
            state["status"] != "stable"
            or previous_slot not in SLOTS
            or previous_slot == state["active_slot"]
            or state["active_slot"] != authorization["current_slot"]
            or state["expected_sha256"] != authorization["current_sha256"]
            or state["generation"] != authorization["current_generation"]
        ):
            raise SupervisorError("rollback request does not match stable state")
        previous_sha256 = state["slot_sha256"][previous_slot]
        assert isinstance(previous_sha256, str)
        for slot, digest in (
            (authorization["current_slot"], authorization["current_sha256"]),
            (previous_slot, previous_sha256),
        ):
            executable = _open_slot(slot, digest)
            os.close(executable)
            _read_slot_identity(slot, digest)
        _consume_rollback_authorization(request, state_directory)
        _publish(
            state_directory,
            _pending_activation_state(
                state, previous_slot, previous_sha256
            ),
        )
        published = True
        try:
            _consume_activation_request(
                request_directory,
                request_identity,
                "rollback-request.json",
            )
        except SupervisorError as error:
            consumption_error = error
    finally:
        os.close(lock)
        os.close(state_directory)
        os.close(request_directory)
    if published:
        _service("--no-block", "restart", "dgx-forge-agent-supervisor.service")
    if consumption_error is not None:
        raise consumption_error
    return 0


def _rename_noreplace(
    source_directory: int,
    source: str,
    destination_directory: int,
    destination: str,
) -> None:
    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        raise SupervisorError("atomic readiness quarantine is unavailable")
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if (
        renameat2(
            source_directory,
            os.fsencode(source),
            destination_directory,
            os.fsencode(destination),
            1,
        )
        != 0
    ):
        value = ctypes.get_errno()
        if value == errno.ENOENT:
            raise FileNotFoundError(value, os.strerror(value), source)
        if value == errno.EEXIST:
            raise FileExistsError(value, os.strerror(value), destination)
        raise SupervisorError("readiness marker cannot be quarantined")


def _readiness_quarantine_directory() -> int:
    path = _path(READINESS_QUARANTINE_ROOT)
    if _test_root() and not path.parent.exists():
        _mkdirs(path.parent, 0o755)
    parent = _open_directory_ancestry(path.parent)
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent)
            os.fsync(parent)
        except FileExistsError:
            pass
        directory = os.open(
            path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        _trusted(os.fstat(directory), 0o700, regular=False)
        return directory
    except Exception:
        if "directory" in locals():
            os.close(directory)
        raise
    finally:
        os.close(parent)


def _publish_readiness_replacement_for_test(directory: int) -> None:
    configured = any(
        os.environ.get(name) == "1"
        for name in (
            "DGX_SUPERVISOR_SWAP_READINESS_TEST",
            "DGX_SUPERVISOR_SWAP_READINESS_AFTER_STAT_TEST",
        )
    )
    if not configured:
        return
    try:
        os.rename(
            "replacement.json",
            "readiness.json",
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        os.fsync(directory)
    except OSError as error:
        raise SupervisorError("readiness race hook failed") from error


def _read_readiness(state: dict[str, Any], challenge: str) -> int | None:
    root = _path(RUNTIME_ROOT)
    expected_owner = _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid
    try:
        directory = _open_directory_ancestry(root, final_owner=expected_owner)
    except FileNotFoundError:
        return None
    quarantine = _readiness_quarantine_directory()
    quarantine_name = f"readiness.{secrets.token_hex(12)}.consumed"
    descriptor = -1
    try:
        try:
            _rename_noreplace(
                directory,
                "readiness.json",
                quarantine,
                quarantine_name,
            )
        except FileNotFoundError:
            return None
        os.fsync(directory)
        os.fsync(quarantine)
        descriptor = os.open(
            quarantine_name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=quarantine,
        )
        metadata = os.fstat(descriptor)
        runtime_metadata = os.fstat(directory)
        if (
            runtime_metadata.st_uid != expected_owner
            or stat.S_IMODE(runtime_metadata.st_mode) != 0o700
        ):
            raise SupervisorError("readiness runtime directory is unsafe")
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
        ):
            raise SupervisorError("readiness marker is unsafe")
        if metadata.st_size > 4096:
            raise SupervisorError("readiness marker is too large")
        raw = os.read(descriptor, 4097)
        marker = _decode(raw, readiness=True)
        valid_types = (
            marker["schema_version"] == 2
            and isinstance(marker["challenge"], str)
            and DIGEST.fullmatch(marker["challenge"])
            and isinstance(marker["generation"], int)
            and not isinstance(marker["generation"], bool)
            and isinstance(marker["pid"], int)
            and not isinstance(marker["pid"], bool)
            and marker["pid"] > 0
            and marker["slot"] in SLOTS
            and isinstance(marker["sha256"], str)
            and DIGEST.fullmatch(marker["sha256"])
        )
        accepted = bool(
            valid_types
            and marker["challenge"] == challenge
            and marker["generation"] == state["generation"]
            and marker["slot"] == state["active_slot"]
            and marker["sha256"] == state["expected_sha256"]
            and _running_candidate_matches(state, marker["pid"])
        )
        _publish_readiness_replacement_for_test(directory)
        return marker["pid"] if accepted else None
    except FileNotFoundError:
        return None
    except (KeyError, SupervisorError):
        return None
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(quarantine_name, dir_fd=quarantine)
            os.fsync(quarantine)
        except FileNotFoundError:
            pass
        os.close(quarantine)
        os.close(directory)


def _clear_readiness() -> None:
    root = _path(RUNTIME_ROOT)
    expected_owner = _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid
    try:
        directory = _open_directory_ancestry(root, final_owner=expected_owner)
    except FileNotFoundError:
        return
    quarantine = _readiness_quarantine_directory()
    quarantine_name = f"readiness.{secrets.token_hex(12)}.stale"
    try:
        try:
            _rename_noreplace(
                directory, "readiness.json", quarantine, quarantine_name
            )
        except FileNotFoundError:
            return
        os.fsync(directory)
        os.unlink(quarantine_name, dir_fd=quarantine)
        os.fsync(quarantine)
    finally:
        try:
            os.unlink(quarantine_name, dir_fd=quarantine)
        except FileNotFoundError:
            pass
        os.close(quarantine)
        os.close(directory)


def _replace_activation_challenge(challenge: str) -> None:
    if not DIGEST.fullmatch(challenge):
        raise SupervisorError("activation challenge is invalid")
    directory = _readiness_quarantine_directory()
    temporary = f".{ACTIVATION_CHALLENGE_NAME}.{secrets.token_hex(12)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o600,
            dir_fd=directory,
        )
        os.fchmod(descriptor, 0o600)
        raw = (challenge + "\n").encode("ascii")
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.rename(
            temporary,
            ACTIVATION_CHALLENGE_NAME,
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        os.fsync(directory)
    except OSError as error:
        raise SupervisorError("activation challenge cannot be published") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(temporary, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def _new_activation_challenge() -> str:
    challenge = secrets.token_hex(32)
    _replace_activation_challenge(challenge)
    return challenge


def _consume_activation_challenge(challenge: str) -> None:
    directory = _readiness_quarantine_directory()
    descriptor = -1
    consumed = f".{ACTIVATION_CHALLENGE_NAME}.{secrets.token_hex(12)}.consumed"
    try:
        _rename_noreplace(
            directory, ACTIVATION_CHALLENGE_NAME, directory, consumed
        )
        descriptor = os.open(
            consumed,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
        metadata = os.fstat(descriptor)
        raw = os.read(descriptor, 66)
        if (
            metadata.st_uid != _owner()
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or raw != (challenge + "\n").encode("ascii")
        ):
            raise SupervisorError("activation challenge changed during consumption")
        os.unlink(consumed, dir_fd=directory)
        os.fsync(directory)
        _replace_activation_challenge(INACTIVE_CHALLENGE)
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(consumed, dir_fd=directory)
        except FileNotFoundError:
            pass
        os.close(directory)


def _stable(state: dict[str, Any], *, rollback: bool = False) -> dict[str, Any]:
    return {
        **state,
        "activation_deadline": None,
        "boot_attempts": 0,
        "status": "stable",
        "rollback_performed": rollback,
    }


def _swap_pending_slot_before_commit_for_test(state: dict[str, Any]) -> None:
    configured = os.environ.get("DGX_SUPERVISOR_SWAP_SLOT_BEFORE_COMMIT_TEST")
    if configured is None:
        return
    if _test_root() is None or configured != "1":
        raise SupervisorError("pending slot race hook is invalid")
    path = _slot_path(state["active_slot"])
    parent = _open_directory_ancestry(path.parent)
    try:
        os.rename(
            ".dgx-forge-agent.commit-race",
            path.name,
            src_dir_fd=parent,
            dst_dir_fd=parent,
        )
        os.fsync(parent)
    except OSError as error:
        raise SupervisorError("pending slot race hook failed") from error
    finally:
        os.close(parent)


def _rollback(directory: int, state: dict[str, Any]) -> None:
    previous = state["previous_slot"]
    if state["rollback_performed"] or previous not in SLOTS:
        raise SupervisorError("activation requires explicit recovery")
    previous_digest = state["slot_sha256"][previous]
    if not isinstance(previous_digest, str):
        raise SupervisorError("previous slot is unavailable")
    old_fd = _open_slot(previous, previous_digest)
    os.close(old_fd)
    _read_slot_identity(previous, previous_digest)
    failed = state["active_slot"]
    rolled_back = _stable(
        {
            **state,
            "active_slot": previous,
            "previous_slot": failed,
            "expected_sha256": previous_digest,
        },
        rollback=True,
    )
    _publish(directory, rolled_back)


def _ensure_runtime_directory() -> None:
    path = _path(RUNTIME_ROOT)
    if _test_root() and not path.parent.exists():
        _mkdirs(path.parent, 0o755)
    parent = _open_directory_ancestry(path.parent)
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent)
            created = True
        except FileExistsError:
            created = False
        directory = os.open(
            path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        try:
            if created:
                if _test_root() is None:
                    account = pwd.getpwnam("dgx-agent")
                    os.fchown(directory, account.pw_uid, account.pw_gid)
                os.fchmod(directory, 0o700)
                os.fsync(directory)
                os.fsync(parent)
            metadata = os.fstat(directory)
            expected_owner = (
                _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid
            )
            if (
                metadata.st_uid != expected_owner
                or stat.S_IMODE(metadata.st_mode) != 0o700
            ):
                raise SupervisorError("readiness runtime directory is unsafe")
        finally:
            os.close(directory)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("readiness runtime directory cannot be prepared") from error
    finally:
        os.close(parent)


def supervise() -> int:
    directory = _state_directory(create=False)
    coordination = _lock(directory, exclusive=True, name="coordination.lock")
    lock = _lock(directory, exclusive=True)
    restart_after_rollback = False
    try:
        _cleanup_staging(directory)
        state = _read_state(directory)
        try:
            active_fd = _open_slot(state["active_slot"], state["expected_sha256"])
            _read_slot_identity(state["active_slot"], state["expected_sha256"])
        except SupervisorError:
            if state["status"] == "pending":
                _rollback(directory, state)
                restart_after_rollback = True
                result = 1
            else:
                raise
        else:
            os.close(active_fd)
            if state["status"] == "stable":
                os.close(lock)
                lock = -1
                _ensure_runtime_directory()
                _service("start", "dgx-forge-agent.service")
                return 0
            if (
                state["boot_attempts"] >= MAX_BOOT_ATTEMPTS
                or _now() >= state["activation_deadline"]
            ):
                _rollback(directory, state)
                restart_after_rollback = True
                result = 1
            else:
                state = {**state, "boot_attempts": state["boot_attempts"] + 1}
                _publish(directory, state)
                os.close(lock)
                lock = -1
                _ensure_runtime_directory()
                _service("stop", "dgx-forge-agent.service")
                _clear_readiness()
                challenge = _new_activation_challenge()
                _service("restart", "dgx-forge-agent.service")
                poll = 0.25
                if _test_root():
                    poll = float(os.environ.get("DGX_SUPERVISOR_POLL_SECONDS", "0.01"))
                ready_pid: int | None = None
                while _now() < state["activation_deadline"]:
                    candidate_pid = _read_readiness(state, challenge)
                    if candidate_pid is not None:
                        ready_pid = candidate_pid
                        break
                    failed = _service(
                        "is-failed",
                        "--quiet",
                        "dgx-forge-agent.service",
                        check=False,
                    )
                    if failed.returncode == 0:
                        break
                    time.sleep(
                        max(
                            0.001,
                            min(poll, state["activation_deadline"] - _now()),
                        )
                    )
                if ready_pid is not None:
                    _swap_pending_slot_before_commit_for_test(state)
                lock = _lock(directory, exclusive=True)
                current = _read_state(directory)
                if current != state:
                    raise SupervisorError("activation state changed during supervision")
                if ready_pid is not None:
                    try:
                        pending_fd = _open_slot(
                            state["active_slot"], state["expected_sha256"]
                        )
                    except SupervisorError:
                        _rollback(directory, state)
                        restart_after_rollback = True
                        result = 1
                    else:
                        os.close(pending_fd)
                        if not _running_candidate_matches(state, ready_pid):
                            _replace_activation_challenge(INACTIVE_CHALLENGE)
                            _rollback(directory, state)
                            restart_after_rollback = True
                            result = 1
                        else:
                            _consume_activation_challenge(challenge)
                            _publish(directory, _stable(state))
                            result = 0
                else:
                    _replace_activation_challenge(INACTIVE_CHALLENGE)
                    _rollback(directory, state)
                    restart_after_rollback = True
                    result = 1
    finally:
        if lock >= 0:
            os.close(lock)
        os.close(coordination)
        os.close(directory)
    if restart_after_rollback:
        _service("restart", "dgx-forge-agent.service")
    return result


def run_agent() -> int:
    directory = _state_directory(create=False)
    lock = _lock(directory, exclusive=False)
    executable = -1
    try:
        state = _read_state(directory)
        executable = _open_slot(state["active_slot"], state["expected_sha256"])
        identity = _read_slot_identity(
            state["active_slot"], state["expected_sha256"]
        )
    finally:
        os.close(lock)
        os.close(directory)
    environment = {
        "HOME": "/var/lib/dgx-forge-agent",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/bin",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
        "DGX_AGENT_PLATFORM_VERSION": identity["platform_version"],
        "DGX_AGENT_BUILD_DIGEST": identity["build_digest"],
        "DGX_AGENT_SUPERVISOR_GENERATION": str(state["generation"]),
        "DGX_AGENT_SUPERVISOR_SLOT": state["active_slot"],
        "DGX_AGENT_SUPERVISOR_SHA256": state["expected_sha256"],
    }
    if state["status"] == "pending":
        credentials_directory = os.environ.get("CREDENTIALS_DIRECTORY")
        if _test_root():
            credentials_directory = str(_path(READINESS_QUARANTINE_ROOT))
        if credentials_directory is None or not Path(credentials_directory).is_absolute():
            os.close(executable)
            raise SupervisorError("activation challenge credential is unavailable")
        environment.update(
            {
                "CREDENTIALS_DIRECTORY": credentials_directory,
            }
        )
    try:
        os.execve(f"/proc/self/fd/{executable}", ["dgx-forge-agent"], environment)
    except OSError as error:
        os.close(executable)
        raise SupervisorError("verified slot could not be executed") from error
    return 1


def _parser() -> UsageParser:
    parser = UsageParser(description="stable DGX Forge agent A/B supervisor")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("initialize", "activate"):
        child = subparsers.add_parser(command)
        child.add_argument("--slot", choices=SLOTS, required=True)
        child.add_argument("--sha256", required=True)
    subparsers.add_parser("apply-request")
    subparsers.add_parser("apply-rollback-request")
    subparsers.add_parser("supervise")
    subparsers.add_parser("run-agent")
    return parser


def main(argv: list[str] | None = None) -> int:
    arguments = _parser().parse_args(argv)
    try:
        crash_stage = os.environ.get("DGX_SUPERVISOR_CRASH_AFTER")
        if crash_stage is not None and (
            not _test_root()
            or crash_stage
            not in {"create", "write", "file-fsync", "rename", "directory-fsync"}
        ):
            raise SupervisorError("publication crash hook is invalid")
        readiness_swap = os.environ.get("DGX_SUPERVISOR_SWAP_READINESS_TEST")
        if readiness_swap is not None and (
            not _test_root() or readiness_swap != "1"
        ):
            raise SupervisorError("readiness race hook is invalid")
        readiness_after_stat = os.environ.get(
            "DGX_SUPERVISOR_SWAP_READINESS_AFTER_STAT_TEST"
        )
        if readiness_after_stat is not None and (
            not _test_root() or readiness_after_stat != "1"
        ):
            raise SupervisorError("readiness race hook is invalid")
        slot_swap = os.environ.get("DGX_SUPERVISOR_SWAP_SLOT_BEFORE_COMMIT_TEST")
        if slot_swap is not None and (not _test_root() or slot_swap != "1"):
            raise SupervisorError("pending slot race hook is invalid")
        if arguments.command in {"initialize", "activate"} and not DIGEST.fullmatch(arguments.sha256):
            raise SupervisorError("SHA-256 is invalid")
        if arguments.command == "initialize":
            return initialize(arguments.slot, arguments.sha256)
        if arguments.command == "activate":
            return activate(arguments.slot, arguments.sha256)
        if arguments.command == "apply-request":
            return apply_request()
        if arguments.command == "apply-rollback-request":
            return apply_rollback_request()
        if arguments.command == "supervise":
            return supervise()
        if arguments.command == "run-agent":
            return run_agent()
        raise SupervisorError("unknown command")
    except SupervisorError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
