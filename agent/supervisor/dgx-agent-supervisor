#!/usr/bin/python3 -I
"""Stable, path-closed A/B launcher and rollback coordinator."""

from __future__ import annotations

import argparse
import ctypes
import errno
import fcntl
import hashlib
import json
import math
import os
import platform
import pwd
import re
import secrets
import stat
import struct
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

STATE_LIMIT = 16 * 1024
EXECUTABLE_LIMIT = 256 * 1024 * 1024
ACTIVATION_SECONDS = 120
MAX_BOOT_ATTEMPTS = 2
SLOTS = ("A", "B")
DIGEST = re.compile(r"[0-9a-f]{64}\Z")
STATE_FIELDS = {
    "schema_version",
    "generation",
    "active_slot",
    "previous_slot",
    "slot_sha256",
    "expected_sha256",
    "activation_deadline",
    "boot_attempts",
    "status",
    "rollback_performed",
}
READINESS_FIELDS = {"schema_version", "generation", "slot", "sha256"}
IDENTITY_FIELDS = {"build_digest", "platform_version", "schema_version", "sha256"}
ACTIVATION_REQUEST_FIELDS = {
    "build_digest",
    "platform_version",
    "previous_slot",
    "schema_version",
    "sha256",
    "size",
    "target_slot",
}
MACHINE = {"x86_64": 62, "aarch64": 183}
STAGING = re.compile(r"\.state\.[0-9a-f]{24}\.new\Z")


class SupervisorError(RuntimeError):
    pass


class UsageParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(64, f"{self.prog}: error: {message}\n")


def _test_root() -> Path | None:
    value = os.environ.get("DGX_SUPERVISOR_TEST_ROOT")
    if value is None:
        return None
    if os.geteuid() == 0:
        raise SupervisorError("test root is forbidden for root")
    path = Path(value)
    if not path.is_absolute():
        raise SupervisorError("test root must be absolute")
    return path


def _path(absolute: str) -> Path:
    root = _test_root()
    return Path(absolute) if root is None else root / absolute.lstrip("/")


def _owner() -> int:
    root = _test_root()
    if root is None:
        return 0
    value = os.environ.get("DGX_SUPERVISOR_TEST_UID")
    if value is None or not value.isdecimal() or int(value) != os.geteuid():
        raise SupervisorError("test UID is invalid")
    return int(value)


def _architecture() -> str:
    value = os.environ.get("DGX_SUPERVISOR_TEST_ARCH") if _test_root() else None
    machine = value or platform.machine()
    if machine == "AMD64":
        machine = "x86_64"
    if machine == "arm64":
        machine = "aarch64"
    if machine not in MACHINE:
        raise SupervisorError("unsupported architecture")
    return machine


def _now() -> float:
    value = os.environ.get("DGX_SUPERVISOR_NOW") if _test_root() else None
    if value is None:
        return time.time()
    try:
        rendered = float(value)
    except ValueError as error:
        raise SupervisorError("test clock is invalid") from error
    if rendered < 0:
        raise SupervisorError("test clock is invalid")
    return rendered


def _systemctl() -> str:
    value = os.environ.get("DGX_SUPERVISOR_SYSTEMCTL") if _test_root() else None
    if value is None:
        return "/usr/bin/systemctl"
    path = Path(value)
    if not path.is_absolute() or path.is_symlink():
        raise SupervisorError("test systemctl is unsafe")
    return str(path)


STATE_ROOT = "/var/lib/dgx-forge-agent-supervisor"
SLOT_ROOT = "/opt/dgx-forge/agent-slots"
RUNTIME_ROOT = "/run/dgx-forge-agent"
READINESS_QUARANTINE_ROOT = "/run/dgx-forge-agent-supervisor"
UPDATE_STAGING_ROOT = "/var/lib/dgx-forge-agent/update-staging"


def _canonical(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        + "\n"
    ).encode("ascii")


def _unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise SupervisorError("JSON contains duplicate fields")
        result[key] = value
    return result


def _reject_constant(_value: str) -> None:
    raise SupervisorError("JSON contains a nonfinite number")


def _decode(raw: bytes, *, readiness: bool = False) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("JSON is invalid") from error
    if not isinstance(value, dict) or _canonical(value) != raw:
        raise SupervisorError("JSON is not canonical")
    fields = READINESS_FIELDS if readiness else STATE_FIELDS
    if set(value) != fields:
        raise SupervisorError("JSON fields are invalid")
    return value


def _decode_activation_request(raw: bytes) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("activation request JSON is invalid") from error
    if (
        not isinstance(value, dict)
        or set(value) != ACTIVATION_REQUEST_FIELDS
        or _canonical(value) != raw
        or value["schema_version"] != 1
        or value["target_slot"] not in SLOTS
        or value["previous_slot"] not in SLOTS
        or not isinstance(value["sha256"], str)
        or DIGEST.fullmatch(value["sha256"]) is None
        or not isinstance(value["build_digest"], str)
        or not re.fullmatch(r"sha256:[0-9a-f]{64}", value["build_digest"])
        or not isinstance(value["platform_version"], str)
        or not re.fullmatch(
            r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
            value["platform_version"],
        )
        or isinstance(value["size"], bool)
        or not isinstance(value["size"], int)
        or not 64 <= value["size"] <= EXECUTABLE_LIMIT
    ):
        raise SupervisorError("activation request is invalid")
    return value


def _decode_slot_identity(raw: bytes, expected_sha256: str) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("slot identity JSON is invalid") from error
    if (
        not isinstance(value, dict)
        or set(value) != IDENTITY_FIELDS
        or _canonical(value) != raw
        or value["schema_version"] != 1
        or value["sha256"] != expected_sha256
        or not isinstance(value["build_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", value["build_digest"]) is None
        or not isinstance(value["platform_version"], str)
        or re.fullmatch(
            r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
            value["platform_version"],
        )
        is None
    ):
        raise SupervisorError("slot identity is invalid")
    return value


def _agent_owner() -> int:
    return _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid


def _trusted(metadata: os.stat_result, mode: int, *, regular: bool) -> None:
    if metadata.st_uid != _owner():
        raise SupervisorError("path owner is unsafe")
    if stat.S_IMODE(metadata.st_mode) != mode:
        raise SupervisorError("path mode is unsafe")
    if regular and (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1):
        raise SupervisorError("path type is unsafe")
    if not regular and not stat.S_ISDIR(metadata.st_mode):
        raise SupervisorError("path type is unsafe")


def _mkdirs(path: Path, final_mode: int) -> None:
    current = Path(path.anchor)
    for index, component in enumerate(path.parts[1:]):
        current = current / component
        final = index == len(path.parts[1:]) - 1
        try:
            os.mkdir(current, final_mode if final else 0o755)
        except FileExistsError:
            pass
        metadata = os.lstat(current)
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise SupervisorError("directory ancestry is unsafe")
        mode = stat.S_IMODE(metadata.st_mode)
        writable = mode & 0o022 and not (_test_root() and mode & stat.S_ISVTX)
        if metadata.st_uid not in {_owner(), 0} or writable:
            raise SupervisorError("directory ancestry is unsafe")
    os.chmod(path, final_mode)


def _state_directory(*, create: bool) -> int:
    root = _path(STATE_ROOT)
    if create:
        _mkdirs(root, 0o755)
    try:
        descriptor = _open_directory_ancestry(root)
    except OSError as error:
        raise SupervisorError("state root is unavailable") from error
    try:
        _trusted(os.fstat(descriptor), 0o755, regular=False)
    except Exception:
        os.close(descriptor)
        raise
    return descriptor


def _lock(
    directory: int, *, exclusive: bool, name: str = "supervisor.lock"
) -> int:
    if name not in {"supervisor.lock", "coordination.lock"}:
        raise SupervisorError("lock selection is invalid")
    descriptor = -1
    if exclusive:
        try:
            descriptor = os.open(
                name,
                os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                0o644,
                dir_fd=directory,
            )
            os.fchmod(descriptor, 0o644)
            os.fsync(descriptor)
            os.fsync(directory)
        except FileExistsError:
            pass
    if descriptor < 0:
        try:
            descriptor = os.open(
                name,
                (os.O_RDWR if exclusive else os.O_RDONLY)
                | os.O_NOFOLLOW
                | os.O_CLOEXEC,
                dir_fd=directory,
            )
        except FileNotFoundError:
            raise SupervisorError("supervisor is not initialized") from None
    metadata = os.fstat(descriptor)
    _trusted(metadata, 0o644, regular=True)
    fcntl.flock(descriptor, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
    return descriptor


def _read_state(directory: int) -> dict[str, Any]:
    try:
        descriptor = os.open(
            "state.json",
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
    except OSError as error:
        raise SupervisorError("state is unavailable") from error
    try:
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o644, regular=True)
        if metadata.st_size > STATE_LIMIT:
            raise SupervisorError("state is too large")
        raw = os.read(descriptor, STATE_LIMIT + 1)
        if len(raw) > STATE_LIMIT:
            raise SupervisorError("state is too large")
    finally:
        os.close(descriptor)
    state = _decode(raw)
    _validate_state(state)
    return state


def _validate_state(value: dict[str, Any]) -> None:
    if value["schema_version"] != 1:
        raise SupervisorError("state schema is invalid")
    generation = value["generation"]
    if (
        not isinstance(generation, int)
        or isinstance(generation, bool)
        or not 1 <= generation <= 999_999_999
    ):
        raise SupervisorError("state generation is invalid")
    active = value["active_slot"]
    previous = value["previous_slot"]
    if active not in SLOTS or (previous is not None and previous not in SLOTS):
        raise SupervisorError("state slots are invalid")
    slot_digests = value["slot_sha256"]
    if not isinstance(slot_digests, dict) or set(slot_digests) != set(SLOTS):
        raise SupervisorError("slot digests are invalid")
    for digest in slot_digests.values():
        if digest is not None and (not isinstance(digest, str) or not DIGEST.fullmatch(digest)):
            raise SupervisorError("slot digest is invalid")
    if slot_digests[active] != value["expected_sha256"] or not isinstance(value["expected_sha256"], str) or not DIGEST.fullmatch(value["expected_sha256"]):
        raise SupervisorError("expected digest is invalid")
    if value["status"] not in {"stable", "pending"}:
        raise SupervisorError("state status is invalid")
    deadline = value["activation_deadline"]
    attempts = value["boot_attempts"]
    if not isinstance(attempts, int) or isinstance(attempts, bool) or not 0 <= attempts <= MAX_BOOT_ATTEMPTS:
        raise SupervisorError("boot attempts are invalid")
    if not isinstance(value["rollback_performed"], bool):
        raise SupervisorError("rollback state is invalid")
    if value["status"] == "stable":
        if deadline is not None or attempts != 0:
            raise SupervisorError("stable state is invalid")
    elif (
        not isinstance(deadline, (int, float))
        or isinstance(deadline, bool)
        or not math.isfinite(deadline)
        or deadline <= 0
        or previous not in SLOTS
        or previous == active
        or value["rollback_performed"]
    ):
        raise SupervisorError("pending state is invalid")


def _publish(directory: int, state: dict[str, Any]) -> None:
    _validate_state(state)
    raw = _canonical(state)
    temporary = f".state.{secrets.token_hex(12)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o644,
            dir_fd=directory,
        )
        os.fchmod(descriptor, 0o644)
        _crash("create")
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        _crash("write")
        os.fsync(descriptor)
        _crash("file-fsync")
        os.close(descriptor)
        descriptor = -1
        os.rename(temporary, "state.json", src_dir_fd=directory, dst_dir_fd=directory)
        _crash("rename")
        os.fsync(directory)
        _crash("directory-fsync")
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=directory)
        except OSError:
            pass
        raise SupervisorError("state publication failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _crash(stage: str) -> None:
    if _test_root() and os.environ.get("DGX_SUPERVISOR_CRASH_AFTER") == stage:
        os._exit(99)


def _cleanup_staging(directory: int) -> None:
    changed = False
    for name in os.listdir(directory):
        if not STAGING.fullmatch(name):
            continue
        descriptor = -1
        try:
            descriptor = os.open(
                name,
                os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=directory,
            )
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != _owner()
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o644
                or metadata.st_size > STATE_LIMIT
            ):
                raise SupervisorError("state staging file is unsafe")
            os.unlink(name, dir_fd=directory)
            changed = True
        except OSError as error:
            raise SupervisorError("state staging cleanup failed") from error
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    if changed:
        os.fsync(directory)


def _slot_path(slot: str) -> Path:
    return _path(f"{SLOT_ROOT}/{slot}/dgx-forge-agent")


def _open_directory_ancestry(path: Path, *, final_owner: int | None = None) -> int:
    if not path.is_absolute() or len(path.parts) < 2:
        raise SupervisorError("fixed directory path is invalid")
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for index, component in enumerate(path.parts[1:]):
            child = os.open(
                component,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = child
            metadata = os.fstat(descriptor)
            mode = stat.S_IMODE(metadata.st_mode)
            owners = {0, _owner()}
            if index == len(path.parts[1:]) - 1 and final_owner is not None:
                owners.add(final_owner)
            if metadata.st_uid not in owners or (
                mode & 0o022 and not mode & stat.S_ISVTX
            ):
                raise SupervisorError("directory ancestry is unsafe")
        return descriptor
    except SupervisorError:
        os.close(descriptor)
        raise
    except FileNotFoundError:
        os.close(descriptor)
        raise
    except OSError as error:
        os.close(descriptor)
        raise SupervisorError("directory ancestry is unsafe") from error


def _verify_elf_header(header: bytes) -> None:
    if len(header) < 20 or header[:4] != b"\x7fELF":
        raise SupervisorError("slot executable is not ELF")
    if header[4:6] != b"\x02\x01" or header[6] != 1:
        raise SupervisorError("slot ELF format is unsupported")
    elf_type, machine = struct.unpack_from("<HH", header, 16)
    if elf_type not in {2, 3} or machine != MACHINE[_architecture()]:
        raise SupervisorError("slot ELF architecture is invalid")


def _open_slot(slot: str, expected: str) -> int:
    if slot not in SLOTS or not DIGEST.fullmatch(expected):
        raise SupervisorError("slot selection is invalid")
    path = _slot_path(slot)
    try:
        parent = _open_directory_ancestry(path.parent)
    except OSError as error:
        raise SupervisorError("slot root is unavailable") from error
    descriptor = -1
    try:
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        before = os.fstat(descriptor)
        _trusted(before, 0o555, regular=True)
        if before.st_size < 64 or before.st_size > EXECUTABLE_LIMIT:
            raise SupervisorError("slot executable size is invalid")
        hasher = hashlib.sha256()
        header = b""
        total = 0
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, EXECUTABLE_LIMIT + 1 - total))
            if not chunk:
                break
            if len(header) < 64:
                header += chunk[: 64 - len(header)]
            total += len(chunk)
            if total > EXECUTABLE_LIMIT:
                raise SupervisorError("slot executable is too large")
            hasher.update(chunk)
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise SupervisorError("slot executable changed during verification")
        if total != before.st_size or hasher.hexdigest() != expected:
            raise SupervisorError("slot executable digest is invalid")
        _verify_elf_header(header)
        os.lseek(descriptor, 0, os.SEEK_SET)
        return descriptor
    except SupervisorError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise SupervisorError("slot executable is unavailable") from error
    finally:
        os.close(parent)


def _read_slot_identity(slot: str, expected_sha256: str) -> dict[str, Any]:
    path = _slot_path(slot).with_name("identity.json")
    try:
        parent = _open_directory_ancestry(path.parent)
    except OSError as error:
        raise SupervisorError("slot identity root is unavailable") from error
    descriptor = -1
    try:
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o444, regular=True)
        if metadata.st_size > 4096:
            raise SupervisorError("slot identity is too large")
        raw = os.read(descriptor, 4097)
        if len(raw) > 4096:
            raise SupervisorError("slot identity is too large")
        return _decode_slot_identity(raw, expected_sha256)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("slot identity is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent)


def _file_identity(metadata: os.stat_result) -> tuple[int, int, int, int, int]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def _read_activation_request() -> tuple[int, dict[str, Any], tuple[int, ...]]:
    path = _path(RUNTIME_ROOT)
    expected_owner = _agent_owner()
    try:
        directory = _open_directory_ancestry(path, final_owner=expected_owner)
    except (FileNotFoundError, OSError) as error:
        raise SupervisorError("activation request is unavailable") from error
    descriptor = -1
    try:
        runtime = os.fstat(directory)
        if (
            runtime.st_uid != expected_owner
            or stat.S_IMODE(runtime.st_mode) != 0o700
        ):
            raise SupervisorError("activation runtime directory is unsafe")
        descriptor = os.open(
            "activation-request.json",
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
        metadata = os.fstat(descriptor)
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size > 4096
        ):
            raise SupervisorError("activation request path is unsafe")
        raw = os.read(descriptor, 4097)
        if len(raw) > 4096:
            raise SupervisorError("activation request is too large")
        return directory, _decode_activation_request(raw), _file_identity(metadata)
    except SupervisorError:
        os.close(directory)
        raise
    except OSError as error:
        os.close(directory)
        raise SupervisorError("activation request is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _open_staged_candidate(request: dict[str, Any]) -> int:
    root = _path(UPDATE_STAGING_ROOT)
    expected_owner = _agent_owner()
    try:
        directory = _open_directory_ancestry(root, final_owner=expected_owner)
    except (FileNotFoundError, OSError) as error:
        raise SupervisorError("staged candidate is unavailable") from error
    descriptor = -1
    try:
        metadata = os.fstat(directory)
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o700
        ):
            raise SupervisorError("candidate staging directory is unsafe")
        descriptor = os.open(
            f"{request['sha256']}.agent",
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
        candidate = os.fstat(descriptor)
        if (
            candidate.st_uid != expected_owner
            or stat.S_IMODE(candidate.st_mode) != 0o500
            or not stat.S_ISREG(candidate.st_mode)
            or candidate.st_nlink != 1
            or candidate.st_size != request["size"]
        ):
            raise SupervisorError("staged candidate path is unsafe")
        return descriptor
    except SupervisorError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise SupervisorError("staged candidate is unavailable") from error
    finally:
        os.close(directory)


def _write_atomic_at(
    directory: int, name: str, raw: bytes, *, mode: int, label: str
) -> None:
    temporary = f".{name}.{secrets.token_hex(12)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            mode,
            dir_fd=directory,
        )
        os.fchmod(descriptor, mode)
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.rename(temporary, name, src_dir_fd=directory, dst_dir_fd=directory)
        os.fsync(directory)
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=directory)
        except OSError:
            pass
        raise SupervisorError(f"{label} publication failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _install_candidate(request: dict[str, Any]) -> None:
    source = _open_staged_candidate(request)
    before = os.fstat(source)
    target_path = _slot_path(request["target_slot"])
    _mkdirs(target_path.parent, 0o755)
    target = _open_directory_ancestry(target_path.parent)
    temporary = f".dgx-forge-agent.{secrets.token_hex(12)}.new"
    destination = -1
    try:
        destination = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o555,
            dir_fd=target,
        )
        hasher = hashlib.sha256()
        header = b""
        total = 0
        while True:
            chunk = os.read(source, min(1024 * 1024, request["size"] + 1 - total))
            if not chunk:
                break
            if len(header) < 64:
                header += chunk[: 64 - len(header)]
            total += len(chunk)
            if total > request["size"]:
                raise SupervisorError("staged candidate size changed")
            hasher.update(chunk)
            offset = 0
            while offset < len(chunk):
                offset += os.write(destination, chunk[offset:])
        after = os.fstat(source)
        if (
            _file_identity(before) != _file_identity(after)
            or total != request["size"]
            or hasher.hexdigest() != request["sha256"]
        ):
            raise SupervisorError("staged candidate digest is invalid")
        _verify_elf_header(header)
        os.fchmod(destination, 0o555)
        os.fsync(destination)
        os.close(destination)
        destination = -1
        os.rename(
            temporary,
            target_path.name,
            src_dir_fd=target,
            dst_dir_fd=target,
        )
        os.fsync(target)
        identity = {
            "build_digest": request["build_digest"],
            "platform_version": request["platform_version"],
            "schema_version": 1,
            "sha256": request["sha256"],
        }
        _write_atomic_at(
            target,
            "identity.json",
            _canonical(identity),
            mode=0o444,
            label="slot identity",
        )
    except SupervisorError:
        try:
            os.unlink(temporary, dir_fd=target)
        except OSError:
            pass
        raise
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=target)
        except OSError:
            pass
        raise SupervisorError("candidate installation failed") from error
    finally:
        if destination >= 0:
            os.close(destination)
        os.close(target)
        os.close(source)
    installed = _open_slot(request["target_slot"], request["sha256"])
    os.close(installed)


def _consume_activation_request(
    directory: int, expected_identity: tuple[int, ...]
) -> None:
    try:
        current = os.stat(
            "activation-request.json", dir_fd=directory, follow_symlinks=False
        )
        if _file_identity(current) != expected_identity:
            raise SupervisorError("activation request changed during application")
        os.unlink("activation-request.json", dir_fd=directory)
        os.fsync(directory)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("activation request cannot be consumed") from error


def _service(*arguments: str, check: bool = True) -> subprocess.CompletedProcess[bytes]:
    try:
        return subprocess.run(
            [_systemctl(), *arguments],
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            close_fds=True,
            timeout=10,
            check=check,
        )
    except (OSError, subprocess.SubprocessError) as error:
        raise SupervisorError("fixed service coordination failed") from error


def _initial_state(slot: str, digest: str) -> dict[str, Any]:
    return {
        "activation_deadline": None,
        "active_slot": slot,
        "boot_attempts": 0,
        "expected_sha256": digest,
        "generation": 1,
        "previous_slot": None,
        "rollback_performed": False,
        "schema_version": 1,
        "slot_sha256": {"A": digest if slot == "A" else None, "B": digest if slot == "B" else None},
        "status": "stable",
    }


def initialize(slot: str, digest: str) -> int:
    descriptor = _open_slot(slot, digest)
    os.close(descriptor)
    _read_slot_identity(slot, digest)
    directory = _state_directory(create=True)
    lock = _lock(directory, exclusive=True)
    try:
        _cleanup_staging(directory)
        try:
            current = _read_state(directory)
        except SupervisorError as error:
            if "unavailable" not in str(error):
                raise
            _publish(directory, _initial_state(slot, digest))
        else:
            if current != _initial_state(slot, digest):
                raise SupervisorError("supervisor is already initialized differently")
    finally:
        os.close(lock)
        os.close(directory)
    return 0


def _pending_activation_state(
    state: dict[str, Any], slot: str, digest: str
) -> dict[str, Any]:
    slot_sha256 = dict(state["slot_sha256"])
    slot_sha256[slot] = digest
    return {
        **state,
        "generation": state["generation"] + 1,
        "previous_slot": state["active_slot"],
        "active_slot": slot,
        "slot_sha256": slot_sha256,
        "expected_sha256": digest,
        "activation_deadline": _now() + ACTIVATION_SECONDS,
        "boot_attempts": 0,
        "status": "pending",
        "rollback_performed": False,
    }


def activate(slot: str, digest: str) -> int:
    descriptor = _state_directory(create=False)
    lock = _lock(descriptor, exclusive=True)
    try:
        _cleanup_staging(descriptor)
        state = _read_state(descriptor)
        if state["status"] != "stable" or state["active_slot"] == slot:
            raise SupervisorError("activation slot is not inactive")
        new_fd = _open_slot(slot, digest)
        os.close(new_fd)
        _read_slot_identity(slot, digest)
        old_digest = state["slot_sha256"][state["active_slot"]]
        assert isinstance(old_digest, str)
        old_fd = _open_slot(state["active_slot"], old_digest)
        os.close(old_fd)
        _publish(descriptor, _pending_activation_state(state, slot, digest))
    finally:
        os.close(lock)
        os.close(descriptor)
    _service("--no-block", "restart", "dgx-forge-agent-supervisor.service")
    return 0


def apply_request() -> int:
    request_directory, request, request_identity = _read_activation_request()
    state_directory = _state_directory(create=False)
    lock = _lock(state_directory, exclusive=True)
    published = False
    consumption_error: SupervisorError | None = None
    try:
        _cleanup_staging(state_directory)
        state = _read_state(state_directory)
        target = request["target_slot"]
        previous = request["previous_slot"]
        expected_target = "B" if state["active_slot"] == "A" else "A"
        if (
            state["status"] != "stable"
            or previous != state["active_slot"]
            or target != expected_target
        ):
            raise SupervisorError("activation request does not match stable state")
        active_digest = state["slot_sha256"][state["active_slot"]]
        assert isinstance(active_digest, str)
        active = _open_slot(state["active_slot"], active_digest)
        os.close(active)
        _install_candidate(request)
        _publish(
            state_directory,
            _pending_activation_state(state, target, request["sha256"]),
        )
        published = True
        try:
            _consume_activation_request(request_directory, request_identity)
        except SupervisorError as error:
            consumption_error = error
    finally:
        os.close(lock)
        os.close(state_directory)
        os.close(request_directory)
    if published:
        _service("--no-block", "restart", "dgx-forge-agent-supervisor.service")
    if consumption_error is not None:
        raise consumption_error
    return 0


def _rename_noreplace(
    source_directory: int,
    source: str,
    destination_directory: int,
    destination: str,
) -> None:
    renameat2 = getattr(ctypes.CDLL(None, use_errno=True), "renameat2", None)
    if renameat2 is None:
        raise SupervisorError("atomic readiness quarantine is unavailable")
    renameat2.argtypes = [
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_int,
        ctypes.c_char_p,
        ctypes.c_uint,
    ]
    renameat2.restype = ctypes.c_int
    if (
        renameat2(
            source_directory,
            os.fsencode(source),
            destination_directory,
            os.fsencode(destination),
            1,
        )
        != 0
    ):
        value = ctypes.get_errno()
        if value == errno.ENOENT:
            raise FileNotFoundError(value, os.strerror(value), source)
        if value == errno.EEXIST:
            raise FileExistsError(value, os.strerror(value), destination)
        raise SupervisorError("readiness marker cannot be quarantined")


def _readiness_quarantine_directory() -> int:
    path = _path(READINESS_QUARANTINE_ROOT)
    if _test_root() and not path.parent.exists():
        _mkdirs(path.parent, 0o755)
    parent = _open_directory_ancestry(path.parent)
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent)
            os.fsync(parent)
        except FileExistsError:
            pass
        directory = os.open(
            path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        _trusted(os.fstat(directory), 0o700, regular=False)
        return directory
    except Exception:
        if "directory" in locals():
            os.close(directory)
        raise
    finally:
        os.close(parent)


def _publish_readiness_replacement_for_test(directory: int) -> None:
    configured = any(
        os.environ.get(name) == "1"
        for name in (
            "DGX_SUPERVISOR_SWAP_READINESS_TEST",
            "DGX_SUPERVISOR_SWAP_READINESS_AFTER_STAT_TEST",
        )
    )
    if not configured:
        return
    try:
        os.rename(
            "replacement.json",
            "readiness.json",
            src_dir_fd=directory,
            dst_dir_fd=directory,
        )
        os.fsync(directory)
    except OSError as error:
        raise SupervisorError("readiness race hook failed") from error


def _read_readiness(state: dict[str, Any]) -> bool:
    root = _path(RUNTIME_ROOT)
    expected_owner = _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid
    try:
        directory = _open_directory_ancestry(root, final_owner=expected_owner)
    except FileNotFoundError:
        return False
    quarantine = _readiness_quarantine_directory()
    quarantine_name = f"readiness.{secrets.token_hex(12)}.consumed"
    descriptor = -1
    try:
        try:
            _rename_noreplace(
                directory,
                "readiness.json",
                quarantine,
                quarantine_name,
            )
        except FileNotFoundError:
            return False
        os.fsync(directory)
        os.fsync(quarantine)
        descriptor = os.open(
            quarantine_name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=quarantine,
        )
        metadata = os.fstat(descriptor)
        runtime_metadata = os.fstat(directory)
        if (
            runtime_metadata.st_uid != expected_owner
            or stat.S_IMODE(runtime_metadata.st_mode) != 0o700
        ):
            raise SupervisorError("readiness runtime directory is unsafe")
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
        ):
            raise SupervisorError("readiness marker is unsafe")
        if metadata.st_size > 4096:
            raise SupervisorError("readiness marker is too large")
        raw = os.read(descriptor, 4097)
        marker = _decode(raw, readiness=True)
        valid_types = (
            marker["schema_version"] == 1
            and isinstance(marker["generation"], int)
            and not isinstance(marker["generation"], bool)
            and marker["slot"] in SLOTS
            and isinstance(marker["sha256"], str)
            and DIGEST.fullmatch(marker["sha256"])
        )
        accepted = bool(
            valid_types
            and marker["generation"] == state["generation"]
            and marker["slot"] == state["active_slot"]
            and marker["sha256"] == state["expected_sha256"]
        )
        _publish_readiness_replacement_for_test(directory)
        return accepted
    except FileNotFoundError:
        return False
    except (KeyError, SupervisorError):
        return False
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        try:
            os.unlink(quarantine_name, dir_fd=quarantine)
            os.fsync(quarantine)
        except FileNotFoundError:
            pass
        os.close(quarantine)
        os.close(directory)


def _stable(state: dict[str, Any], *, rollback: bool = False) -> dict[str, Any]:
    return {
        **state,
        "activation_deadline": None,
        "boot_attempts": 0,
        "status": "stable",
        "rollback_performed": rollback,
    }


def _swap_pending_slot_before_commit_for_test(state: dict[str, Any]) -> None:
    configured = os.environ.get("DGX_SUPERVISOR_SWAP_SLOT_BEFORE_COMMIT_TEST")
    if configured is None:
        return
    if _test_root() is None or configured != "1":
        raise SupervisorError("pending slot race hook is invalid")
    path = _slot_path(state["active_slot"])
    parent = _open_directory_ancestry(path.parent)
    try:
        os.rename(
            ".dgx-forge-agent.commit-race",
            path.name,
            src_dir_fd=parent,
            dst_dir_fd=parent,
        )
        os.fsync(parent)
    except OSError as error:
        raise SupervisorError("pending slot race hook failed") from error
    finally:
        os.close(parent)


def _rollback(directory: int, state: dict[str, Any]) -> None:
    previous = state["previous_slot"]
    if state["rollback_performed"] or previous not in SLOTS:
        raise SupervisorError("activation requires explicit recovery")
    previous_digest = state["slot_sha256"][previous]
    if not isinstance(previous_digest, str):
        raise SupervisorError("previous slot is unavailable")
    old_fd = _open_slot(previous, previous_digest)
    os.close(old_fd)
    _read_slot_identity(previous, previous_digest)
    failed = state["active_slot"]
    rolled_back = _stable(
        {
            **state,
            "active_slot": previous,
            "previous_slot": failed,
            "expected_sha256": previous_digest,
        },
        rollback=True,
    )
    _publish(directory, rolled_back)


def _ensure_runtime_directory() -> None:
    path = _path(RUNTIME_ROOT)
    if _test_root() and not path.parent.exists():
        _mkdirs(path.parent, 0o755)
    parent = _open_directory_ancestry(path.parent)
    try:
        try:
            os.mkdir(path.name, 0o700, dir_fd=parent)
            created = True
        except FileExistsError:
            created = False
        directory = os.open(
            path.name,
            os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        try:
            if created:
                if _test_root() is None:
                    account = pwd.getpwnam("dgx-agent")
                    os.fchown(directory, account.pw_uid, account.pw_gid)
                os.fchmod(directory, 0o700)
                os.fsync(directory)
                os.fsync(parent)
            metadata = os.fstat(directory)
            expected_owner = (
                _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid
            )
            if (
                metadata.st_uid != expected_owner
                or stat.S_IMODE(metadata.st_mode) != 0o700
            ):
                raise SupervisorError("readiness runtime directory is unsafe")
        finally:
            os.close(directory)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("readiness runtime directory cannot be prepared") from error
    finally:
        os.close(parent)


def supervise() -> int:
    directory = _state_directory(create=False)
    coordination = _lock(directory, exclusive=True, name="coordination.lock")
    lock = _lock(directory, exclusive=True)
    restart_after_rollback = False
    try:
        _cleanup_staging(directory)
        state = _read_state(directory)
        try:
            active_fd = _open_slot(state["active_slot"], state["expected_sha256"])
            _read_slot_identity(state["active_slot"], state["expected_sha256"])
        except SupervisorError:
            if state["status"] == "pending":
                _rollback(directory, state)
                restart_after_rollback = True
                result = 1
            else:
                raise
        else:
            os.close(active_fd)
            if state["status"] == "stable":
                os.close(lock)
                lock = -1
                _ensure_runtime_directory()
                _service("start", "dgx-forge-agent.service")
                return 0
            if (
                state["boot_attempts"] >= MAX_BOOT_ATTEMPTS
                or _now() >= state["activation_deadline"]
            ):
                _rollback(directory, state)
                restart_after_rollback = True
                result = 1
            else:
                state = {**state, "boot_attempts": state["boot_attempts"] + 1}
                _publish(directory, state)
                os.close(lock)
                lock = -1
                _ensure_runtime_directory()
                _service("restart", "dgx-forge-agent.service")
                poll = 0.25
                if _test_root():
                    poll = float(os.environ.get("DGX_SUPERVISOR_POLL_SECONDS", "0.01"))
                ready = False
                while _now() < state["activation_deadline"]:
                    if _read_readiness(state):
                        ready = True
                        break
                    failed = _service(
                        "is-failed",
                        "--quiet",
                        "dgx-forge-agent.service",
                        check=False,
                    )
                    if failed.returncode == 0:
                        break
                    time.sleep(
                        max(
                            0.001,
                            min(poll, state["activation_deadline"] - _now()),
                        )
                    )
                if ready:
                    _swap_pending_slot_before_commit_for_test(state)
                lock = _lock(directory, exclusive=True)
                current = _read_state(directory)
                if current != state:
                    raise SupervisorError("activation state changed during supervision")
                if ready:
                    try:
                        pending_fd = _open_slot(
                            state["active_slot"], state["expected_sha256"]
                        )
                    except SupervisorError:
                        _rollback(directory, state)
                        restart_after_rollback = True
                        result = 1
                    else:
                        os.close(pending_fd)
                        _publish(directory, _stable(state))
                        result = 0
                else:
                    _rollback(directory, state)
                    restart_after_rollback = True
                    result = 1
    finally:
        if lock >= 0:
            os.close(lock)
        os.close(coordination)
        os.close(directory)
    if restart_after_rollback:
        _service("restart", "dgx-forge-agent.service")
    return result


def run_agent() -> int:
    directory = _state_directory(create=False)
    lock = _lock(directory, exclusive=False)
    executable = -1
    try:
        state = _read_state(directory)
        executable = _open_slot(state["active_slot"], state["expected_sha256"])
        identity = _read_slot_identity(
            state["active_slot"], state["expected_sha256"]
        )
    finally:
        os.close(lock)
        os.close(directory)
    environment = {
        "HOME": "/var/lib/dgx-forge-agent",
        "LANG": "C.UTF-8",
        "LC_ALL": "C.UTF-8",
        "PATH": "/usr/bin",
        "PYTHONNOUSERSITE": "1",
        "PYTHONSAFEPATH": "1",
        "DGX_AGENT_SUPERVISOR_GENERATION": str(state["generation"]),
        "DGX_AGENT_SUPERVISOR_SLOT": state["active_slot"],
        "DGX_AGENT_SUPERVISOR_SHA256": state["expected_sha256"],
        "DGX_AGENT_PLATFORM_VERSION": identity["platform_version"],
        "DGX_AGENT_BUILD_DIGEST": identity["build_digest"],
    }
    try:
        os.execve(f"/proc/self/fd/{executable}", ["dgx-forge-agent"], environment)
    except OSError as error:
        os.close(executable)
        raise SupervisorError("verified slot could not be executed") from error
    return 1


def _parser() -> UsageParser:
    parser = UsageParser(description="stable DGX Forge agent A/B supervisor")
    subparsers = parser.add_subparsers(dest="command", required=True)
    for command in ("initialize", "activate"):
        child = subparsers.add_parser(command)
        child.add_argument("--slot", choices=SLOTS, required=True)
        child.add_argument("--sha256", required=True)
    subparsers.add_parser("apply-request")
    subparsers.add_parser("supervise")
    subparsers.add_parser("run-agent")
    return parser


def main(argv: list[str] | None = None) -> int:
    arguments = _parser().parse_args(argv)
    try:
        crash_stage = os.environ.get("DGX_SUPERVISOR_CRASH_AFTER")
        if crash_stage is not None and (
            not _test_root()
            or crash_stage
            not in {"create", "write", "file-fsync", "rename", "directory-fsync"}
        ):
            raise SupervisorError("publication crash hook is invalid")
        readiness_swap = os.environ.get("DGX_SUPERVISOR_SWAP_READINESS_TEST")
        if readiness_swap is not None and (
            not _test_root() or readiness_swap != "1"
        ):
            raise SupervisorError("readiness race hook is invalid")
        readiness_after_stat = os.environ.get(
            "DGX_SUPERVISOR_SWAP_READINESS_AFTER_STAT_TEST"
        )
        if readiness_after_stat is not None and (
            not _test_root() or readiness_after_stat != "1"
        ):
            raise SupervisorError("readiness race hook is invalid")
        slot_swap = os.environ.get("DGX_SUPERVISOR_SWAP_SLOT_BEFORE_COMMIT_TEST")
        if slot_swap is not None and (not _test_root() or slot_swap != "1"):
            raise SupervisorError("pending slot race hook is invalid")
        if arguments.command in {"initialize", "activate"} and not DIGEST.fullmatch(arguments.sha256):
            raise SupervisorError("SHA-256 is invalid")
        if arguments.command == "initialize":
            return initialize(arguments.slot, arguments.sha256)
        if arguments.command == "activate":
            return activate(arguments.slot, arguments.sha256)
        if arguments.command == "apply-request":
            return apply_request()
        if arguments.command == "supervise":
            return supervise()
        if arguments.command == "run-agent":
            return run_agent()
        raise SupervisorError("unknown command")
    except SupervisorError as error:
        print(f"ERROR: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
