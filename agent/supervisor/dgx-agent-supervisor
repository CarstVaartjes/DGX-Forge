class SupervisorError(RuntimeError):
    pass


class UsageParser(argparse.ArgumentParser):
    def error(self, message: str) -> None:
        self.print_usage(sys.stderr)
        self.exit(64, f"{self.prog}: error: {message}\n")


def _test_root() -> Path | None:
    value = os.environ.get("DGX_SUPERVISOR_TEST_ROOT")
    if value is None:
        return None
    if os.geteuid() == 0:
        raise SupervisorError("test root is forbidden for root")
    path = Path(value)
    if not path.is_absolute():
        raise SupervisorError("test root must be absolute")
    return path


def _path(absolute: str) -> Path:
    root = _test_root()
    return Path(absolute) if root is None else root / absolute.lstrip("/")


def _owner() -> int:
    root = _test_root()
    if root is None:
        return 0
    value = os.environ.get("DGX_SUPERVISOR_TEST_UID")
    if value is None or not value.isdecimal() or int(value) != os.geteuid():
        raise SupervisorError("test UID is invalid")
    return int(value)


def _architecture() -> str:
    value = os.environ.get("DGX_SUPERVISOR_TEST_ARCH") if _test_root() else None
    machine = value or platform.machine()
    if machine == "AMD64":
        machine = "x86_64"
    if machine == "arm64":
        machine = "aarch64"
    if machine not in MACHINE:
        raise SupervisorError("unsupported architecture")
    return machine


def _now() -> float:
    value = os.environ.get("DGX_SUPERVISOR_NOW") if _test_root() else None
    if value is None:
        return time.time()
    try:
        rendered = float(value)
    except ValueError as error:
        raise SupervisorError("test clock is invalid") from error
    if rendered < 0:
        raise SupervisorError("test clock is invalid")
    return rendered


def _systemctl() -> str:
    value = os.environ.get("DGX_SUPERVISOR_SYSTEMCTL") if _test_root() else None
    if value is None:
        return "/usr/bin/systemctl"
    path = Path(value)
    if not path.is_absolute() or path.is_symlink():
        raise SupervisorError("test systemctl is unsafe")
    return str(path)


STATE_ROOT = "/var/lib/dgx-forge-agent-supervisor"
SLOT_ROOT = "/opt/dgx-forge/agent-slots"
RUNTIME_ROOT = "/run/dgx-forge-agent"
READINESS_QUARANTINE_ROOT = "/run/dgx-forge-agent-supervisor"
