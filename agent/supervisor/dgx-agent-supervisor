AUTHORIZATION_FLOOR_NAME = "authorization-floor.json"
ACTIVATION_CHALLENGE_NAME = "activation-challenge"
INACTIVE_CHALLENGE = "0" * 64


def _canonical(value: object) -> bytes:
    return (
        json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
        + "\n"
    ).encode("ascii")


def _platform_target_matches(name: Any, version: Any, sha256: Any) -> bool:
    if not all(isinstance(value, str) for value in (name, version, sha256)):
        return False
    match = PLATFORM_TARGET.fullmatch(name)
    return bool(
        match
        and match.group("version") == version
        and match.group("sha256") == sha256
    )


def _unique(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise SupervisorError("JSON contains duplicate fields")
        result[key] = value
    return result


def _reject_constant(_value: str) -> None:
    raise SupervisorError("JSON contains a nonfinite number")


def _decode(raw: bytes, *, readiness: bool = False) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("JSON is invalid") from error
    if not isinstance(value, dict) or _canonical(value) != raw:
        raise SupervisorError("JSON is not canonical")
    fields = READINESS_FIELDS if readiness else STATE_FIELDS
    if set(value) != fields:
        raise SupervisorError("JSON fields are invalid")
    return value


def _decode_activation_request(raw: bytes) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("activation request JSON is invalid") from error
    if not isinstance(value, dict) or _canonical(value) != raw:
        raise SupervisorError("activation request is invalid")
    authorization = value.get("authorization")
    signature = value.get("signature")
    if (
        set(value) != ACTIVATION_REQUEST_FIELDS
        or value["schema_version"] != 2
        or not isinstance(authorization, dict)
        or set(authorization) != ACTIVATION_AUTHORIZATION_FIELDS
        or not isinstance(signature, dict)
        or set(signature) != ACTIVATION_SIGNATURE_FIELDS
        or authorization["target_slot"] not in SLOTS
        or authorization["previous_slot"] not in SLOTS
        or authorization["target_slot"] == authorization["previous_slot"]
        or authorization["architecture"] not in ARCHITECTURE.values()
        or isinstance(authorization["attempt"], bool)
        or authorization["attempt"] != 1
        or isinstance(authorization["claim_deadline"], bool)
        or not isinstance(authorization["claim_deadline"], int)
        or authorization["claim_deadline"] != authorization["expires_at"]
        or not isinstance(authorization["node_id"], str)
        or re.fullmatch(r"spk_[0-9a-f]{32}", authorization["node_id"]) is None
        or isinstance(authorization["previous_generation"], bool)
        or not isinstance(authorization["previous_generation"], int)
        or not 1 <= authorization["previous_generation"] <= 999_999_999
        or not isinstance(authorization["sha256"], str)
        or DIGEST.fullmatch(authorization["sha256"]) is None
        or not isinstance(authorization["previous_sha256"], str)
        or DIGEST.fullmatch(authorization["previous_sha256"]) is None
        or not isinstance(authorization["oci_manifest_digest"], str)
        or re.fullmatch(
            r"sha256:[0-9a-f]{64}", authorization["oci_manifest_digest"]
        )
        is None
        or not isinstance(authorization["platform_target_sha256"], str)
        or DIGEST.fullmatch(authorization["platform_target_sha256"]) is None
        or not _platform_target_matches(
            authorization["platform_target_name"],
            authorization["platform_version"],
            authorization["platform_target_sha256"],
        )
        or not isinstance(authorization["payload_name"], str)
        or TOKEN.fullmatch(authorization["payload_name"]) is None
        or not isinstance(authorization["build_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", authorization["build_digest"])
        is None
        or not isinstance(authorization["platform_version"], str)
        or re.fullmatch(
            r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
            authorization["platform_version"],
        )
        is None
        or not isinstance(authorization["operation_id"], str)
        or UUID.fullmatch(authorization["operation_id"]) is None
        or not isinstance(authorization["fence"], str)
        or UUID.fullmatch(authorization["fence"]) is None
        or isinstance(authorization["expires_at"], bool)
        or not isinstance(authorization["expires_at"], int)
        or not 1 <= authorization["expires_at"] <= 9_007_199_254_740_991
        or isinstance(authorization["tuf_targets_version"], bool)
        or not isinstance(authorization["tuf_targets_version"], int)
        or not 1 <= authorization["tuf_targets_version"] <= 2_147_483_647
        or isinstance(authorization["size"], bool)
        or not isinstance(authorization["size"], int)
        or not 64 <= authorization["size"] <= EXECUTABLE_LIMIT
        or signature["algorithm"] != "ed25519"
        or not isinstance(signature["key_id"], str)
        or DIGEST.fullmatch(signature["key_id"]) is None
        or not isinstance(signature["value"], str)
        or SIGNATURE.fullmatch(signature["value"]) is None
    ):
        raise SupervisorError("activation request is invalid")
    return value


def _decode_slot_identity(raw: bytes, expected_sha256: str) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("slot identity JSON is invalid") from error
    if (
        not isinstance(value, dict)
        or set(value) != IDENTITY_FIELDS
        or _canonical(value) != raw
        or not isinstance(value["schema_version"], int)
        or isinstance(value["schema_version"], bool)
        or value["schema_version"] != 1
        or value["sha256"] != expected_sha256
        or not isinstance(value["build_digest"], str)
        or re.fullmatch(r"sha256:[0-9a-f]{64}", value["build_digest"]) is None
        or not isinstance(value["platform_version"], str)
        or re.fullmatch(
            r"(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)",
            value["platform_version"],
        )
        is None
    ):
        raise SupervisorError("slot identity is invalid")
    return value


def _decode_rollback_request(raw: bytes) -> dict[str, Any]:
    try:
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (UnicodeDecodeError, json.JSONDecodeError, RecursionError) as error:
        raise SupervisorError("rollback request JSON is invalid") from error
    if not isinstance(value, dict) or _canonical(value) != raw:
        raise SupervisorError("rollback request is invalid")
    authorization = value.get("authorization")
    signature = value.get("signature")
    if (
        set(value) != ROLLBACK_REQUEST_FIELDS
        or value["schema_version"] != 2
        or not isinstance(authorization, dict)
        or set(authorization) != ROLLBACK_AUTHORIZATION_FIELDS
        or authorization["action"] != "operator-rollback"
        or isinstance(authorization["attempt"], bool)
        or authorization["attempt"] != 1
        or isinstance(authorization["claim_deadline"], bool)
        or not isinstance(authorization["claim_deadline"], int)
        or authorization["claim_deadline"] != authorization["expires_at"]
        or not isinstance(authorization["node_id"], str)
        or re.fullmatch(r"spk_[0-9a-f]{32}", authorization["node_id"]) is None
        or isinstance(authorization["current_generation"], bool)
        or not isinstance(authorization["current_generation"], int)
        or not 1 <= authorization["current_generation"] <= 999_999_999
        or authorization["current_slot"] not in SLOTS
        or not isinstance(authorization["current_sha256"], str)
        or DIGEST.fullmatch(authorization["current_sha256"]) is None
        or not isinstance(authorization["operation_id"], str)
        or UUID.fullmatch(authorization["operation_id"]) is None
        or not isinstance(authorization["fence"], str)
        or UUID.fullmatch(authorization["fence"]) is None
        or isinstance(authorization["expires_at"], bool)
        or not isinstance(authorization["expires_at"], int)
        or not 1 <= authorization["expires_at"] <= 9_007_199_254_740_991
        or not isinstance(signature, dict)
        or set(signature) != ACTIVATION_SIGNATURE_FIELDS
        or signature["algorithm"] != "ed25519"
        or not isinstance(signature["key_id"], str)
        or DIGEST.fullmatch(signature["key_id"]) is None
        or not isinstance(signature["value"], str)
        or SIGNATURE.fullmatch(signature["value"]) is None
    ):
        raise SupervisorError("rollback request is invalid")
    return value


def _agent_owner() -> int:
    return _owner() if _test_root() else pwd.getpwnam("dgx-agent").pw_uid


def _trusted(metadata: os.stat_result, mode: int, *, regular: bool) -> None:
    if metadata.st_uid != _owner():
        raise SupervisorError("path owner is unsafe")
    if stat.S_IMODE(metadata.st_mode) != mode:
        raise SupervisorError("path mode is unsafe")
    if regular and (not stat.S_ISREG(metadata.st_mode) or metadata.st_nlink != 1):
        raise SupervisorError("path type is unsafe")
    if not regular and not stat.S_ISDIR(metadata.st_mode):
        raise SupervisorError("path type is unsafe")


def _mkdirs(path: Path, final_mode: int) -> None:
    current = Path(path.anchor)
    for index, component in enumerate(path.parts[1:]):
        current = current / component
        final = index == len(path.parts[1:]) - 1
        try:
            os.mkdir(current, final_mode if final else 0o755)
        except FileExistsError:
            pass
        metadata = os.lstat(current)
        if stat.S_ISLNK(metadata.st_mode) or not stat.S_ISDIR(metadata.st_mode):
            raise SupervisorError("directory ancestry is unsafe")
        mode = stat.S_IMODE(metadata.st_mode)
        writable = mode & 0o022 and not (_test_root() and mode & stat.S_ISVTX)
        if metadata.st_uid not in {_owner(), 0} or writable:
            raise SupervisorError("directory ancestry is unsafe")
    os.chmod(path, final_mode)


def _state_directory(*, create: bool) -> int:
    root = _path(STATE_ROOT)
    if create:
        _mkdirs(root, 0o755)
    try:
        descriptor = _open_directory_ancestry(root)
    except OSError as error:
        raise SupervisorError("state root is unavailable") from error
    try:
        _trusted(os.fstat(descriptor), 0o755, regular=False)
    except Exception:
        os.close(descriptor)
        raise
    return descriptor


def _lock(
    directory: int, *, exclusive: bool, name: str = "supervisor.lock"
) -> int:
    if name not in {"supervisor.lock", "coordination.lock"}:
        raise SupervisorError("lock selection is invalid")
    descriptor = -1
    if exclusive:
        try:
            descriptor = os.open(
                name,
                os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
                0o644,
                dir_fd=directory,
            )
            os.fchmod(descriptor, 0o644)
            os.fsync(descriptor)
            os.fsync(directory)
        except FileExistsError:
            pass
    if descriptor < 0:
        try:
            descriptor = os.open(
                name,
                (os.O_RDWR if exclusive else os.O_RDONLY)
                | os.O_NOFOLLOW
                | os.O_CLOEXEC,
                dir_fd=directory,
            )
        except FileNotFoundError:
            raise SupervisorError("supervisor is not initialized") from None
    metadata = os.fstat(descriptor)
    _trusted(metadata, 0o644, regular=True)
    fcntl.flock(descriptor, fcntl.LOCK_EX if exclusive else fcntl.LOCK_SH)
    return descriptor


def _read_state(directory: int) -> dict[str, Any]:
    try:
        descriptor = os.open(
            "state.json",
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
    except OSError as error:
        raise SupervisorError("state is unavailable") from error
    try:
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o644, regular=True)
        if metadata.st_size > STATE_LIMIT:
            raise SupervisorError("state is too large")
        raw = os.read(descriptor, STATE_LIMIT + 1)
        if len(raw) > STATE_LIMIT:
            raise SupervisorError("state is too large")
    finally:
        os.close(descriptor)
    state = _decode(raw)
    _validate_state(state)
    return state


def _validate_state(value: dict[str, Any]) -> None:
    if value["schema_version"] != 1:
        raise SupervisorError("state schema is invalid")
    generation = value["generation"]
    if (
        not isinstance(generation, int)
        or isinstance(generation, bool)
        or not 1 <= generation <= 999_999_999
    ):
        raise SupervisorError("state generation is invalid")
    active = value["active_slot"]
    previous = value["previous_slot"]
    if active not in SLOTS or (previous is not None and previous not in SLOTS):
        raise SupervisorError("state slots are invalid")
    slot_digests = value["slot_sha256"]
    if not isinstance(slot_digests, dict) or set(slot_digests) != set(SLOTS):
        raise SupervisorError("slot digests are invalid")
    for digest in slot_digests.values():
        if digest is not None and (not isinstance(digest, str) or not DIGEST.fullmatch(digest)):
            raise SupervisorError("slot digest is invalid")
    if slot_digests[active] != value["expected_sha256"] or not isinstance(value["expected_sha256"], str) or not DIGEST.fullmatch(value["expected_sha256"]):
        raise SupervisorError("expected digest is invalid")
    if value["status"] not in {"stable", "pending"}:
        raise SupervisorError("state status is invalid")
    deadline = value["activation_deadline"]
    attempts = value["boot_attempts"]
    if not isinstance(attempts, int) or isinstance(attempts, bool) or not 0 <= attempts <= MAX_BOOT_ATTEMPTS:
        raise SupervisorError("boot attempts are invalid")
    if not isinstance(value["rollback_performed"], bool):
        raise SupervisorError("rollback state is invalid")
    if value["status"] == "stable":
        if deadline is not None or attempts != 0:
            raise SupervisorError("stable state is invalid")
    elif (
        not isinstance(deadline, (int, float))
        or isinstance(deadline, bool)
        or not math.isfinite(deadline)
        or deadline <= 0
        or previous not in SLOTS
        or previous == active
        or value["rollback_performed"]
    ):
        raise SupervisorError("pending state is invalid")


def _publish(directory: int, state: dict[str, Any]) -> None:
    _validate_state(state)
    raw = _canonical(state)
    temporary = f".state.{secrets.token_hex(12)}.new"
    descriptor = -1
    try:
        descriptor = os.open(
            temporary,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW | os.O_CLOEXEC,
            0o644,
            dir_fd=directory,
        )
        os.fchmod(descriptor, 0o644)
        _crash("create")
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        _crash("write")
        os.fsync(descriptor)
        _crash("file-fsync")
        os.close(descriptor)
        descriptor = -1
        os.rename(temporary, "state.json", src_dir_fd=directory, dst_dir_fd=directory)
        _crash("rename")
        os.fsync(directory)
        _crash("directory-fsync")
    except OSError as error:
        try:
            os.unlink(temporary, dir_fd=directory)
        except OSError:
            pass
        raise SupervisorError("state publication failed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _crash(stage: str) -> None:
    if _test_root() and os.environ.get("DGX_SUPERVISOR_CRASH_AFTER") == stage:
        os._exit(99)


def _cleanup_staging(directory: int) -> None:
    changed = False
    for name in os.listdir(directory):
        if not STAGING.fullmatch(name):
            continue
        descriptor = -1
        try:
            descriptor = os.open(
                name,
                os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=directory,
            )
            metadata = os.fstat(descriptor)
            if (
                not stat.S_ISREG(metadata.st_mode)
                or metadata.st_uid != _owner()
                or metadata.st_nlink != 1
                or stat.S_IMODE(metadata.st_mode) != 0o644
                or metadata.st_size > STATE_LIMIT
            ):
                raise SupervisorError("state staging file is unsafe")
            os.unlink(name, dir_fd=directory)
            changed = True
        except OSError as error:
            raise SupervisorError("state staging cleanup failed") from error
        finally:
            if descriptor >= 0:
                os.close(descriptor)
    if changed:
        os.fsync(directory)


def _slot_path(slot: str) -> Path:
    return _path(f"{SLOT_ROOT}/{slot}/dgx-forge-agent")


def _open_directory_ancestry(path: Path, *, final_owner: int | None = None) -> int:
    if not path.is_absolute() or len(path.parts) < 2:
        raise SupervisorError("fixed directory path is invalid")
    descriptor = os.open("/", os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        for index, component in enumerate(path.parts[1:]):
            child = os.open(
                component,
                os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC,
                dir_fd=descriptor,
            )
            os.close(descriptor)
            descriptor = child
            metadata = os.fstat(descriptor)
            mode = stat.S_IMODE(metadata.st_mode)
            owners = {0, _owner()}
            if index == len(path.parts[1:]) - 1 and final_owner is not None:
                owners.add(final_owner)
            if metadata.st_uid not in owners or (
                mode & 0o022 and not mode & stat.S_ISVTX
            ):
                raise SupervisorError("directory ancestry is unsafe")
        return descriptor
    except SupervisorError:
        os.close(descriptor)
        raise
    except FileNotFoundError:
        os.close(descriptor)
        raise
    except OSError as error:
        os.close(descriptor)
        raise SupervisorError("directory ancestry is unsafe") from error


def _verify_elf_header(header: bytes) -> None:
    if len(header) < 20 or header[:4] != b"\x7fELF":
        raise SupervisorError("slot executable is not ELF")
    if header[4:6] != b"\x02\x01" or header[6] != 1:
        raise SupervisorError("slot ELF format is unsupported")
    elf_type, machine = struct.unpack_from("<HH", header, 16)
    if elf_type not in {2, 3} or machine != MACHINE[_architecture()]:
        raise SupervisorError("slot ELF architecture is invalid")


def _open_slot(slot: str, expected: str) -> int:
    if slot not in SLOTS or not DIGEST.fullmatch(expected):
        raise SupervisorError("slot selection is invalid")
    path = _slot_path(slot)
    try:
        parent = _open_directory_ancestry(path.parent)
    except OSError as error:
        raise SupervisorError("slot root is unavailable") from error
    descriptor = -1
    try:
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        before = os.fstat(descriptor)
        _trusted(before, 0o555, regular=True)
        if before.st_size < 64 or before.st_size > EXECUTABLE_LIMIT:
            raise SupervisorError("slot executable size is invalid")
        hasher = hashlib.sha256()
        header = b""
        total = 0
        while True:
            chunk = os.read(descriptor, min(1024 * 1024, EXECUTABLE_LIMIT + 1 - total))
            if not chunk:
                break
            if len(header) < 64:
                header += chunk[: 64 - len(header)]
            total += len(chunk)
            if total > EXECUTABLE_LIMIT:
                raise SupervisorError("slot executable is too large")
            hasher.update(chunk)
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns, before.st_ctime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns, after.st_ctime_ns):
            raise SupervisorError("slot executable changed during verification")
        if total != before.st_size or hasher.hexdigest() != expected:
            raise SupervisorError("slot executable digest is invalid")
        _verify_elf_header(header)
        os.lseek(descriptor, 0, os.SEEK_SET)
        return descriptor
    except SupervisorError:
        if descriptor >= 0:
            os.close(descriptor)
        raise
    except OSError as error:
        if descriptor >= 0:
            os.close(descriptor)
        raise SupervisorError("slot executable is unavailable") from error
    finally:
        os.close(parent)


def _read_slot_identity(slot: str, expected_sha256: str) -> dict[str, Any]:
    path = _slot_path(slot).with_name("identity.json")
    try:
        parent = _open_directory_ancestry(path.parent)
    except OSError as error:
        raise SupervisorError("slot identity root is unavailable") from error
    descriptor = -1
    try:
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o444, regular=True)
        if metadata.st_size > 4096:
            raise SupervisorError("slot identity is too large")
        raw = os.read(descriptor, 4097)
        if len(raw) > 4096:
            raise SupervisorError("slot identity is too large")
        return _decode_slot_identity(raw, expected_sha256)
    except SupervisorError:
        raise
    except OSError as error:
        raise SupervisorError("slot identity is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent)


def _file_identity(metadata: os.stat_result) -> tuple[int, int, int, int, int]:
    return (
        metadata.st_dev,
        metadata.st_ino,
        metadata.st_size,
        metadata.st_mtime_ns,
        metadata.st_ctime_ns,
    )


def _read_runtime_request(
    name: str,
    decoder: Any,
    label: str,
) -> tuple[int, dict[str, Any], tuple[int, ...]]:
    path = _path(RUNTIME_ROOT)
    expected_owner = _agent_owner()
    try:
        directory = _open_directory_ancestry(path, final_owner=expected_owner)
    except (FileNotFoundError, OSError) as error:
        raise SupervisorError(f"{label} request is unavailable") from error
    descriptor = -1
    try:
        runtime = os.fstat(directory)
        if (
            runtime.st_uid != expected_owner
            or stat.S_IMODE(runtime.st_mode) != 0o700
        ):
            raise SupervisorError(f"{label} runtime directory is unsafe")
        descriptor = os.open(
            name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
        metadata = os.fstat(descriptor)
        if (
            metadata.st_uid != expected_owner
            or stat.S_IMODE(metadata.st_mode) != 0o600
            or not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_size > 4096
        ):
            raise SupervisorError(f"{label} request path is unsafe")
        raw = os.read(descriptor, 4097)
        if len(raw) > 4096:
            raise SupervisorError(f"{label} request is too large")
        return directory, decoder(raw), _file_identity(metadata)
    except SupervisorError:
        os.close(directory)
        raise
    except OSError as error:
        os.close(directory)
        raise SupervisorError(f"{label} request is unavailable") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _read_activation_request() -> tuple[int, dict[str, Any], tuple[int, ...]]:
    return _read_runtime_request(
        "activation-request.json", _decode_activation_request, "activation"
    )


def _read_rollback_request() -> tuple[int, dict[str, Any], tuple[int, ...]]:
    return _read_runtime_request(
        "rollback-request.json", _decode_rollback_request, "rollback"
    )


def _read_update_authority() -> dict[str, Any]:
    path = _path(UPDATE_AUTHORITY_PATH)
    try:
        parent = _open_directory_ancestry(path.parent)
    except (FileNotFoundError, OSError) as error:
        raise SupervisorError("update authority is unavailable") from error
    descriptor = -1
    try:
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o444, regular=True)
        if metadata.st_size > 4096:
            raise SupervisorError("update authority is unsafe")
        raw = os.read(descriptor, 4097)
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SupervisorError("update authority is unsafe") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)
        os.close(parent)
    if (
        not isinstance(value, dict)
        or set(value) != AUTHORITY_FIELDS
        or _canonical(value) != raw
        or value["schema_version"] != 1
        or value["algorithm"] != "ed25519"
        or not isinstance(value["public_key"], str)
        or DIGEST.fullmatch(value["public_key"]) is None
        or not isinstance(value["key_id"], str)
        or DIGEST.fullmatch(value["key_id"]) is None
        or hashlib.sha256(bytes.fromhex(value["public_key"])).hexdigest()
        != value["key_id"]
    ):
        raise SupervisorError("update authority is unsafe")
    return value


def _read_installed_node_id() -> str:
    path = _path(AGENT_CONFIG_PATH)
    try:
        parent = _open_directory_ancestry(path.parent)
        descriptor = os.open(
            path.name,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=parent,
        )
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o644, regular=True)
        if metadata.st_size > 16 * 1024:
            raise SupervisorError("installed agent identity is unsafe")
        raw = os.read(descriptor, 16 * 1024 + 1)
        value = json.loads(
            raw.decode("utf-8"),
            object_pairs_hook=_unique,
            parse_constant=_reject_constant,
        )
    except SupervisorError:
        raise
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SupervisorError("installed agent identity is unavailable") from error
    finally:
        if "descriptor" in locals():
            os.close(descriptor)
        if "parent" in locals():
            os.close(parent)
    node_id = value.get("node_id") if isinstance(value, dict) else None
    if (
        not isinstance(value, dict)
        or _canonical(value) != raw
        or not isinstance(node_id, str)
        or re.fullmatch(r"spk_[0-9a-f]{32}", node_id) is None
    ):
        raise SupervisorError("installed agent identity is unsafe")
    return node_id


def _memfd(name: str, content: bytes) -> int:
    try:
        descriptor = os.memfd_create(name, os.MFD_CLOEXEC)
        offset = 0
        while offset < len(content):
            offset += os.write(descriptor, content[offset:])
        os.lseek(descriptor, 0, os.SEEK_SET)
        return descriptor
    except OSError as error:
        raise SupervisorError("authorization verifier is unavailable") from error


def _verify_ed25519(public_key: bytes, message: bytes, signature: bytes) -> None:
    # The supervisor intentionally has no Python package dependency.  It invokes
    # one fixed system verifier with anonymous memfds: no caller-controlled path,
    # shell, environment lookup, network, or persistent verification material.
    subject_public_key_info = bytes.fromhex("302a300506032b6570032100") + public_key
    descriptors = [
        _memfd("dgx-update-key", subject_public_key_info),
        _memfd("dgx-update-message", message),
        _memfd("dgx-update-signature", signature),
    ]
    try:
        try:
            verified = subprocess.run(
                [
                    OPENSSL_PATH,
                    "pkeyutl",
                    "-verify",
                    "-pubin",
                    "-inkey",
                    f"/proc/self/fd/{descriptors[0]}",
                    "-rawin",
                    "-in",
                    f"/proc/self/fd/{descriptors[1]}",
                    "-sigfile",
                    f"/proc/self/fd/{descriptors[2]}",
                ],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                close_fds=True,
                pass_fds=tuple(descriptors),
                env={"LANG": "C", "LC_ALL": "C"},
                timeout=5,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as error:
            raise SupervisorError("authorization verifier is unavailable") from error
        if verified.returncode != 0:
            raise SupervisorError("activation authorization signature is invalid")
    finally:
        for descriptor in descriptors:
            os.close(descriptor)


def _authorization_marker_name(authorization: dict[str, Any]) -> str:
    # Fences are globally one-use while an operation ID may legitimately recur
    # on a later, explicitly signed retry attempt with a fresh fence.
    identity = authorization["fence"].encode("ascii")
    return f"authorization-{hashlib.sha256(identity).hexdigest()}.used"


def _read_authorization_floor(directory: int) -> int:
    try:
        descriptor = os.open(
            AUTHORIZATION_FLOOR_NAME,
            os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC,
            dir_fd=directory,
        )
    except FileNotFoundError:
        return 0
    try:
        metadata = os.fstat(descriptor)
        _trusted(metadata, 0o444, regular=True)
        if metadata.st_size > 256:
            raise SupervisorError("authorization version floor is unsafe")
        raw = os.read(descriptor, 257)
        value = json.loads(raw.decode("ascii"), object_pairs_hook=_unique)
    except SupervisorError:
        raise
    except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
        raise SupervisorError("authorization version floor is unsafe") from error
    finally:
        os.close(descriptor)
    if (
        not isinstance(value, dict)
        or set(value) != {"schema_version", "tuf_targets_version"}
        or _canonical(value) != raw
        or value["schema_version"] != 1
        or isinstance(value["tuf_targets_version"], bool)
        or not isinstance(value["tuf_targets_version"], int)
        or value["tuf_targets_version"] < 1
    ):
        raise SupervisorError("authorization version floor is unsafe")
    return value["tuf_targets_version"]


def _verify_activation_authorization(
    request: dict[str, Any], state_directory: int
) -> None:
    # Trust model: the installer pins this narrow update-authority public key in
    # a root-owned file.  The NAS-side signer may issue a receipt only after its
    # maintained TUF client authorizes the named platform target/version.  The
    # receipt carries that TUF evidence and every mutable installation binding.
    # This root process deliberately does not trust the agent's TUF cache: a
    # fully compromised dgx-agent may write the request and staged ELF, but it
    # cannot forge, extend, alter, downgrade, or replay the signed receipt.
    authorization = request["authorization"]
    signature = request["signature"]
    authority = _read_update_authority()
    if signature["key_id"] != authority["key_id"]:
        raise SupervisorError("activation authorization key is not trusted")
    if authorization["architecture"] != ARCHITECTURE[_architecture()]:
        raise SupervisorError("activation authorization architecture is invalid")
    if authorization["node_id"] != _read_installed_node_id():
        raise SupervisorError("activation authorization node is invalid")
    now = _now()
    if authorization["expires_at"] <= now:
        raise SupervisorError("activation authorization has expired")
    if authorization["expires_at"] > now + 600:
        raise SupervisorError("activation authorization expiry is too distant")
    _verify_ed25519(
        bytes.fromhex(authority["public_key"]),
        _canonical(authorization),
        bytes.fromhex(signature["value"]),
    )
    if authorization["tuf_targets_version"] < _read_authorization_floor(
        state_directory
    ):
        raise SupervisorError("activation authorization metadata is stale")
    marker = _authorization_marker_name(authorization)
    try:
        metadata = os.stat(marker, dir_fd=state_directory, follow_symlinks=False)
    except FileNotFoundError:
        return
    _trusted(metadata, 0o444, regular=True)
    raise SupervisorError("activation authorization was already consumed")


def _consume_activation_authorization(
    request: dict[str, Any], state_directory: int
) -> None:
    authorization = request["authorization"]
    marker = _authorization_marker_name(authorization)
    marker_document = {
        "authorization_sha256": hashlib.sha256(
            _canonical(authorization)
        ).hexdigest(),
        "fence": authorization["fence"],
        "operation_id": authorization["operation_id"],
        "schema_version": 1,
        "signature_sha256": hashlib.sha256(
            bytes.fromhex(request["signature"]["value"])
        ).hexdigest(),
        "tuf_targets_version": authorization["tuf_targets_version"],
    }
    current_floor = _read_authorization_floor(state_directory)
    if authorization["tuf_targets_version"] > current_floor:
        # Advancing a trusted metadata floor before recording one-time use is
        # fail-closed across power loss: a crash may require retrying this fresh
        # receipt, but can never reopen an older signed metadata generation.
        _write_atomic_at(
            state_directory,
            AUTHORIZATION_FLOOR_NAME,
            _canonical(
                {
                    "schema_version": 1,
                    "tuf_targets_version": authorization["tuf_targets_version"],
                }
            ),
            mode=0o444,
            label="authorization version floor",
        )
    descriptor = -1
    try:
        descriptor = os.open(
            marker,
            os.O_WRONLY
            | os.O_CREAT
            | os.O_EXCL
            | os.O_NOFOLLOW
            | os.O_CLOEXEC,
            0o444,
            dir_fd=state_directory,
        )
        os.fchmod(descriptor, 0o444)
        raw = _canonical(marker_document)
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
        os.close(descriptor)
        descriptor = -1
        os.fsync(state_directory)
    except FileExistsError:
        raise SupervisorError("activation authorization was already consumed") from None
    except OSError as error:
        raise SupervisorError("activation authorization cannot be consumed") from error
    finally:
        if descriptor >= 0:
            os.close(descriptor)


def _verify_rollback_authorization(
    request: dict[str, Any], state_directory: int
) -> None:
    authorization = request["authorization"]
    signature = request["signature"]
    authority = _read_update_authority()
    if signature["key_id"] != authority["key_id"]:
