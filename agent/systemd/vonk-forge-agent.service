[Unit]
Description=Vonk Forge outbound agent
Wants=network-online.target
After=network-online.target
PartOf=vonk-forge-agent-supervisor.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=vonk-agent
Group=vonk-agent
SupplementaryGroups=
ExecStart=/usr/libexec/vonk-agent-supervisor run-agent
LoadCredential=activation-challenge:/run/vonk-forge-agent-supervisor/activation-challenge
Restart=on-failure
RestartSec=5s
TimeoutStartSec=30s
TimeoutStopSec=30s
UMask=0077
RuntimeDirectory=vonk-forge-agent
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl r
DeviceAllow=/dev/nvidia-uvm r
DeviceAllow=/dev/nvidia-uvm-tools r
DeviceAllow=/dev/nvidia-modeset r
DeviceAllow=/dev/nvidia0 r
DeviceAllow=/dev/nvidia-caps/nvidia-cap2 r
BindReadOnlyPaths=-/dev/nvidiactl -/dev/nvidia-uvm -/dev/nvidia-uvm-tools -/dev/nvidia-modeset -/dev/nvidia0 -/dev/nvidia-caps/nvidia-cap2
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RemoveIPC=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/vonk-forge /etc/vonk-forge-agent /usr/libexec/vonk-agent-supervisor
ReadWritePaths=/var/lib/vonk-forge-agent /var/lib/vonk-forge/releases /var/lib/vonk-forge/release-staging /run/vonk-forge-agent

[Install]
WantedBy=multi-user.target
