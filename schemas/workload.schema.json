{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "adapter", "topology", "placement_class", "nodes", "start_order", "stop_order", "conflicts", "co_location", "accepted_evidence", "source", "checkpoint", "image", "paths", "endpoint", "commands", "resources"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "topology": {"enum": ["single", "distributed"]},
    "placement_class": {"enum": ["dual-exclusive", "single-exclusive", "single-shareable", "dual-pipeline-experimental"]},
    "nodes": {"type": "array", "items": {"enum": ["spark1", "spark2"]}, "minItems": 1, "uniqueItems": true},
    "start_order": {"type": "array", "items": {"enum": ["spark1", "spark2"]}, "minItems": 1, "uniqueItems": true},
    "stop_order": {"type": "array", "items": {"enum": ["spark1", "spark2"]}, "minItems": 1, "uniqueItems": true},
    "conflicts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "co_location": {"enum": ["exclusive", "accepted"]},
    "accepted_evidence": {"type": "string", "minLength": 1},
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}
    },
    "checkpoint": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision", "manifest"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest": {"type": "string", "minLength": 1}}
    },
    "image": {
      "type": "object", "additionalProperties": false, "required": ["reference"],
      "properties": {"reference": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"}}
    },
    "paths": {
      "type": "object", "additionalProperties": false, "required": ["cache", "scratch", "output"],
      "properties": {"cache": {"type": "string", "minLength": 1}, "scratch": {"type": "string", "minLength": 1}, "output": {"type": "string", "minLength": 1}}
    },
    "endpoint": {
      "type": "object", "additionalProperties": false, "required": ["host", "port"],
      "properties": {"host": {"type": "string", "minLength": 1}, "port": {"type": "integer", "minimum": 1, "maximum": 65535}}
    },
    "commands": {
      "type": "object", "additionalProperties": false, "required": ["prepare", "verify", "start", "health", "infer", "stop", "verify-release"],
      "properties": {
        "prepare": {"$ref": "#/$defs/command"}, "verify": {"$ref": "#/$defs/command"}, "start": {"$ref": "#/$defs/command"}, "health": {"$ref": "#/$defs/command"}, "infer": {"$ref": "#/$defs/command"}, "stop": {"$ref": "#/$defs/command"}, "verify-release": {"$ref": "#/$defs/command"}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false, "required": ["minimum_free_memory_bytes", "minimum_free_disk_bytes", "stop_memory_tolerance_bytes"],
      "properties": {"minimum_free_memory_bytes": {"type": "integer", "minimum": 1}, "minimum_free_disk_bytes": {"type": "integer", "minimum": 1}, "stop_memory_tolerance_bytes": {"type": "integer", "minimum": 1}}
    }
  },
  "$defs": {"command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
}
