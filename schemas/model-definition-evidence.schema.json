{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["stage", "definition_id", "definition_sha256", "runtime_manifest_sha256", "source", "checkpoint", "image", "recorded_at", "nodes", "predecessor", "gates"],
  "properties": {
    "stage": {"enum": ["prepared", "verified", "accepted"]},
    "definition_id": {"type": "string", "minLength": 1},
    "definition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "runtime_manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source": {"type": "object", "additionalProperties": false, "required": ["repository", "commit"], "properties": {"repository": {"type": "string", "minLength": 1}, "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["repository", "revision", "manifest_sha256"], "properties": {"repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "manifest_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}},
    "image": {"type": "object", "additionalProperties": false, "required": ["reference"], "properties": {"reference": {"type": "string", "pattern": "^.+@sha256:[0-9a-f]{64}$"}}},
    "recorded_at": {"type": "string", "format": "date-time"},
    "nodes": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["node", "boot_id"], "properties": {"node": {"enum": ["spark1", "spark2"]}, "boot_id": {"type": "string", "minLength": 1}}}},
    "predecessor": {"type": ["string", "null"], "minLength": 1},
    "gates": {"type": "object"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "prepared"}}}, "then": {"properties": {"predecessor": {"type": "null"}, "gates": {"type": "object", "additionalProperties": false, "required": ["artifacts", "node_manifests"], "properties": {"artifacts": {"const": true}, "node_manifests": {"const": true}}}}}},
    {"if": {"properties": {"stage": {"const": "verified"}}}, "then": {"properties": {"predecessor": {"type": "string", "minLength": 1}, "gates": {"type": "object", "additionalProperties": false, "required": ["offline", "release", "image", "architecture", "fabric", "role", "compose"], "properties": {"offline": {"const": true}, "release": {"const": true}, "image": {"const": true}, "architecture": {"const": true}, "fabric": {"const": true}, "role": {"const": true}, "compose": {"const": true}}}}}},
    {"if": {"properties": {"stage": {"const": "accepted"}}}, "then": {"properties": {"predecessor": {"type": "string", "minLength": 1}, "gates": {"type": "object", "additionalProperties": false, "required": ["quality", "lifecycle", "capacity", "performance", "thermal", "release", "reboot"], "properties": {"quality": {"const": true}, "lifecycle": {"const": true}, "capacity": {"const": true}, "performance": {"const": true}, "thermal": {"const": true}, "release": {"const": true}, "reboot": {"const": true}}}}}}
  ]
}
