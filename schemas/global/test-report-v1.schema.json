{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://api.vonkforge.ai/schemas/test-report/v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "recipe_sha256", "image_digest", "node_count", "checks", "started_at", "finished_at"],
  "properties": {
    "schema_version": {"const": 1},
    "recipe_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "node_count": {"type": "integer", "minimum": 1, "maximum": 16},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]+$"},
          "passed": {"type": "boolean"}
        }
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"}
  }
}
