{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/cluster-profile-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "accepted_evidence", "workloads", "requirements", "endpoints", "quotas", "lifecycle"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "accepted_evidence": {"type": "string", "minLength": 1},
    "workloads": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "requirements": {"type": "array", "items": {"$ref": "#/$defs/requirement"}},
    "endpoints": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "quotas": {"type": "object", "additionalProperties": {"$ref": "#/$defs/quota"}},
    "lifecycle": {
      "type": "object", "additionalProperties": false,
      "required": ["start_order", "stop_order"],
      "properties": {
        "start_order": {"enum": ["independent", "workers-before-entrypoint"]},
        "stop_order": {"enum": ["independent", "entrypoint-before-workers"]}
      }
    }
  },
  "$defs": {
    "quota": {"type":"object","additionalProperties":false,"required":["requests_per_minute","tokens_per_minute"],"properties":{"requests_per_minute":{"type":"integer","minimum":1,"maximum":100000},"tokens_per_minute":{"type":"integer","minimum":1,"maximum":100000000}}},
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["workload", "definition_hash", "node_count", "required_labels", "min_memory_bytes", "min_disk_bytes", "exclusive", "distributed_supported"],
      "properties": {
        "workload": {"type": "string", "minLength": 1},
        "definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "node_count": {"type": "integer", "minimum": 1},
        "required_labels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "min_memory_bytes": {"type": "integer", "minimum": 0},
        "min_disk_bytes": {"type": "integer", "minimum": 0},
        "exclusive": {"type": "boolean"},
        "distributed_supported": {"type": "boolean"},
        "preferred_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"}}
      }
    }
  }
}
