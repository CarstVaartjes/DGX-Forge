{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/topology.schema.json",
  "title": "Vonk Forge Topology v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes", "links"],
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nodeId"}
    },
    "links": {
      "type": "array",
      "items": {"$ref": "#/$defs/link"}
    }
  },
  "$defs": {
    "nodeId": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"},
    "link": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "accepted", "endpoints"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
        "kind": {"enum": ["management", "direct-rdma", "switched-rdma"]},
        "accepted": {"type": "boolean"},
        "endpoints": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/endpoint"}
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "interface"],
      "properties": {
        "node_id": {"$ref": "#/$defs/nodeId"},
        "interface": {"type": "string", "minLength": 1},
        "address": {"type": "string", "minLength": 1},
        "hca": {"type": "string", "minLength": 1},
        "gid_index": {"type": "integer", "minimum": 0},
        "mtu": {"type": "integer", "minimum": 576},
        "link_rate_mbps": {"type": "integer", "minimum": 1}
      }
    }
  }
}
