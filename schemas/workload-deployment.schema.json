{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgx-forge.local/schemas/workload-deployment.schema.json",
  "title": "DGX-Forge workload deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "deployment_id",
    "family_id",
    "release_digest",
    "selector",
    "secrets",
    "ports",
    "arguments",
    "routing",
    "resources"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "deployment_id": {"$ref": "#/$defs/identifier"},
    "family_id": {"$ref": "#/$defs/identifier"},
    "release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_count", "required_labels", "preferred_node_ids"],
      "properties": {
        "node_count": {"type": "integer", "minimum": 1, "maximum": 65535},
        "required_labels": {
          "type": "object",
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/bounded_text"}
        },
        "preferred_node_ids": {
          "type": "array",
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"}
        }
      }
    },
    "secrets": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {"$ref": "#/$defs/credential_ref"}
    },
    "ports": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {"$ref": "#/$defs/identifier"},
      "additionalProperties": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      }
    },
    "arguments": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "string",
        "maxLength": 4096,
        "pattern": "^[^\\u0000-\\u001f\\u007f]*$",
        "not": {
          "pattern": "(?:https?://|file://|secret://|(?:[Tt][Oo][Kk][Ee][Nn]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Aa][Pp][Ii][_-]?[Kk][Ee][Yy])\\s*=|(?:^|=)/|(?:^|/)\\.\\.(?:/|$))"
        }
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alias", "port"],
      "properties": {
        "alias": {"$ref": "#/$defs/identifier"},
        "port": {"$ref": "#/$defs/identifier"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_bytes", "storage_bytes", "gpu_count"],
      "properties": {
        "memory_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "storage_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1125899906842624
        },
        "gpu_count": {"type": "integer", "minimum": 0, "maximum": 1024}
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "bounded_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "credential_ref": {
      "type": "string",
      "minLength": 10,
      "maxLength": 256,
      "pattern": "^secret://[a-z][a-z0-9]*(?:[._/-][a-z0-9]+)*$"
    }
  }
}
