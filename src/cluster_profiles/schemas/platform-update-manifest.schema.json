{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgx-forge.invalid/schemas/platform-update-manifest.schema.json",
  "title": "DGX-Forge platform update manifest",
  "$comment": "Schema-only validation is not authorization. Consumers MUST use PlatformRelease.from_bytes so cross-field digest, range, architecture, predecessor, and target-identity invariants are enforced.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "platform_version",
    "build_digest",
    "host_updater_abi",
    "deployment_bundle",
    "control",
    "database",
    "agents",
    "supervisors",
    "tooling",
    "rollback"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "platform_version": {"$ref": "#/$defs/semanticVersion"},
    "build_digest": {"$ref": "#/$defs/prefixedDigest"},
    "host_updater_abi": {"$ref": "#/$defs/protocolRange"},
    "deployment_bundle": {"$ref": "#/$defs/ociDeploymentBundle"},
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_version", "protocol", "images", "assets"],
      "properties": {
        "config_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "protocol": {"$ref": "#/$defs/protocolRange"},
        "images": {
          "type": "object",
          "additionalProperties": false,
          "required": ["api", "worker"],
          "properties": {
            "api": {"$ref": "#/$defs/artifact"},
            "worker": {"$ref": "#/$defs/artifact"}
          }
        },
        "assets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/artifact"}
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expand_revision", "contract_revision", "predecessor_compatible"],
      "properties": {
        "expand_revision": {"$ref": "#/$defs/token"},
        "contract_revision": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/token"}
          ]
        },
        "predecessor_compatible": {"type": "boolean"}
      }
    },
    "agents": {"$ref": "#/$defs/architectureArtifactsWithProtocol"},
    "supervisors": {"$ref": "#/$defs/architectureArtifacts"},
    "tooling": {"$ref": "#/$defs/architectureArtifacts"},
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessors"],
      "properties": {
        "predecessors": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/authorizedPredecessor"}
        }
      }
    }
  },
  "$defs": {
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "prefixedDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "versionedPlatformTarget": {
      "type": "string",
      "pattern": "^platform/releases/(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)/[0-9a-f]{64}\\.json$"
    },
    "token": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "architecture": {
      "type": "string",
      "enum": ["linux-arm64", "linux-x86_64"]
    },
    "protocolRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": {"type": "integer", "minimum": 1, "maximum": 65535},
        "maximum": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "ociDeploymentBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "manifest_digest",
        "manifest_size",
        "manifest_media_type",
        "layer_digest",
        "layer_size",
        "layer_media_type"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$"
        },
        "manifest_digest": {"$ref": "#/$defs/prefixedDigest"},
        "manifest_size": {"type": "integer", "minimum": 1, "maximum": 16777216},
        "manifest_media_type": {"const": "application/vnd.oci.image.manifest.v1+json"},
        "layer_digest": {"$ref": "#/$defs/prefixedDigest"},
        "layer_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "layer_media_type": {"const": "application/vnd.dgx-forge.control-deployment.v1.tar"}
      }
    },
    "authorizedPredecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_name",
        "target_sha256",
        "release_digest",
        "build_digest",
        "deployment_bundle_digest"
      ],
      "properties": {
        "target_name": {"$ref": "#/$defs/versionedPlatformTarget"},
        "target_sha256": {"$ref": "#/$defs/digest"},
        "release_digest": {"$ref": "#/$defs/prefixedDigest"},
        "build_digest": {"$ref": "#/$defs/prefixedDigest"},
        "deployment_bundle_digest": {"$ref": "#/$defs/prefixedDigest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reference",
        "sha256",
        "size",
        "sbom_sha256",
        "provenance_sha256"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "reference": {
          "type": "string",
          "maxLength": 512,
          "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::[1-9][0-9]{0,4})?/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*(?:/[a-z0-9]+(?:(?:[._]|__|-+)[a-z0-9]+)*)*@sha256:[0-9a-f]{64}$"
        },
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 1, "maximum": 1099511627776},
        "sbom_sha256": {"$ref": "#/$defs/digest"},
        "provenance_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "architectureArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "artifact", "payload"],
      "properties": {
        "architecture": {"$ref": "#/$defs/architecture"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    "architectureArtifactWithProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["architecture", "protocol", "artifact", "payload"],
      "properties": {
        "architecture": {"$ref": "#/$defs/architecture"},
        "protocol": {"$ref": "#/$defs/protocolRange"},
        "artifact": {"$ref": "#/$defs/artifact"},
        "payload": {"$ref": "#/$defs/payload"}
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "sha256", "size"],
      "properties": {
        "name": {"$ref": "#/$defs/token"},
        "sha256": {"$ref": "#/$defs/digest"},
        "size": {"type": "integer", "minimum": 64, "maximum": 268435456}
      }
    },
    "architectureArtifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/architectureArtifact"}
    },
    "architectureArtifactsWithProtocol": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/architectureArtifactWithProtocol"}
    }
  }
}
