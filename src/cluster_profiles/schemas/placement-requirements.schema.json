{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgx-forge.local/schemas/placement-requirements.schema.json",
  "title": "DGX-Forge placement requirement v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "definition_hash", "node_count", "required_labels", "min_memory_bytes", "min_disk_bytes", "exclusive", "distributed", "model_supports_distributed", "preferred_node_ids"],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 128},
    "definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "node_count": {"type": "integer", "minimum": 1},
    "required_labels": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
    "min_memory_bytes": {"type": "integer", "minimum": 0},
    "min_disk_bytes": {"type": "integer", "minimum": 0},
    "exclusive": {"type": "boolean"},
    "distributed": {"type": "boolean"},
    "model_supports_distributed": {"type": "boolean"},
    "preferred_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"}}
  }
}
