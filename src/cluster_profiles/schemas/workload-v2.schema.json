{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.local/schemas/workload-v2.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "adapter", "definition_hash", "conflicts", "distributed_supported"],
  "properties": {
    "schema_version": {"const": 2},
    "id": {"type": "string", "minLength": 1},
    "adapter": {"type": "string", "minLength": 1},
    "definition_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "conflicts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "distributed_supported": {"type": "boolean"}
  }
}
