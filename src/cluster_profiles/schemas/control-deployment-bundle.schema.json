{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vonk-forge.invalid/schemas/control-deployment-bundle.schema.json",
  "title": "Vonk Forge control deployment bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "format": {"const": "vonk-control-deployment-bundle-v1"},
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "mode", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*\\\\)(?!.*//)(?!.*\\/$)[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
          },
          "mode": {"enum": [420, 493]},
          "size": {"type": "integer", "minimum": 1, "maximum": 16777216},
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
