{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["definitions"],
  "properties": {
    "definitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sha256", "maturity", "history"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "maturity": {"$ref": "#/$defs/maturity"},
          "history": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/transition"}
          }
        }
      }
    }
  },
  "$defs": {
    "maturity": {
      "enum": ["planned", "prepared", "verified", "accepted", "rejected"]
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "timestamp", "evidence_refs", "rejection_reason"],
      "properties": {
        "state": {"$ref": "#/$defs/maturity"},
        "timestamp": {"type": "string", "format": "date-time"},
        "evidence_refs": {"$ref": "#/$defs/evidenceRefs"},
        "rejection_reason": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "rejected"}}},
          "then": {"properties": {"rejection_reason": {"type": "string", "minLength": 1}}},
          "else": {"properties": {"rejection_reason": {"type": "null"}}}
        }
      ]
    }
  }
}
