{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgx-forge.local/schemas/fleet.schema.json",
  "title": "DGX-Forge Fleet v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "nodes"],
  "properties": {
    "schema_version": {"const": 2},
    "nodes": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^spk_[0-9a-f]{32}$"},
      "additionalProperties": {"$ref": "#/$defs/node"}
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "hostname", "management", "labels", "lifecycle"],
      "properties": {
        "display_name": {"type": "string", "minLength": 1},
        "hostname": {"type": "string", "minLength": 1},
        "management": {"$ref": "#/$defs/management"},
        "labels": {
          "type": "object",
          "propertyNames": {"type": "string", "minLength": 1},
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "lifecycle": {
          "enum": ["discovered", "installing", "ready", "quarantined", "draining", "retired"]
        }
      }
    },
    "management": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "user", "port"],
      "properties": {
        "host": {"type": "string", "minLength": 1},
        "user": {"type": "string", "minLength": 1},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "credential_ref": {"type": "string", "minLength": 1}
      }
    }
  }
}
