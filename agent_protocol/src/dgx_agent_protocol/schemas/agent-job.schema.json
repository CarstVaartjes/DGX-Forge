{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "operation_id", "attempt", "fence", "node_id", "operation", "base_commit", "payload_digest", "payload", "deadline"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "fence": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"},
    "operation": {"enum": ["node.probe", "release.install", "workload.prepare", "workload.start", "workload.stop", "workload.health", "workload.verify", "agent.update", "agent.rollback"]},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {"$ref": "#/$defs/safe-object"},
    "deadline": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
  },
  "$defs": {
    "safe-object": {
      "type": "object",
      "propertyNames": {"not": {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee].?[Kk][Ee][Yy]|[Cc][Oo][Mm][Mm][Aa][Nn][Dd]|[Ss][Hh][Ee][Ll][Ll]|[Ee][Nn][Vv][Ii][Rr][Oo][Nn][Mm][Ee][Nn][Tt]|(?:^|[_-])(?:[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Ff][Ii][Ll][Ee][Ss][Yy][Ss][Tt][Ee][Mm]|[Mm][Oo][Uu][Nn][Tt])(?:$|[_-])|(?:[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Ff][Ii][Ll][Ee][Ss][Yy][Ss][Tt][Ee][Mm]|[Mm][Oo][Uu][Nn][Tt])$"}},
      "additionalProperties": {"$ref": "#/$defs/safe-value"}
    },
    "safe-value": {
      "anyOf": [
        {"type": ["null", "boolean", "number"]},
        {"type": "string", "not": {"pattern": "[/\\\\]"}},
        {"type": "array", "items": {"$ref": "#/$defs/safe-value"}},
        {"$ref": "#/$defs/safe-object"}
      ]
    }
  }
}
