{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "operation_id", "attempt", "fence", "node_id", "deadline", "state", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "fence": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"},
    "deadline": {"type": "string", "format": "date-time"},
    "state": {"enum": ["succeeded", "failed", "waiting-for-operator"]},
    "result": {"type": "object"}
  }
}
