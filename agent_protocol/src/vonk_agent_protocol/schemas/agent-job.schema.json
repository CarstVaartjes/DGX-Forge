{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical payload UTF-8 JSON is limited to 65536 bytes by mandatory validate_schema_message runtime validation; JSON Schema cannot express aggregate encoded-byte size.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "job_id", "operation_id", "attempt", "fence", "node_id", "operation", "base_commit", "payload_digest", "payload", "deadline"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "format": "uuid"},
    "operation_id": {"type": "string", "format": "uuid"},
    "attempt": {"type": "integer", "minimum": 1},
    "fence": {"type": "string", "format": "uuid"},
    "node_id": {"type": "string", "pattern": "^spk_[0-9a-f]{32}$"},
    "operation": {"enum": ["node.probe", "release.install", "workload.prepare", "workload.start", "workload.stop", "workload.health", "workload.verify", "agent.update", "agent.rollback", "package.prepare", "package.activate", "package.health", "package.stop", "package.rollback", "package.remove", "package.repair", "package.gc", "recipe.build.v1", "recipe.image.import.v1", "recipe.install", "recipe.start", "recipe.stop", "recipe.uninstall"]},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "payload_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "payload": {
      "anyOf": [
        {"$ref": "#/$defs/safe-object"},
        {"$ref": "#/$defs/package-release-payload"},
        {"$ref": "#/$defs/package-gc-payload"}
      ]
    },
    "deadline": {"type": "string", "format": "date-time", "pattern": "(?:Z|\\+00:00)$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": ["package.prepare", "package.activate", "package.health", "package.stop", "package.rollback", "package.remove", "package.repair"]
          }
        },
        "required": ["operation"]
      },
      "then": {"properties": {"payload": {"$ref": "#/$defs/package-release-payload"}}}
    },
    {
      "if": {
        "properties": {"operation": {"const": "package.gc"}},
        "required": ["operation"]
      },
      "then": {"properties": {"payload": {"$ref": "#/$defs/package-gc-payload"}}}
    }
  ],
  "$defs": {
    "package-release-payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "deployment_id", "release_digest", "deployment_digest"],
      "properties": {
        "schema_version": {"const": 1},
        "deployment_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment_config_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "deployment": {"$ref": "#/$defs/package-deployment"}
      }
    },
    "package-deployment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "deployment_id", "family_id", "release_digest", "selector", "secrets", "ports", "arguments", "routing", "resources"],
      "properties": {
        "schema_version": {"const": 1},
        "deployment_id": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
        "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
        "release_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selector": {"type": "object"},
        "secrets": {
          "type": "object",
          "additionalProperties": {"type": "string", "pattern": "^secret://[^/\\\\]+(?:/[^/\\\\]+)*$"}
        },
        "ports": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1024, "maximum": 65535}},
        "arguments": {"type": "array", "maxItems": 128, "items": {"type": "string", "maxLength": 4096, "not": {"pattern": "[/\\\\]"}}},
        "routing": {"type": "object", "required": ["alias", "port"], "properties": {"alias": {"type": "string"}, "port": {"type": "string"}}, "additionalProperties": false},
        "resources": {"type": "object", "required": ["memory_bytes", "storage_bytes", "gpu_count"], "properties": {"memory_bytes": {"type": "integer", "minimum": 1}, "storage_bytes": {"type": "integer", "minimum": 1}, "gpu_count": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
        "mounts": {"type": "array", "maxItems": 64, "items": {"type": "object", "required": ["object_digest", "target", "read_only"], "properties": {"object_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "target": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.?(?:/|$))(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$"}, "read_only": {"const": true}}, "additionalProperties": false}},
        "devices": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}},
        "network": {"type": "object", "required": ["mode", "egress"], "properties": {"mode": {"enum": ["none", "restricted"]}, "egress": {"type": "array", "maxItems": 64, "items": {"type": "string"}}}, "additionalProperties": false}
      }
    },
    "package-gc-payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "dry_run"],
      "properties": {
        "schema_version": {"const": 1},
        "dry_run": {"type": "boolean"},
        "target_bytes": {"type": "integer", "minimum": 1, "maximum": 17592186044416}
      }
    },
    "safe-object": {
      "type": "object",
      "propertyNames": {
        "$comment": "The filesystem terms path, file, filename, filepath, directory, and folder start a forbidden key segment at the key edge, after '_'/'-', or as an uppercase term after lowercase/digit. The segment ends at the key edge, before '_'/'-', or before an uppercase continuation. Term matching is ASCII case-insensitive; lowercase continuations remain allowed.",
        "allOf": [
          {"not": {"pattern": "[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn]|[Aa][Uu][Tt][Hh][Oo][Rr][Ii][Zz][Aa][Tt][Ii][Oo][Nn]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee].?[Kk][Ee][Yy]|[Cc][Oo][Mm][Mm][Aa][Nn][Dd]|[Ss][Hh][Ee][Ll][Ll]|[Ee][Nn][Vv][Ii][Rr][Oo][Nn][Mm][Ee][Nn][Tt]"}},
          {"not": {"pattern": "(?:^|[_-])(?:[Pp][Aa][Tt][Hh]|[Ff][Ii][Ll][Ee]|[Ff][Ii][Ll][Ee][Nn][Aa][Mm][Ee]|[Ff][Ii][Ll][Ee][Pp][Aa][Tt][Hh]|[Dd][Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|[Ff][Oo][Ll][Dd][Ee][Rr])(?:$|[_-]|[A-Z])|[a-z0-9](?:P[Aa][Tt][Hh]|F[Ii][Ll][Ee]|F[Ii][Ll][Ee][Nn][Aa][Mm][Ee]|F[Ii][Ll][Ee][Pp][Aa][Tt][Hh]|D[Ii][Rr][Ee][Cc][Tt][Oo][Rr][Yy]|F[Oo][Ll][Dd][Ee][Rr])(?:$|[_-]|[A-Z])"}}
        ]
      },
      "additionalProperties": {"$ref": "#/$defs/safe-value"}
    },
    "safe-value": {
      "anyOf": [
        {"type": ["null", "boolean", "number"]},
        {"type": "string", "not": {"pattern": "[/\\\\]"}},
        {"type": "array", "items": {"$ref": "#/$defs/safe-value"}},
        {"$ref": "#/$defs/safe-object"}
      ]
    }
  }
}
