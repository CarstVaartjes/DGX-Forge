#!/usr/bin/env bash
set -euo pipefail

adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
docker_bin=${MIA_DOCKER_BIN:-docker}
curl_bin=${MIA_CURL_BIN:-curl}
ip_bin=${MIA_IP_BIN:-ip}
df_bin=${MIA_DF_BIN:-df}
nvidia_smi_bin=${MIA_NVIDIA_SMI_BIN:-nvidia-smi}
systemctl_bin=${MIA_SYSTEMCTL_BIN:-systemctl}
ss_bin=${MIA_SS_BIN:-ss}
sleep_bin=${MIA_SLEEP_BIN:-sleep}
models_root=${MIA_MODELS_ROOT:-/srv/models}
meminfo_path=${MIA_MEMINFO_PATH:-/proc/meminfo}
boot_id_path=${MIA_BOOT_ID_PATH:-/proc/sys/kernel/random/boot_id}
sys_class_net=${MIA_SYS_CLASS_NET:-/sys/class/net}
sys_class_infiniband=${MIA_SYS_CLASS_INFINIBAND:-/sys/class/infiniband}
operation=${1:-}
image_reference=ghcr.io/anemll/dspark-vllm-gx10@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8
checkpoint_manifest_sha256=82e965c1caa019b31f4d776d0b3eddb0cc0d8e076f189822b8a3bbe3fa115121
checkpoint_revision=9e165c30e2704aec5d9d593cce3eebd58bbef1cb
prepare_container=mia-deepseek-dual-prepare
minimum_free_memory_bytes=120000000000
minimum_free_disk_bytes=375809638400
stop_memory_tolerance_bytes=1073741824

case ${2:-} in
  head) role_env="$adapter_root/config/spark1.env" ;;
  worker) role_env="$adapter_root/config/spark2.env" ;;
  *)
    echo "role must be head or worker" >&2
    exit 2
    ;;
esac

# The controller supplies a role, but the physical node remains authoritative.
# MIA_LOCAL_HOSTNAME is a test hook; production calls use the kernel hostname.
# shellcheck disable=SC1090
source "$role_env"
actual_hostname=${MIA_LOCAL_HOSTNAME:-$(hostname)}
if [[ $actual_hostname != "$EXPECTED_HOSTNAME" ]]; then
  echo "role ${2} requires $EXPECTED_NODE/$EXPECTED_HOSTNAME; local host is $actual_hostname" >&2
  exit 2
fi

compose() {
  "$docker_bin" compose \
    --project-directory "$adapter_root" \
    --env-file "$adapter_root/config/common.env" \
    --env-file "$role_env" \
    -f "$adapter_root/compose.yaml" \
    "$@"
}

quality() {
  if [[ -n ${MIA_QUALITY_BIN:-} ]]; then
    "$MIA_QUALITY_BIN" "$@"
  else
    python3 "$adapter_root/validation/quality.py" "$@"
  fi
}

runtime_release_digest() {
  local digest=${MIA_RELEASE_SHA256:-$(basename "$adapter_root")}
  if [[ ! $digest =~ ^[0-9a-f]{64}$ ]]; then
    echo "runtime release path is not digest-qualified" >&2
    return 1
  fi
  printf '%s\n' "$digest"
}

boot_id() {
  local value
  value=$(cat "$boot_id_path")
  if [[ -z $value || $value == */* ]]; then
    echo "invalid boot ID" >&2
    return 1
  fi
  printf '%s\n' "$value"
}

lifecycle_root() {
  local release=$1
  local current_boot=$2
  printf '%s/runtime-cache/deepseek-agent-dual/lifecycle/%s/%s\n' \
    "$models_root" "$release" "$current_boot"
}

verify_no_autostart() {
  local unit="mia-deepseek-dual-${1}.service"
  local state rc system_units user_units
  if state=$(LC_ALL=C "$systemctl_bin" is-enabled "$unit" 2>&1); then
    case $state in
      disabled|masked|static|indirect|generated|transient|not-found) ;;
      enabled|enabled-runtime|linked|linked-runtime|alias)
        echo "autostart unit is enabled: $unit" >&2
        return 1
        ;;
      *)
        echo "cannot classify autostart unit state: $unit: $state" >&2
        return 1
        ;;
    esac
  else
    rc=$?
    case "$rc:$state" in
      1:disabled|1:masked|4:not-found) ;;
      *)
        echo "systemd autostart inspection failed: $unit: $state" >&2
        return 1
        ;;
    esac
  fi
  if ! system_units=$(LC_ALL=C "$systemctl_bin" list-unit-files \
    --type=service --no-legend 2>&1); then
    echo "systemd system-unit enumeration failed: $system_units" >&2
    return 1
  fi
  if ! user_units=$(LC_ALL=C "$systemctl_bin" --user list-unit-files \
    --type=service --no-legend 2>&1); then
    echo "systemd user-unit enumeration failed: $user_units" >&2
    return 1
  fi
  if awk '
    tolower($1) ~ /(mia-deepseek|deepseek-agent-dual|vllm)/ &&
      $2 ~ /^(enabled|enabled-runtime|linked|linked-runtime|alias)$/ { found=1 }
    END { exit !found }
  ' <<<"$system_units" || awk '
    tolower($1) ~ /(mia-deepseek|deepseek-agent-dual|vllm)/ &&
      $2 ~ /^(enabled|enabled-runtime|linked|linked-runtime|alias)$/ { found=1 }
    END { exit !found }
  ' <<<"$user_units"; then
    echo "matching runtime autostart unit is enabled" >&2
    return 1
  fi
}

verify_rail() {
  local interface=$1
  local expected_ip=$2
  local hca=$3
  local expected_gid=$4
  local port_root="$sys_class_infiniband/$hca/ports/1"
  local actual_gid

  [[ $(cat "$sys_class_net/$interface/operstate") == up ]] || {
    echo "fabric interface is not up: $interface" >&2
    return 1
  }
  [[ $(cat "$sys_class_net/$interface/mtu") == "$EXPECTED_MTU" ]] || {
    echo "fabric MTU mismatch: $interface" >&2
    return 1
  }
  "$ip_bin" -4 -o address show dev "$interface" |
    grep -F " inet $expected_ip/" >/dev/null || {
      echo "fabric IPv4 address mismatch: $interface expected $expected_ip" >&2
      return 1
    }
  grep -F "ACTIVE" "$port_root/state" >/dev/null || {
    echo "fabric HCA port is not active: $hca/1" >&2
    return 1
  }
  [[ $(cat "$port_root/gid_attrs/ndevs/3") == "$interface" ]] || {
    echo "fabric GID device mismatch: $hca/1/3" >&2
    return 1
  }
  [[ $(cat "$port_root/gid_attrs/types/3") == "RoCE v2" ]] || {
    echo "fabric GID type mismatch: $hca/1/3" >&2
    return 1
  }
  actual_gid=$(tr '[:upper:]' '[:lower:]' <"$port_root/gids/3")
  [[ $actual_gid == "$expected_gid" ]] || {
    echo "fabric GID value mismatch: $hca/1/3" >&2
    return 1
  }
}

checkpoint_manifest_path() {
  printf '%s/manifests/deepseek-v4-flash-0731.json\n' "$models_root"
}

snapshot_path() {
  printf '%s/snapshots/deepseek-v4-flash-0731\n' "$models_root"
}

manifest_tool_path() {
  local tool=${MIA_MODEL_MANIFEST_TOOL:-$adapter_root/tools/model_manifest.py}
  test -f "$tool"
  printf '%s\n' "$tool"
}

verify_local_snapshot() {
  local manifest snapshot tool
  manifest=$(checkpoint_manifest_path)
  snapshot=$(snapshot_path)
  tool=$(manifest_tool_path)
  test -d "$snapshot"
  test ! -L "$snapshot"
  python3 "$tool" verify --manifest "$manifest" --snapshot "$snapshot" >/dev/null
}

inspect_prepare_label() {
  local label=$1
  "$docker_bin" inspect --format "{{ index .Config.Labels \"$label\" }}" \
    "$prepare_container"
}

container="mia-deepseek-dual-${2}"

case "$operation" in
  render)
    compose config
    ;;
  prepare)
    release_digest=${MIA_RELEASE_SHA256:-$(basename "$adapter_root")}
    if [[ ! $release_digest =~ ^[0-9a-f]{64}$ ]]; then
      echo "runtime release path is not digest-qualified" >&2
      exit 1
    fi
    prepare_fingerprint=$(printf '%s:%s' \
      "$release_digest" "$checkpoint_manifest_sha256" | sha256sum | awk '{print $1}')
    manifest_source=${MIA_CHECKPOINT_MANIFEST_SOURCE:-$adapter_root/manifests/deepseek-v4-flash-0731.json}
    manifest=$(checkpoint_manifest_path)
    snapshot=$(snapshot_path)
    install -d -m 0750 \
      "$models_root/runtime-cache/deepseek-agent-dual/tmp" \
      "$models_root/runtime-cache/deepseek-agent-dual/vllm" \
      "$models_root/runtime-cache/deepseek-agent-dual/flashinfer" \
      "$models_root/runtime-cache/deepseek-agent-dual/prepare" \
      "$models_root/outputs/deepseek-agent-dual" \
      "$models_root/logs/deepseek-agent-dual" \
      "$models_root/manifests" \
      "$models_root/snapshots"
    if [[ $(sha256sum "$manifest_source" | awk '{print $1}') != "$checkpoint_manifest_sha256" ]]; then
      echo "release checkpoint manifest digest mismatch" >&2
      exit 1
    fi
    if [[ -e "$manifest" || -L "$manifest" ]]; then
      if [[ ! -f "$manifest" || -L "$manifest" ]] || ! cmp -s "$manifest_source" "$manifest"; then
        echo "installed checkpoint manifest differs" >&2
        exit 1
      fi
    else
      install -m 0644 "$manifest_source" "$manifest"
    fi

    container_exists=false
    if "$docker_bin" container inspect "$prepare_container" >/dev/null 2>&1; then
      container_exists=true
      runtime_label=$(inspect_prepare_label spark.runtime-release)
      checkpoint_label=$(inspect_prepare_label spark.checkpoint-manifest)
      fingerprint_label=$(inspect_prepare_label spark.prepare-fingerprint)
      container_image_reference=$(
        "$docker_bin" inspect --format '{{.Config.Image}}' "$prepare_container"
      )
      if [[ $runtime_label != "$release_digest" || \
            $checkpoint_label != "$checkpoint_manifest_sha256" || \
            $fingerprint_label != "$prepare_fingerprint" ]]; then
        echo "preparation container fingerprint mismatch" >&2
        exit 1
      fi
      if [[ $container_image_reference != "$image_reference" ]]; then
        echo "preparation container image mismatch" >&2
        exit 1
      fi
    fi

    if ! "$docker_bin" image inspect "$image_reference" >/dev/null 2>&1; then
      "$docker_bin" pull "$image_reference"
    fi
    "$docker_bin" image inspect "$image_reference" >/dev/null
    if [[ $container_exists == true ]]; then
      container_image_id=$(
        "$docker_bin" inspect --format '{{.Image}}' "$prepare_container"
      )
      pinned_image_id=$(
        "$docker_bin" image inspect --format '{{.Id}}' "$image_reference"
      )
      if [[ $container_image_id != "$pinned_image_id" ]]; then
        echo "preparation container image mismatch" >&2
        exit 1
      fi
    fi

    if [[ $container_exists == false && ( -e "$snapshot" || -L "$snapshot" ) ]]; then
      verify_local_snapshot
      printf 'prepared role=%s\n' "${2}"
      exit 0
    fi

    if [[ $container_exists == true ]]; then
      prepare_status=$("$docker_bin" inspect --format '{{.State.Status}}' "$prepare_container")
      case "$prepare_status" in
        running)
          ;;
        created)
          "$docker_bin" start "$prepare_container" >/dev/null
          ;;
        exited)
          prepare_exit=$("$docker_bin" inspect --format '{{.State.ExitCode}}' "$prepare_container")
          if [[ $prepare_exit == 0 ]]; then
            verify_local_snapshot
            printf 'prepared role=%s\n' "${2}"
            exit 0
          fi
          "$docker_bin" start "$prepare_container" >/dev/null
          ;;
        *)
          echo "unsupported preparation container state: $prepare_status" >&2
          exit 1
          ;;
      esac
    else
      available_bytes=$("$df_bin" -PB1 "$models_root" | awk 'NR == 2 {print $4}')
      if [[ ! $available_bytes =~ ^[0-9]+$ || $available_bytes -lt 350000000000 ]]; then
        echo "preparation requires at least 350000000000 free bytes" >&2
        exit 1
      fi
      staging_name=.deepseek-v4-flash-0731.prepare-$prepare_fingerprint
      "$docker_bin" run --detach \
        --name "$prepare_container" \
        --restart no \
        --pull never \
        --network bridge \
        --user "$(id -u):$(id -g)" \
        --read-only \
        --tmpfs /tmp:rw,noexec,nosuid,nodev,size=1g \
        --cap-drop ALL \
        --security-opt no-new-privileges \
        --label "spark.runtime-release=$release_digest" \
        --label "spark.checkpoint-manifest=$checkpoint_manifest_sha256" \
        --label "spark.prepare-fingerprint=$prepare_fingerprint" \
        --env NVIDIA_VISIBLE_DEVICES=void \
        --env PYTHONDONTWRITEBYTECODE=1 \
        --env HF_HOME=/prepare-cache/huggingface \
        --env HF_HUB_DISABLE_XET=1 \
        --env HF_HUB_DISABLE_SYMLINKS=1 \
        --env HF_HUB_DISABLE_TELEMETRY=1 \
        --env HF_HUB_DOWNLOAD_TIMEOUT=600 \
        --env "STAGING_DIR=/snapshots/$staging_name" \
        --env FINAL_DIR=/snapshots/deepseek-v4-flash-0731 \
        --env "METADATA_DIR=/snapshots/.deepseek-v4-flash-0731.metadata-$prepare_fingerprint" \
        --volume "$models_root/snapshots:/snapshots:rw" \
        --volume "$models_root/runtime-cache/deepseek-agent-dual/prepare:/prepare-cache:rw" \
        --volume "$adapter_root:/release:ro" \
        --entrypoint bash \
        "$image_reference" \
        -lc "$(cat <<PREPARE_SCRIPT
	set -euo pipefail
	[[ "\$STAGING_DIR" == /snapshots/.deepseek-v4-flash-0731.prepare-* ]]
	if [[ -e "\$METADATA_DIR" || -L "\$METADATA_DIR" ]]; then
	  [[ -d "\$METADATA_DIR" && ! -L "\$METADATA_DIR" ]]
	  [[ ! -e "\$STAGING_DIR/.cache" && ! -L "\$STAGING_DIR/.cache" ]]
	  mkdir -p -- "\$STAGING_DIR"
	  mv -- "\$METADATA_DIR" "\$STAGING_DIR/.cache"
	fi
	python3 -c 'import inspect, sys; from huggingface_hub import snapshot_download; kwargs={"repo_id":"deepseek-ai/DeepSeek-V4-Flash-0731","revision":"$checkpoint_revision","local_dir":sys.argv[1],"token":False,"max_workers":1}; kwargs.update(local_dir_use_symlinks=False) if "local_dir_use_symlinks" in inspect.signature(snapshot_download).parameters else None; snapshot_download(**kwargs)' "\$STAGING_DIR"
	[[ ! -e "\$METADATA_DIR" && ! -L "\$METADATA_DIR" ]]
	if [[ -e "\$STAGING_DIR/.cache" || -L "\$STAGING_DIR/.cache" ]]; then
	  [[ -d "\$STAGING_DIR/.cache" && ! -L "\$STAGING_DIR/.cache" ]]
	  mv -- "\$STAGING_DIR/.cache" "\$METADATA_DIR"
	fi
python3 /release/tools/model_manifest.py verify --manifest /release/manifests/deepseek-v4-flash-0731.json --snapshot "\$STAGING_DIR"
python3 -c 'import ctypes, os, sys; libc=ctypes.CDLL(None,use_errno=True); fn=libc.renameat2; fn.argtypes=[ctypes.c_int,ctypes.c_char_p,ctypes.c_int,ctypes.c_char_p,ctypes.c_uint]; fn.restype=ctypes.c_int; rc=fn(-100,os.fsencode(sys.argv[1]),-100,os.fsencode(sys.argv[2]),1); error=ctypes.get_errno(); rc == 0 or (_ for _ in ()).throw(OSError(error,os.strerror(error),sys.argv[2]))' "\$STAGING_DIR" "\$FINAL_DIR"
PREPARE_SCRIPT
)" >/dev/null
    fi

    prepare_exit=$("$docker_bin" wait "$prepare_container" | tail -n 1)
    if [[ $prepare_exit != 0 ]]; then
      "$docker_bin" logs --tail 200 "$prepare_container" >&2 || true
      echo "preparation container failed with exit code $prepare_exit" >&2
      exit 1
    fi
    verify_local_snapshot
    printf 'prepared role=%s\n' "${2}"
    ;;
  verify)
    runtime_release_digest >/dev/null
    compose config --format json | quality validate-compose --role "${2}"
    inspected_image=$(
      "$docker_bin" image inspect --format \
        '{{range .RepoDigests}}{{println .}}{{end}}' \
        "$image_reference"
    )
    if ! grep -Fx "$image_reference" <<<"$inspected_image" >/dev/null; then
      echo "runtime image digest mismatch" >&2
      exit 1
    fi
    gpu_names=$(
      "$nvidia_smi_bin" --query-gpu=name --format=csv,noheader
    )
    if [[ -z $gpu_names ]] || grep -Fv 'GB10' <<<"$gpu_names" >/dev/null; then
      echo "GB10 architecture check failed" >&2
      exit 1
    fi
    mem_available_bytes=$(awk \
      '$1 == "MemAvailable:" {printf "%.0f\n", $2 * 1024; found=1} END {if (!found) exit 1}' \
      "$meminfo_path")
    if [[ ! $mem_available_bytes =~ ^[0-9]+$ || \
          $mem_available_bytes -lt $minimum_free_memory_bytes ]]; then
      echo "insufficient free memory" >&2
      exit 1
    fi
    available_disk_bytes=$(
      "$df_bin" -PB1 "$models_root" | awk 'NR == 2 {print $4}'
    )
    if [[ ! $available_disk_bytes =~ ^[0-9]+$ || \
          $available_disk_bytes -lt $minimum_free_disk_bytes ]]; then
      echo "insufficient free disk" >&2
      exit 1
    fi
    conflicting_runtimes=$(
      "$docker_bin" ps --format '{{.Names}}' | \
        grep -E '(^mia-deepseek-dual-(head|worker)$|vllm|ollama|litellm)' || true
    )
    if [[ -n $conflicting_runtimes ]]; then
      echo "conflicting runtime is active: $conflicting_runtimes" >&2
      exit 1
    fi
    verify_no_autostart "${2}"
    manifest="$models_root/manifests/deepseek-v4-flash-0731.json"
    snapshot="$models_root/snapshots/deepseek-v4-flash-0731"
    test -f "$manifest"
    manifest_sha256=$(sha256sum "$manifest" | awk '{print $1}')
    if [[ $manifest_sha256 != 82e965c1caa019b31f4d776d0b3eddb0cc0d8e076f189822b8a3bbe3fa115121 ]]; then
      echo "checkpoint manifest digest mismatch" >&2
      exit 1
    fi
    manifest_tool=$(manifest_tool_path)
    python3 "$manifest_tool" verify --manifest "$manifest" --snapshot "$snapshot" >/dev/null
    verify_rail "$FABRIC_INTERFACE_0" "$FABRIC_IP_0" "$FABRIC_HCA_0" "$FABRIC_GID_0"
    verify_rail "$FABRIC_INTERFACE_1" "$FABRIC_IP_1" "$FABRIC_HCA_1" "$FABRIC_GID_1"
    printf 'verified role=%s\n' "${2}"
    ;;
  start)
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    lifecycle=$(lifecycle_root "$release_digest" "$current_boot")
    idle_seconds=${MIA_IDLE_SECONDS:-60}
    if [[ ! $idle_seconds =~ ^[0-9]+$ ]]; then
      echo "invalid idle baseline duration" >&2
      exit 1
    fi
    install -d -m 0750 "$lifecycle"
    "$sleep_bin" "$idle_seconds"
    quality record-baseline \
      --output "$lifecycle/${2}.baseline.json" \
      --meminfo "$meminfo_path" \
      --release-sha256 "$release_digest" \
      --boot-id-file "$boot_id_path" \
      --role "${2}"
    compose up --detach --no-build --pull never --remove-orphans
    ;;
  health)
    running=$("$docker_bin" inspect --format '{{.State.Running}}' "$container")
    [[ $running == true ]]
    container_image=$(
      "$docker_bin" inspect --format '{{.Config.Image}}' "$container"
    )
    if [[ $container_image != "$image_reference" ]]; then
      echo "container image mismatch" >&2
      exit 1
    fi
    expected_rank=1
    if [[ ${2} == head ]]; then
      expected_rank=0
    fi
    container_environment=$(
      "$docker_bin" inspect --format '{{range .Config.Env}}{{println .}}{{end}}' \
        "$container"
    )
    if ! grep -Fx "NODE_RANK=$expected_rank" <<<"$container_environment" >/dev/null; then
      echo "container rank mismatch: expected $expected_rank" >&2
      exit 1
    fi
    if [[ ${2} == head ]]; then
      "$curl_bin" --fail --silent --show-error --max-time 10 \
        http://127.0.0.1:8888/health >/dev/null
      "$curl_bin" --fail --silent --show-error --max-time 10 \
        http://127.0.0.1:8888/v1/models | quality validate-models
      compose config --format json | quality validate-compose --role head
      "$docker_bin" logs --tail 2000 "$container" 2>&1 | quality validate-logs
    fi
    printf 'healthy role=%s\n' "${2}"
    ;;
  infer)
    if [[ ${2} != head ]]; then
      echo "infer is head-only" >&2
      exit 2
    fi
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    evidence_dir="$models_root/outputs/deepseek-agent-dual/quality/$release_digest"
    evidence="$evidence_dir/$current_boot.json"
    install -d -m 0750 "$evidence_dir"
    quality run \
      --fixtures "$adapter_root/validation/quality-fixtures.json" \
      --output "$evidence" \
      --base-url http://127.0.0.1:8888 \
      --release-sha256 "$release_digest" \
      --boot-id-file "$boot_id_path"
    ;;
  stop)
    compose down --timeout 120 --remove-orphans
    ;;
  verify-release)
    if "$docker_bin" inspect "$container" >/dev/null 2>&1; then
      echo "runtime container still exists: $container" >&2
      exit 1
    fi
    if [[ ${2} == head ]] && "$curl_bin" --silent --max-time 2 \
      http://127.0.0.1:8888/health >/dev/null 2>&1; then
      echo "head API still responds" >&2
      exit 1
    fi
    listening_ports=$("$ss_bin" -H -ltn)
    if grep -E '([.:])25000([[:space:]]|$)' <<<"$listening_ports" >/dev/null || \
       { [[ ${2} == head ]] && \
         grep -E '([.:])8888([[:space:]]|$)' <<<"$listening_ports" >/dev/null; }; then
      echo "runtime port is still listening" >&2
      exit 1
    fi
    verify_no_autostart "${2}"
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    lifecycle=$(lifecycle_root "$release_digest" "$current_boot")
    install -d -m 0750 "$lifecycle"
    baseline="$lifecycle/${2}.baseline.json"
    release_result="$lifecycle/${2}.release.json"
    wait_seconds=${MIA_RELEASE_WAIT_SECONDS:-120}
    poll_seconds=${MIA_RELEASE_POLL_SECONDS:-5}
    if [[ ! $wait_seconds =~ ^[0-9]+$ || ! $poll_seconds =~ ^[0-9]+$ ]]; then
      echo "invalid memory recovery timing" >&2
      exit 1
    fi
    started_at=$SECONDS
    while ! quality verify-memory \
      --baseline "$baseline" \
      --output "$release_result" \
      --meminfo "$meminfo_path" \
      --release-sha256 "$release_digest" \
      --boot-id-file "$boot_id_path" \
      --role "${2}" \
      --tolerance-bytes "$stop_memory_tolerance_bytes"; do
      if (( SECONDS - started_at >= wait_seconds )); then
        echo "memory did not recover within $stop_memory_tolerance_bytes bytes" >&2
        exit 1
      fi
      "$sleep_bin" "$poll_seconds"
    done
    printf 'released role=%s\n' "${2}"
    ;;
  *)
    echo "operation must be prepare, verify, start, health, infer, stop, verify-release, or render" >&2
    exit 2
    ;;
esac
