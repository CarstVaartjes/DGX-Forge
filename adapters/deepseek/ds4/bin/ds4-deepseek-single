#!/usr/bin/env bash
set -euo pipefail

adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
operation=${1:-}
docker_bin=${DS4_DOCKER_BIN:-docker}
curl_bin=${DS4_CURL_BIN:-curl}
df_bin=${DS4_DF_BIN:-df}
nvidia_smi_bin=${DS4_NVIDIA_SMI_BIN:-nvidia-smi}
systemctl_bin=${DS4_SYSTEMCTL_BIN:-systemctl}
ss_bin=${DS4_SS_BIN:-ss}
sleep_bin=${DS4_SLEEP_BIN:-sleep}
sha256sum_bin=${DS4_SHA256SUM_BIN:-sha256sum}
python_bin=${DS4_PYTHON_BIN:-python3}
models_root=${DS4_MODELS_ROOT:-/srv/models}
meminfo_path=${DS4_MEMINFO_PATH:-/proc/meminfo}
boot_id_path=${DS4_BOOT_ID_PATH:-/proc/sys/kernel/random/boot_id}

expected_hostname=node-3542
image_reference=ghcr.io/carstvaartjes/spark-ds4@sha256:084d9a9ffa47431842c5dec84de97b058034dec0535b2a563bc5db78c9e14615
checkpoint_manifest_sha256=1f6f88d7f968e51e76a118af83f0f7cae7f5df5b915a6cf30db5265228f70c99
minimum_free_memory_bytes=120000000000
minimum_free_disk_bytes=120000000000
stop_memory_tolerance_bytes=1073741824
container=ds4-deepseek-single
snapshot="$models_root/snapshots/deepseek-agent-single"
scratch="$models_root/runtime-cache/deepseek-agent-single"
output="$models_root/outputs/deepseek-agent-single"
logs="$models_root/logs/deepseek-agent-single"
manifest_source="$adapter_root/manifests/deepseek-v4-flash-0731-ds4.json"
installed_manifest="$scratch/checkpoint-manifest.json"
manifest_tool=${DS4_ARTIFACT_MANIFEST_TOOL:-$adapter_root/tools/artifact_manifest.py}

base_path=DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf
base_size=86720111488
base_sha256=ca22ae2f838e14077c22bc1c1417b71b45b5e5a3687bd96c2ac6e17fdb6261c0
base_url=https://huggingface.co/antirez/deepseek-v4-gguf/resolve/1cd7b564460821938add0475a60b942c409295e0/DeepSeek-V4-Flash-IQ2XXS-w2Q2K-AProjQ8-SExpQ8-OutQ8-chat-v2-imatrix-0731.gguf?download=true
drafter_path=DSpark-drafter-Q2K-Q8-0731.gguf
drafter_size=6971241504
drafter_sha256=8fa269560dc76fd73e4233ad9b1938b5f65dd363381fd9b1a5c6183f7d12d686
drafter_url=https://huggingface.co/bleysg/DeepSeek-V4-Flash-DSpark-drafter-GGUF/resolve/81c6fdd38f9582da45ba27f0ed7b63bcd3ea3b62/DSpark-drafter-Q2K-Q8-0731.gguf?download=true

if [[ $# != 1 || -z $operation ]]; then
  echo "adapter requires exactly one operation" >&2
  exit 2
fi

actual_hostname=${DS4_LOCAL_HOSTNAME:-$(hostname)}
if [[ $actual_hostname != "$expected_hostname" ]]; then
  echo "deepseek-agent-single requires node1/$expected_hostname; local host is $actual_hostname" >&2
  exit 2
fi

sha256_file() {
  "$sha256sum_bin" "$1" | awk '{print $1}'
}

available_memory_bytes() {
  awk '$1 == "MemAvailable:" {printf "%.0f\n", $2 * 1024; found=1} END {if (!found) exit 1}' \
    "$meminfo_path"
}

available_disk_bytes() {
  "$df_bin" -PB1 "$models_root" | awk 'NR == 2 {print $4}'
}

boot_id() {
  local value
  value=$(<"$boot_id_path")
  if [[ -z $value || $value == */* ]]; then
    echo "invalid boot ID" >&2
    return 1
  fi
  printf '%s\n' "$value"
}

runtime_release_digest() {
  local digest=${DS4_RELEASE_SHA256:-$(basename "$adapter_root")}
  if [[ ! $digest =~ ^[0-9a-f]{64}$ ]]; then
    echo "runtime release path is not digest-qualified" >&2
    return 1
  fi
  printf '%s\n' "$digest"
}

lifecycle_root() {
  printf '%s/lifecycle/%s/%s\n' "$scratch" "$1" "$2"
}

compose() {
  local DS4_MODELS_GID
  DS4_MODELS_GID=$(stat -c %g "$models_root")
  if [[ ! $DS4_MODELS_GID =~ ^[0-9]+$ ]]; then
    echo "invalid models directory group ID" >&2
    return 1
  fi
  DS4_IMAGE="$image_reference" \
  DS4_MODELS_GID="$DS4_MODELS_GID" \
  DS4_SNAPSHOT_DIR="$snapshot" \
  DS4_DERIVED_DIR="$scratch/derived" \
  DS4_KV_DIR="$scratch/kv" \
  DS4_LOG_DIR="$logs" \
    "$docker_bin" compose \
      --project-directory "$adapter_root" \
      --env-file "$adapter_root/config/runtime.env" \
      -f "$adapter_root/compose.yaml" "$@"
}

verify_no_autostart() {
  local unit=ds4-deepseek-single.service
  local state rc system_units user_units
  if state=$(LC_ALL=C "$systemctl_bin" is-enabled "$unit" 2>&1); then
    case $state in
      disabled|masked|static|indirect|generated|transient|not-found) ;;
      enabled|enabled-runtime|linked|linked-runtime|alias)
        echo "autostart unit is enabled: $unit" >&2
        return 1
        ;;
      *)
        echo "cannot classify autostart unit state: $unit: $state" >&2
        return 1
        ;;
    esac
  else
    rc=$?
    case "$rc:$state" in
      1:disabled|1:masked|4:not-found) ;;
      *)
        echo "systemd autostart inspection failed: $unit: $state" >&2
        return 1
        ;;
    esac
  fi
  if ! system_units=$(LC_ALL=C "$systemctl_bin" list-unit-files \
    --type=service --no-legend 2>&1); then
    echo "systemd system-unit enumeration failed: $system_units" >&2
    return 1
  fi
  if ! user_units=$(LC_ALL=C "$systemctl_bin" --user list-unit-files \
    --type=service --no-legend 2>&1); then
    echo "systemd user-unit enumeration failed: $user_units" >&2
    return 1
  fi
  if awk '
    tolower($1) ~ /(ds4-deepseek|deepseek-agent-single)/ &&
      $2 ~ /^(enabled|enabled-runtime|linked|linked-runtime|alias)$/ { found=1 }
    END { exit !found }
  ' <<<"$system_units" || awk '
    tolower($1) ~ /(ds4-deepseek|deepseek-agent-single)/ &&
      $2 ~ /^(enabled|enabled-runtime|linked|linked-runtime|alias)$/ { found=1 }
    END { exit !found }
  ' <<<"$user_units"; then
    echo "matching runtime autostart unit is enabled" >&2
    return 1
  fi
}

verify_container_no_copy_environment() {
  local container_environment
  container_environment=$(
    "$docker_bin" inspect --format '{{range .Config.Env}}{{println .}}{{end}}' \
      "$container"
  )
  if grep -E '^(DS4_CUDA_COPY_MODEL|DS4_CUDA_COPY_MODEL_CHUNKED|DS4_MODEL_ANON_HUGE)=' \
      <<<"$container_environment" >/dev/null; then
    echo "container enables a prohibited full-copy mode" >&2
    return 1
  fi
  if ! grep -Fx 'DS4_NO_UPDATE_CHECK=1' <<<"$container_environment" >/dev/null; then
    echo "container is missing the offline update-check guard" >&2
    return 1
  fi
}

verify_manifest_source() {
  if [[ ! -f $manifest_source || -L $manifest_source ]] || \
      [[ $(sha256_file "$manifest_source") != "$checkpoint_manifest_sha256" ]]; then
    echo "release checkpoint manifest digest mismatch" >&2
    return 1
  fi
}

verify_artifact() {
  local path=$1
  local size=$2
  local expected_sha256=$3
  local actual_size
  if [[ ! -f $path || -L $path ]]; then
    echo "artifact is missing or unsafe: $path" >&2
    return 1
  fi
  actual_size=$("$python_bin" -c 'import os,sys; print(os.stat(sys.argv[1], follow_symlinks=False).st_size)' "$path")
  if [[ $actual_size != "$size" ]]; then
    echo "artifact size mismatch preserved: $path" >&2
    return 1
  fi
  if [[ $(sha256_file "$path") != "$expected_sha256" ]]; then
    echo "artifact SHA-256 mismatch preserved: $path" >&2
    return 1
  fi
}

download_artifact() {
  local url=$1
  local name=$2
  local size=$3
  local expected_sha256=$4
  local final="$snapshot/$name"
  local partial="$final.partial"
  if [[ -e $final || -L $final ]]; then
    verify_artifact "$final" "$size" "$expected_sha256"
    return
  fi
  if [[ -L $partial || ( -e $partial && ! -f $partial ) ]]; then
    echo "partial artifact is unsafe: $partial" >&2
    return 1
  fi
  "$curl_bin" --fail --location --show-error --retry 5 \
    --continue-at - --output "$partial" "$url"
  verify_artifact "$partial" "$size" "$expected_sha256"
  if [[ -e $final || -L $final ]]; then
    echo "artifact appeared during preparation; preserving both paths: $final" >&2
    return 1
  fi
  mv -- "$partial" "$final"
}

record_memory_baseline() {
  local destination=$1
  local release=$2
  local current_boot=$3
  local available
  available=$(available_memory_bytes)
  "$python_bin" - "$destination" "$release" "$current_boot" "$available" <<'PY'
import json
import os
import sys

path, release, boot_id, available = sys.argv[1:]
payload = {
    "boot_id": boot_id,
    "mem_available_bytes": int(available),
    "release_sha256": release,
}
temporary = path + ".new"
with open(temporary, "w", encoding="utf-8") as target:
    json.dump(payload, target, indent=2, sort_keys=True)
    target.write("\n")
os.replace(temporary, path)
PY
}

case "$operation" in
  prepare)
    runtime_release_digest >/dev/null
    verify_manifest_source
    install -d -m 0750 "$snapshot" "$scratch" "$output" "$logs"
    if [[ -e $installed_manifest || -L $installed_manifest ]]; then
      if [[ ! -f $installed_manifest || -L $installed_manifest ]] || \
          ! cmp -s "$manifest_source" "$installed_manifest"; then
        echo "installed checkpoint manifest differs; preserving mismatch" >&2
        exit 1
      fi
    else
      install -m 0644 "$manifest_source" "$installed_manifest"
    fi
    if [[ ! -e $snapshot/$base_path || ! -e $snapshot/$drafter_path ]]; then
      disk_bytes=$(available_disk_bytes)
      if [[ ! $disk_bytes =~ ^[0-9]+$ || $disk_bytes -lt $minimum_free_disk_bytes ]]; then
        echo "preparation requires at least $minimum_free_disk_bytes free bytes" >&2
        exit 1
      fi
    fi
    download_artifact "$base_url" "$base_path" "$base_size" "$base_sha256" &
    base_pid=$!
    download_artifact "$drafter_url" "$drafter_path" "$drafter_size" "$drafter_sha256" &
    drafter_pid=$!
    prepare_status=0
    wait "$base_pid" || prepare_status=1
    wait "$drafter_pid" || prepare_status=1
    if [[ $prepare_status != 0 ]]; then
      exit "$prepare_status"
    fi
    "$python_bin" "$manifest_tool" verify \
      --manifest "$installed_manifest" --root "$snapshot" >/dev/null
    printf 'prepared node=node1\n'
    ;;
  verify)
    runtime_release_digest >/dev/null
    verify_manifest_source
    if [[ ! -f $installed_manifest || -L $installed_manifest ]] || \
        ! cmp -s "$manifest_source" "$installed_manifest"; then
      echo "installed checkpoint manifest mismatch" >&2
      exit 1
    fi
    "$python_bin" "$manifest_tool" verify \
      --manifest "$installed_manifest" --root "$snapshot" >/dev/null
    gpu_identity=$(
      "$nvidia_smi_bin" --query-gpu=name,compute_cap --format=csv,noheader
    )
    if [[ -z $gpu_identity ]] || grep -Ev 'GB10.*, *12\.1$' <<<"$gpu_identity" >/dev/null; then
      echo "GB10/SM121 architecture check failed" >&2
      exit 1
    fi
    memory_bytes=$(available_memory_bytes)
    if [[ ! $memory_bytes =~ ^[0-9]+$ || $memory_bytes -lt $minimum_free_memory_bytes ]]; then
      echo "insufficient free memory" >&2
      exit 1
    fi
    disk_bytes=$(available_disk_bytes)
    if [[ ! $disk_bytes =~ ^[0-9]+$ || $disk_bytes -lt $minimum_free_disk_bytes ]]; then
      echo "insufficient free disk" >&2
      exit 1
    fi
    inspected_image=$(
      "$docker_bin" image inspect --format \
        '{{range .RepoDigests}}{{println .}}{{end}}' "$image_reference"
    )
    if ! grep -Fx "$image_reference" <<<"$inspected_image" >/dev/null; then
      echo "runtime image digest mismatch" >&2
      exit 1
    fi
    conflicting_runtimes=$(
      "$docker_bin" ps --format '{{.Names}}' | \
        grep -E '(^ds4-deepseek-single$|mia-deepseek|vllm|ollama|litellm)' || true
    )
    if [[ -n $conflicting_runtimes ]]; then
      echo "conflicting runtime is active: $conflicting_runtimes" >&2
      exit 1
    fi
    verify_no_autostart
    printf 'verified node=node1\n'
    ;;
  start)
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    lifecycle=$(lifecycle_root "$release_digest" "$current_boot")
    install -d -m 0750 "$lifecycle" "$scratch/derived" "$scratch/kv" "$logs"
    record_memory_baseline "$lifecycle/baseline.json" "$release_digest" "$current_boot"
    compose up --detach --no-build --pull never --remove-orphans
    container_image=$("$docker_bin" inspect --format '{{.Config.Image}}' "$container")
    if [[ $container_image != "$image_reference" ]]; then
      echo "container image mismatch" >&2
      exit 1
    fi
    verify_container_no_copy_environment
    container_id=$("$docker_bin" inspect --format '{{.Id}}' "$container")
    startup_attempts=${DS4_STARTUP_ATTEMPTS:-180}
    if [[ ! $startup_attempts =~ ^[1-9][0-9]*$ ]]; then
      echo "invalid startup attempt count" >&2
      exit 1
    fi
    startup_log=
    for ((attempt = 1; attempt <= startup_attempts; attempt++)); do
      startup_log=$("$docker_bin" logs --tail 4000 "$container" 2>&1 || true)
      if grep -E 'CUDA copying .* model to device memory|CUDA chunk-copying .* model image|copied into anon huge-page memory' \
          <<<"$startup_log" >/dev/null; then
        echo "prohibited full-copy startup mode observed" >&2
        exit 1
      fi
      if grep -E 'CUDA registered .* model mapping for device access|mmap left unpinned; .* served from device artifacts' \
          <<<"$startup_log" >/dev/null; then
        break
      fi
      if [[ $attempt == "$startup_attempts" ]]; then
        echo "mapped/no-copy startup evidence not observed" >&2
        exit 1
      fi
      "$sleep_bin" 5
    done
    startup_record="$lifecycle/startup.$container_id.json"
    "$python_bin" - "$startup_record" "$current_boot" "$container_id" \
      "$image_reference" "$release_digest" <<'PY'
import json
import os
import sys

path, boot_id, container_id, image, release = sys.argv[1:]
payload = {
    "boot_id": boot_id,
    "container_id": container_id,
    "context": 32768,
    "image": image,
    "release_sha256": release,
    "served_model": "deepseek",
    "startup_mode": "mapped-no-copy",
}
temporary = path + ".new"
with open(temporary, "w", encoding="utf-8") as target:
    json.dump(payload, target, indent=2, sort_keys=True)
    target.write("\n")
os.replace(temporary, path)
PY
    ;;
  health)
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    running=$("$docker_bin" inspect --format '{{.State.Running}}' "$container")
    [[ $running == true ]]
    container_image=$("$docker_bin" inspect --format '{{.Config.Image}}' "$container")
    [[ $container_image == "$image_reference" ]]
    verify_container_no_copy_environment
    "$curl_bin" --fail --silent --show-error --max-time 10 \
      http://127.0.0.1:8888/health >/dev/null
    models_json=$(
      "$curl_bin" --fail --silent --show-error --max-time 10 \
        http://127.0.0.1:8888/v1/models
    )
    "$python_bin" -c '
import json, sys
payload = json.loads(sys.argv[1])
models = payload.get("data")
if not isinstance(models, list) or [item.get("id") for item in models] != ["deepseek"]:
    raise SystemExit("/v1/models must advertise exactly deepseek")
' "$models_json"
    container_id=$("$docker_bin" inspect --format '{{.Id}}' "$container")
    startup_record="$(lifecycle_root "$release_digest" "$current_boot")/startup.$container_id.json"
    "$python_bin" -c '
import json, sys
record = json.load(open(sys.argv[1], encoding="utf-8"))
expected = {
    "boot_id": sys.argv[2], "container_id": sys.argv[3], "context": 32768,
    "image": sys.argv[4], "release_sha256": sys.argv[5],
    "served_model": "deepseek", "startup_mode": "mapped-no-copy",
}
if record != expected:
    raise SystemExit("startup lifecycle record mismatch")
' "$startup_record" "$current_boot" "$container_id" "$image_reference" "$release_digest"
    printf 'healthy node=node1 model=deepseek\n'
    ;;
  infer)
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    evidence_dir="$output/quality/$release_digest/$current_boot"
    install -d -m 0750 "$evidence_dir"
    request() {
      local identifier=$1
      local payload=$2
      "$curl_bin" --fail --silent --show-error --max-time 300 \
        --header 'Content-Type: application/json' \
        --output "$evidence_dir/$identifier.json" \
        --data "$payload" http://127.0.0.1:8888/v1/chat/completions
    }
    request completion '{"model":"deepseek","messages":[{"role":"user","content":"Reply with the number 4."}],"max_tokens":32}'
    request reasoning_off '{"model":"deepseek","messages":[{"role":"user","content":"Reply with OFF_OK."}],"thinking":false,"max_tokens":32}'
    request reasoning_low '{"model":"deepseek","messages":[{"role":"user","content":"What is 2+2?"}],"reasoning_effort":"low","max_tokens":64}'
    request reasoning_high '{"model":"deepseek","messages":[{"role":"user","content":"What is 3+4?"}],"reasoning_effort":"high","max_tokens":128}'
    request reasoning_max '{"model":"deepseek","messages":[{"role":"user","content":"What is 5+6?"}],"reasoning_effort":"max","max_tokens":256}'
    request tool_call '{"model":"deepseek","messages":[{"role":"user","content":"What is the weather in Amsterdam? Use the tool."}],"tools":[{"type":"function","function":{"name":"get_weather","description":"Get weather for a city","parameters":{"type":"object","properties":{"city":{"type":"string"}},"required":["city"],"additionalProperties":false}}}],"tool_choice":{"type":"function","function":{"name":"get_weather"}},"max_tokens":128}'
    "$python_bin" - "$evidence_dir" <<'PY'
import json
import pathlib
import sys

root = pathlib.Path(sys.argv[1])

def response(name):
    payload = json.loads((root / f"{name}.json").read_text(encoding="utf-8"))
    if payload.get("model") != "deepseek":
        raise SystemExit(f"{name}: response model must be deepseek")
    choices = payload.get("choices")
    if not isinstance(choices, list) or len(choices) != 1:
        raise SystemExit(f"{name}: exactly one choice required")
    message = choices[0].get("message")
    if not isinstance(message, dict):
        raise SystemExit(f"{name}: message required")
    return choices[0], message

_, completion = response("completion")
if not str(completion.get("content", "")).strip():
    raise SystemExit("completion: content required")

_, off = response("reasoning_off")
if off.get("reasoning_content") or off.get("reasoning"):
    raise SystemExit("reasoning off leaked private reasoning")

for effort in ("low", "high", "max"):
    _, message = response(f"reasoning_{effort}")
    reasoning = message.get("reasoning_content") or message.get("reasoning")
    if not isinstance(reasoning, str) or not reasoning.strip():
        raise SystemExit(f"reasoning {effort} did not return reasoning")

choice, tool = response("tool_call")
calls = tool.get("tool_calls")
if choice.get("finish_reason") != "tool_calls" or not isinstance(calls, list) or len(calls) != 1:
    raise SystemExit("structured tool call required")
call = calls[0]
function = call.get("function", {})
if call.get("type") != "function" or function.get("name") != "get_weather":
    raise SystemExit("unexpected structured tool call")
arguments = json.loads(function.get("arguments", ""))
if arguments != {"city": "Amsterdam"}:
    raise SystemExit("tool arguments must name Amsterdam")
PY
    printf 'inference-verified node=node1 model=deepseek\n'
    ;;
  stop)
    compose down --timeout 120 --remove-orphans
    ;;
  verify-release)
    verify_no_autostart
    if "$docker_bin" inspect "$container" >/dev/null 2>&1; then
      echo "runtime container still exists: $container" >&2
      exit 1
    fi
    if "$curl_bin" --silent --max-time 2 http://127.0.0.1:8888/health \
        >/dev/null 2>&1; then
      echo "DS4 API still responds" >&2
      exit 1
    fi
    listening_ports=$("$ss_bin" -H -ltn)
    if grep -E '([.:])8888([[:space:]]|$)' <<<"$listening_ports" >/dev/null; then
      echo "DS4 API port is still listening" >&2
      exit 1
    fi
    release_digest=$(runtime_release_digest)
    current_boot=$(boot_id)
    lifecycle=$(lifecycle_root "$release_digest" "$current_boot")
    baseline="$lifecycle/baseline.json"
    [[ -f $baseline && ! -L $baseline ]]
    baseline_memory=$(
      "$python_bin" -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8"))["mem_available_bytes"])' "$baseline"
    )
    recovery_attempts=${DS4_RECOVERY_ATTEMPTS:-60}
    if [[ ! $recovery_attempts =~ ^[1-9][0-9]*$ ]]; then
      echo "invalid memory recovery attempt count" >&2
      exit 1
    fi
    recovered=false
    for ((attempt = 1; attempt <= recovery_attempts; attempt++)); do
      memory_bytes=$(available_memory_bytes)
      if (( memory_bytes + stop_memory_tolerance_bytes >= baseline_memory )); then
        recovered=true
        break
      fi
      "$sleep_bin" 5
    done
    if [[ $recovered != true ]]; then
      echo "memory did not recover within $stop_memory_tolerance_bytes bytes" >&2
      exit 1
    fi
    "$python_bin" - "$lifecycle/release.json" "$current_boot" \
      "$release_digest" "$baseline_memory" "$memory_bytes" <<'PY'
import json
import os
import sys

path, boot_id, release, baseline, recovered = sys.argv[1:]
payload = {
    "baseline_mem_available_bytes": int(baseline),
    "boot_id": boot_id,
    "recovered_mem_available_bytes": int(recovered),
    "release_sha256": release,
    "tolerance_bytes": 1073741824,
}
temporary = path + ".new"
with open(temporary, "w", encoding="utf-8") as target:
    json.dump(payload, target, indent=2, sort_keys=True)
    target.write("\n")
os.replace(temporary, path)
PY
    printf 'released node=node1\n'
    ;;
  *)
    echo "operation must be prepare, verify, start, health, infer, stop, or verify-release" >&2
    exit 2
    ;;
esac
