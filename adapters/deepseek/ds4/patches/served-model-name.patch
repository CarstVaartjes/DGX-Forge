diff --git a/ds4_server.c b/ds4_server.c
index 0f4834a..d0d9d5a 100644
--- a/ds4_server.c
+++ b/ds4_server.c
@@ -933,0 +934,17 @@
+static bool server_model_id_is_valid(const char *id) {
+    if (!id || !id[0]) return false;
+    for (const unsigned char *p = (const unsigned char *)id; *p; p++) {
+        if (iscntrl(*p)) return false;
+    }
+    return true;
+}
+
+static void server_validate_served_model_name(void) {
+    const char *id = getenv("DS4_SERVED_MODEL_NAME");
+    if (!id) return;
+    if (server_model_id_is_valid(id)) return;
+    fprintf(stderr,
+            "ds4-server: DS4_SERVED_MODEL_NAME must be non-empty and contain no control characters\n");
+    exit(2);
+}
+
@@ -934,0 +951,6 @@
+    const char *configured = getenv("DS4_SERVED_MODEL_NAME");
+    if (configured) {
+        server_validate_served_model_name();
+        return configured;
+    }
+
@@ -939,4 +964,2 @@
-static bool server_model_alias_known(const char *id) {
-    return id &&
-           (!strcmp(id, "deepseek-v4-flash") ||
-            !strcmp(id, "deepseek-v4-pro"));
+static bool server_model_alias_known(ds4_engine *engine, const char *id) {
+    return id && !strcmp(id, server_model_id_from_engine(engine));
