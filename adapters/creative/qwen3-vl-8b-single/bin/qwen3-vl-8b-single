#!/usr/bin/env bash
set -euo pipefail

operation=${1:-}
if [[ $# != 1 || -z "$operation" ]]; then
  echo "adapter requires exactly one operation" >&2
  exit 2
fi
case "$operation" in
  prepare|verify|start|health|infer|stop|verify-release) ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac

source_commit="96588727e44c78b25ba03ea03b8e12f7e64fd0da"
checkpoint_revision="0c351dd01ed87e9c1b53cbc748cba10e6187ff3b"
checkpoint_repo="Qwen/Qwen3-VL-8B-Instruct"
source_repo="https://github.com/QwenLM/Qwen3-VL.git"
model_name="Qwen/Qwen3-VL-8B-Instruct"
models_root=${QWEN3_MODELS_ROOT:-/srv/models}
source_root="$models_root/sources/qwen3-vl-8b-single/$source_commit"
weights_root="$models_root/snapshots/qwen3-vl-8b-single"
scratch_root="$models_root/runtime-cache/qwen3-vl-8b-single"
input_root="$models_root/inputs/qwen3-vl-8b-single"
output_root="$models_root/outputs/qwen3-vl-8b-single"
log_file="$models_root/logs/qwen3-vl-8b-single/server.log"
pid_file="$scratch_root/server.pid"
venv="$scratch_root/venv"
python_headers="$scratch_root/python-headers"
port=${QWEN3_PORT:-9106}
adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"

mkdir -p "$scratch_root" "$input_root" "$output_root" "$(dirname "$log_file")"

prepare() {
  mkdir -p "$(dirname "$source_root")"
  if [[ ! -d "$source_root/.git" ]]; then
    git clone --filter=blob:none "$source_repo" "$source_root"
  fi
  git -C "$source_root" fetch --depth 1 origin "$source_commit"
  git -C "$source_root" checkout --detach "$source_commit"
  if [[ ! -x "$venv/bin/python" ]]; then
    python3 -m venv "$venv"
    "$venv/bin/pip" install --upgrade pip
    "$venv/bin/pip" install \
      "torch==2.11.0" "torchvision==0.26.0" "torchaudio==2.11.0" \
      "vllm==0.22.0" "transformers==4.57.6" "qwen-vl-utils==0.0.14" \
      "huggingface-hub==0.36.0"
  fi
  if [[ ! -f "$python_headers/usr/include/python3.12/Python.h" ]]; then
    mkdir -p "$python_headers/debs"
    (
      cd "$python_headers/debs"
      apt-get download python3.12-dev libpython3.12-dev
      for package in ./*.deb; do dpkg-deb -x "$package" "$python_headers"; done
    )
  fi
  QWEN3_WEIGHTS_ROOT="$weights_root" QWEN3_CHECKPOINT_REVISION="$checkpoint_revision" \
    QWEN3_CHECKPOINT_REPO="$checkpoint_repo" "$venv/bin/python" - <<'PY'
import os
from huggingface_hub import snapshot_download

snapshot_download(
    repo_id=os.environ["QWEN3_CHECKPOINT_REPO"],
    revision=os.environ["QWEN3_CHECKPOINT_REVISION"],
    local_dir=os.environ["QWEN3_WEIGHTS_ROOT"],
    local_dir_use_symlinks=False,
)
PY
  printf '%s\n' "$source_commit" > "$scratch_root/source.commit"
  printf '%s\n' "$checkpoint_revision" > "$scratch_root/checkpoint.revision"
  "$venv/bin/python" -c 'import torch, vllm, transformers; print(torch.__version__, vllm.__version__, transformers.__version__)' > "$scratch_root/versions.txt"
}

verify() {
  [[ -s "$scratch_root/source.commit" && "$(<"$scratch_root/source.commit")" == "$source_commit" ]] || { echo "source commit marker mismatch" >&2; return 1; }
  [[ -s "$scratch_root/checkpoint.revision" && "$(<"$scratch_root/checkpoint.revision")" == "$checkpoint_revision" ]] || { echo "checkpoint revision marker mismatch" >&2; return 1; }
  [[ -x "$venv/bin/python" ]] || { echo "runtime venv missing" >&2; return 1; }
  [[ -f "$python_headers/usr/include/python3.12/Python.h" ]] || { echo "model-owned Python headers missing" >&2; return 1; }
  [[ -f "$weights_root/config.json" && -f "$weights_root/preprocessor_config.json" ]] || { echo "Qwen3-VL checkpoint files missing" >&2; return 1; }
  "$venv/bin/python" -c 'import torch, vllm, transformers; assert torch.__version__.startswith("2.11."); assert vllm.__version__ == "0.22.0"; assert tuple(map(int, transformers.__version__.split(".")[:2])) >= (4, 57)'
  echo "verified model=qwen3-vl-8b-instruct source=$source_commit checkpoint=$checkpoint_revision"
}

start() {
  verify
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "already running"
    return 0
  fi
  QWEN3_INPUT_ROOT="$input_root" QWEN3_OUTPUT_ROOT="$output_root" \
    CPATH="$python_headers/usr/include:$python_headers/usr/include/python3.12" \
    PATH="$venv/bin:$PATH" \
    nohup "$venv/bin/vllm" serve "$weights_root" \
      --served-model-name "$model_name" --host 127.0.0.1 --port "$port" \
      --dtype bfloat16 --max-model-len 8192 --gpu-memory-utilization 0.80 \
      --limit-mm-per-prompt '{"image":1}' \
      >"$log_file" 2>&1 &
  echo $! > "$pid_file"
}

health() {
  QWEN3_INPUT_ROOT="$input_root" QWEN3_OUTPUT_ROOT="$output_root" \
    "$venv/bin/python" "$adapter_root/server.py" health --base-url "http://127.0.0.1:$port" --model "$model_name"
}

infer() {
  QWEN3_INPUT_ROOT="$input_root" QWEN3_OUTPUT_ROOT="$output_root" \
    "$venv/bin/python" "$adapter_root/server.py" infer --base-url "http://127.0.0.1:$port" --model "$model_name"
}

stop() {
  if [[ -f "$pid_file" ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
    for _ in $(seq 1 120); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "Qwen3-VL server did not stop" >&2
      return 1
    fi
    rm -f "$pid_file"
  fi
  echo "stopped"
}

verify_release() {
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "Qwen3-VL server is still running" >&2
    return 1
  fi
  if curl --silent --max-time 2 "http://127.0.0.1:$port/v1/models" >/dev/null 2>&1; then
    echo "Qwen3-VL API port is still listening" >&2
    return 1
  fi
  echo "released model=qwen3-vl-8b-instruct"
}

case "$operation" in
  prepare) prepare ;;
  verify) verify ;;
  start) start ;;
  health) health ;;
  infer) infer ;;
  stop) stop ;;
  verify-release) verify_release ;;
esac
