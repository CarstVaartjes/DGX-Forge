#!/usr/bin/env bash
set -euo pipefail

operation=${1:?operation is required}
case "$operation" in
  prepare|verify) echo "$operation blocked: hunyuan3d-omni-single is planned and has no qualified release" >&2; exit 2 ;;
  start|health|infer|stop|verify-release) echo "$operation blocked: hunyuan3d-omni-single is not accepted" >&2; exit 3 ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac
