#!/usr/bin/env bash
set -euo pipefail

operation=${1:-}
if [[ $# != 1 || -z "$operation" ]]; then
  echo "adapter requires exactly one operation" >&2
  exit 2
fi
case "$operation" in
  prepare|verify|start|health|infer|stop|verify-release) ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac

release_sha256=${TOKENRIG_RELEASE_SHA256:-$(basename "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)")}
if [[ ! "$release_sha256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "runtime release path is not digest-qualified" >&2
  exit 2
fi

adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
source_commit="273b691d35989d71cd17ff2895fdc735097b92d1"
models_root=${TOKENRIG_MODELS_ROOT:-/srv/models}
source_root="$models_root/sources/tokenrig-single/$source_commit"
weights_root="$models_root/snapshots/tokenrig-single"
scratch_root="$models_root/runtime-cache/tokenrig-single"
input_root="$models_root/inputs/tokenrig-single"
output_root="$models_root/outputs/tokenrig-single"
log_file="$models_root/logs/tokenrig-single/server.log"
pid_file="$scratch_root/server.pid"
venv="$scratch_root/venv"
port=${TOKENRIG_PORT:-9107}

mkdir -p "$scratch_root" "$input_root" "$output_root" "$(dirname "$log_file")"

prepare() {
  mkdir -p "$(dirname "$source_root")"
  if [[ ! -d "$source_root/.git" ]]; then
    git clone https://github.com/VAST-AI-Research/SkinTokens.git "$source_root"
  fi
  git -C "$source_root" fetch --depth 1 origin "$source_commit"
  git -C "$source_root" checkout --detach "$source_commit"
  command -v blender >/dev/null 2>&1 || {
    echo "official TokenRig runtime requires Blender >=4.2 on this host" >&2
    return 1
  }
  [[ "$(blender --version | awk 'NR == 1 {print $2}')" =~ ^4\.[2-9] ]] || {
    echo "Blender version is below the official TokenRig requirement" >&2
    return 1
  }
  if [[ ! -x "$venv/bin/python" ]]; then
    python3 -m venv "$venv"
    "$venv/bin/pip" install --upgrade pip
    "$venv/bin/pip" install torch torchvision --index-url https://download.pytorch.org/whl/cu130
  fi
  "$venv/bin/pip" install -r "$source_root/requirements.txt"
  "$venv/bin/pip" install flash-attn --no-build-isolation
  "$venv/bin/python" "$source_root/download.py" --model
  printf '%s\n' "$source_commit" > "$scratch_root/source.commit"
  printf '%s\n' "$release_sha256" > "$scratch_root/release.sha256"
}

verify() {
  [[ -s "$scratch_root/source.commit" ]] || { echo "source marker missing" >&2; return 1; }
  [[ "$(<"$scratch_root/source.commit")" == "$source_commit" ]] || { echo "source commit mismatch" >&2; return 1; }
  [[ -x "$venv/bin/python" ]] || { echo "runtime venv missing" >&2; return 1; }
  [[ -f "$source_root/demo.py" && -f "$source_root/bpy_server.py" ]] || { echo "official runtime missing" >&2; return 1; }
  [[ -f "$weights_root/experiments/articulation_xl_quantization_256_token_4/grpo_1400.ckpt" ]] || { echo "TokenRig checkpoint missing" >&2; return 1; }
  [[ -f "$weights_root/experiments/skin_vae_2_10_32768/last.ckpt" ]] || { echo "SkinTokens checkpoint missing" >&2; return 1; }
  command -v blender >/dev/null 2>&1 || { echo "Blender >=4.2 missing" >&2; return 1; }
  echo "verified model=tokenrig source=$source_commit"
}

start() {
  verify
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "already running"
    return 0
  fi
  TOKENRIG_SOURCE_ROOT="$source_root" \
  TOKENRIG_WEIGHTS_ROOT="$weights_root" \
  TOKENRIG_INPUT_ROOT="$input_root" \
  TOKENRIG_OUTPUT_ROOT="$output_root" \
  TOKENRIG_PORT="$port" \
  TOKENRIG_BLENDER_BIN="$(command -v blender)" \
  PYTHONPATH="$adapter_root${PYTHONPATH:+:$PYTHONPATH}" \
    nohup "$venv/bin/python" "$adapter_root/server.py" >"$log_file" 2>&1 &
  echo $! > "$pid_file"
}

health() {
  curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:$port/health"
  curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:$port/v1/models" >/dev/null
  echo
}

infer() {
  curl --fail --silent --show-error --max-time 1800 \
    -H 'content-type: application/json' --data-binary @- \
    "http://127.0.0.1:$port/v1/rig"
  echo
}

stop() {
  if [[ -f "$pid_file" ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
    for _ in $(seq 1 60); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "TokenRig server did not stop" >&2
      return 1
    fi
    printf '' > "$pid_file"
    # Keep the path as a marker only after the process has exited.
    rm -f "$pid_file"
  fi
  echo "stopped"
}

verify_release() {
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "TokenRig server is still running" >&2
    exit 1
  fi
  if curl --silent --max-time 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
    echo "TokenRig API port is still listening" >&2
    exit 1
  fi
  echo "released model=tokenrig"
}

case "$operation" in
  prepare) prepare ;;
  verify) verify ;;
  start) start ;;
  health) health ;;
  infer) infer ;;
  stop) stop ;;
  verify-release) verify_release ;;
esac
