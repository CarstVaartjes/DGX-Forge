#!/usr/bin/env bash
set -euo pipefail

operation=${1:-}
if [[ $# != 1 || -z "$operation" ]]; then
  echo "adapter requires exactly one operation" >&2
  exit 2
fi
case "$operation" in
  prepare|verify|start|health|infer|stop|verify-release) ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac

source_commit="c2a21efe6059130c3c7379df9e6428b2cc97b597"
checkpoint_revision="ce1b118ae66ec705d02c241525192832eb045fd3"
checkpoint_repo="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4"
source_repo="https://github.com/NVIDIA-NeMo/Nemotron.git"
model_name="nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4"
models_root=${NEMOTRON_NANO_MODELS_ROOT:-/srv/models}
source_root="$models_root/sources/nemotron-nano-omni-single/$source_commit"
weights_root="$models_root/snapshots/nemotron-nano-omni-single"
scratch_root="$models_root/runtime-cache/nemotron-nano-omni-single"
output_root="$models_root/outputs/nemotron-nano-omni-single"
log_file="$models_root/logs/nemotron-nano-omni-single/server.log"
pid_file="$scratch_root/server.pid"
venv="$scratch_root/venv"
python_headers="$scratch_root/python-headers"
port=${NEMOTRON_NANO_PORT:-9101}
adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"

mkdir -p "$scratch_root" "$output_root" "$(dirname "$log_file")"

prepare() {
  mkdir -p "$(dirname "$source_root")"
  if [[ ! -d "$source_root/.git" ]]; then
    git clone --filter=blob:none "$source_repo" "$source_root"
  fi
  git -C "$source_root" fetch --depth 1 origin "$source_commit"
  git -C "$source_root" checkout --detach "$source_commit"
  if [[ ! -x "$venv/bin/python" ]]; then
    python3 -m venv "$venv"
    "$venv/bin/pip" install --upgrade pip
    "$venv/bin/pip" install \
      "torch==2.11.0" "torchvision==0.26.0" "torchaudio==2.11.0" \
      "vllm==0.22.0" "transformers==4.57.6" "huggingface-hub==0.36.0"
  fi
  if [[ ! -f "$python_headers/usr/include/python3.12/Python.h" ]]; then
    mkdir -p "$python_headers/debs"
    (
      cd "$python_headers/debs"
      apt-get download python3.12-dev libpython3.12-dev
      for package in ./*.deb; do dpkg-deb -x "$package" "$python_headers"; done
    )
  fi
  NEMOTRON_NANO_WEIGHTS_ROOT="$weights_root" NEMOTRON_NANO_CHECKPOINT_REVISION="$checkpoint_revision" \
    NEMOTRON_NANO_CHECKPOINT_REPO="$checkpoint_repo" "$venv/bin/python" - <<'PY'
import os
from huggingface_hub import snapshot_download

snapshot_download(
    repo_id=os.environ["NEMOTRON_NANO_CHECKPOINT_REPO"],
    revision=os.environ["NEMOTRON_NANO_CHECKPOINT_REVISION"],
    local_dir=os.environ["NEMOTRON_NANO_WEIGHTS_ROOT"],
    local_dir_use_symlinks=False,
)
PY
  printf '%s\n' "$source_commit" > "$scratch_root/source.commit"
  printf '%s\n' "$checkpoint_revision" > "$scratch_root/checkpoint.revision"
  "$venv/bin/python" -c 'import torch, vllm, transformers; print(torch.__version__, vllm.__version__, transformers.__version__)' > "$scratch_root/versions.txt"
}

verify() {
  [[ -s "$scratch_root/source.commit" && "$(<"$scratch_root/source.commit")" == "$source_commit" ]] || { echo "source commit marker mismatch" >&2; return 1; }
  [[ -s "$scratch_root/checkpoint.revision" && "$(<"$scratch_root/checkpoint.revision")" == "$checkpoint_revision" ]] || { echo "checkpoint revision marker mismatch" >&2; return 1; }
  [[ -x "$venv/bin/python" ]] || { echo "runtime venv missing" >&2; return 1; }
  [[ -f "$python_headers/usr/include/python3.12/Python.h" ]] || { echo "model-owned Python headers missing" >&2; return 1; }
  [[ -f "$weights_root/config.json" && -f "$weights_root/nano_v3_reasoning_parser.py" ]] || { echo "Nemotron Nano checkpoint files missing" >&2; return 1; }
  "$venv/bin/python" -c 'import torch, vllm, transformers; assert torch.__version__.startswith("2.11."); assert vllm.__version__ == "0.22.0"; assert tuple(map(int, transformers.__version__.split(".")[:2])) >= (4, 57)'
  echo "verified model=nemotron-nano-omni source=$source_commit checkpoint=$checkpoint_revision"
}

start() {
  verify
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then echo "already running"; return 0; fi
  CPATH="$python_headers/usr/include:$python_headers/usr/include/python3.12" \
  PATH="$venv/bin:$PATH" \
  VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 \
  VLLM_USE_FLASHINFER_MOE_FP4=1 \
  VLLM_FLASHINFER_MOE_BACKEND=throughput \
    nohup "$venv/bin/vllm" serve "$weights_root" \
      --served-model-name "$model_name" --host 127.0.0.1 --port "$port" \
      --max-num-seqs 8 --tensor-parallel-size 1 --max-model-len 32768 \
      --trust-remote-code --enable-auto-tool-choice --tool-call-parser qwen3_coder \
      --reasoning-parser-plugin "$weights_root/nano_v3_reasoning_parser.py" \
      --reasoning-parser nano_v3 --kv-cache-dtype fp8 --gpu-memory-utilization 0.80 \
      >"$log_file" 2>&1 &
  echo $! > "$pid_file"
}

health() {
  NEMOTRON_NANO_OUTPUT_ROOT="$output_root" "$venv/bin/python" "$adapter_root/server.py" health --base-url "http://127.0.0.1:$port" --model "$model_name"
}

infer() {
  NEMOTRON_NANO_OUTPUT_ROOT="$output_root" "$venv/bin/python" "$adapter_root/server.py" infer --base-url "http://127.0.0.1:$port" --model "$model_name"
}

stop() {
  if [[ -f "$pid_file" ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
    for _ in $(seq 1 120); do kill -0 "$pid" 2>/dev/null || break; sleep 1; done
    if kill -0 "$pid" 2>/dev/null; then echo "Nemotron Nano server did not stop" >&2; return 1; fi
    rm -f "$pid_file"
  fi
  echo "stopped"
}

verify_release() {
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then echo "Nemotron Nano server is still running" >&2; return 1; fi
  if curl --silent --max-time 2 "http://127.0.0.1:$port/v1/models" >/dev/null 2>&1; then echo "Nemotron Nano API port is still listening" >&2; return 1; fi
  echo "released model=nemotron-nano-omni"
}

case "$operation" in
  prepare) prepare ;;
  verify) verify ;;
  start) start ;;
  health) health ;;
  infer) infer ;;
  stop) stop ;;
  verify-release) verify_release ;;
esac
