#!/usr/bin/env bash
set -euo pipefail

operation=${1:-}
if [[ $# != 1 || -z $operation ]]; then
  echo "adapter requires exactly one operation" >&2
  exit 2
fi
case "$operation" in
  prepare|verify|start|health|infer|stop|verify-release) ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac

release_sha256=${TRIPOSG_RELEASE_SHA256:-$(basename "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)")}
if [[ ! $release_sha256 =~ ^[0-9a-f]{64}$ ]]; then
  echo "runtime release path is not digest-qualified" >&2
  exit 2
fi

adapter_root="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)"
source_commit="fc5c40990181e2a756c4e0b1c2f4d6b5202faf8c"
models_root=${TRIPOSG_MODELS_ROOT:-/srv/models}
source_root="$models_root/sources/triposg/$source_commit"
weights_root="$models_root/snapshots/triposg"
scratch_root="$models_root/runtime-cache/triposg"
output_root="$models_root/outputs/triposg"
input_root="$models_root/inputs/triposg"
venv="$scratch_root/venv"
pid_file="$scratch_root/server.pid"
log_file="$models_root/logs/triposg/server.log"
port=${TRIPOSG_PORT:-9109}

mkdir -p "$scratch_root" "$output_root" "$input_root" "$(dirname "$log_file")"

run_python() { "$venv/bin/python" "$@"; }

prepare() {
  mkdir -p "$(dirname "$source_root")"
  if [[ ! -d "$source_root/.git" ]]; then
    git clone https://github.com/VAST-AI-Research/TripoSG.git "$source_root"
  fi
  git -C "$source_root" fetch --depth 1 origin "$source_commit"
  git -C "$source_root" checkout --detach "$source_commit"
  if [[ ! -x "$venv/bin/python" ]]; then
    python3 -m venv "$venv"
    "$venv/bin/pip" install --upgrade pip
    "$venv/bin/pip" install torch torchvision --index-url https://download.pytorch.org/whl/cu130
  fi
  grep -v -E '^(numpy==1.22.3|diso)$' "$source_root/requirements.txt" > "$scratch_root/requirements.txt"
  "$venv/bin/pip" install -r "$scratch_root/requirements.txt"
  "$venv/bin/pip" install "numpy==2.2.6"
  if ! "$venv/bin/python" -c 'import diso' >/dev/null 2>&1; then
    python_minor="$($venv/bin/python -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")')"
    python_dev_root="$scratch_root/python-dev"
    python_header="$python_dev_root/usr/include/python${python_minor}/Python.h"
    if [[ ! -f "$python_header" ]]; then
      mkdir -p "$python_dev_root"
      (
        cd "$scratch_root"
        apt-get download "libpython${python_minor}-dev" >/dev/null
        dev_deb=$(find . -maxdepth 1 -name "libpython${python_minor}-dev_*.deb" -print -quit)
        [[ -n "$dev_deb" ]] || { echo "Python development headers unavailable" >&2; exit 1; }
        dpkg-deb -x "$dev_deb" "$python_dev_root"
      )
    fi
    CFLAGS="-I$python_dev_root/usr/include -I$python_dev_root/usr/include/python${python_minor}" \
    CXXFLAGS="-I$python_dev_root/usr/include -I$python_dev_root/usr/include/python${python_minor}" \
      "$venv/bin/pip" install --no-build-isolation diso
  fi
  run_python - <<'PY'
from huggingface_hub import snapshot_download
snapshot_download(repo_id="VAST-AI/TripoSG", local_dir="/srv/models/snapshots/triposg/TripoSG")
snapshot_download(repo_id="briaai/RMBG-1.4", local_dir="/srv/models/snapshots/triposg/RMBG-1.4")
PY
  printf '%s\n' "$source_commit" > "$scratch_root/source.commit"
  printf '%s\n' "$release_sha256" > "$scratch_root/release.sha256"
}

verify() {
  [[ -s "$scratch_root/source.commit" ]] || { echo "source marker missing" >&2; return 1; }
  [[ $(<"$scratch_root/source.commit") == "$source_commit" ]] || { echo "source commit mismatch" >&2; return 1; }
  [[ -x "$venv/bin/python" ]] || { echo "runtime venv missing" >&2; return 1; }
  [[ -f "$weights_root/TripoSG/model_index.json" ]] || { echo "TripoSG weights missing" >&2; return 1; }
  [[ -f "$weights_root/RMBG-1.4/config.json" ]] || { echo "RMBG weights missing" >&2; return 1; }
  [[ -f "$adapter_root/server.py" && -f "$adapter_root/runtime.py" ]] || { echo "adapter release incomplete" >&2; return 1; }
  echo "verified model=triposg source=$source_commit"
}

start() {
  verify
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "already running"
    return 0
  fi
  TRIPOSG_SOURCE_ROOT="$source_root" \
  TRIPOSG_WEIGHTS_ROOT="$weights_root" \
  TRIPOSG_INPUT_ROOT="$input_root" \
  TRIPOSG_OUTPUT_ROOT="$output_root" \
  TRIPOSG_PORT="$port" \
  PYTHONPATH="$adapter_root${PYTHONPATH:+:$PYTHONPATH}" \
    nohup "$venv/bin/python" "$adapter_root/server.py" >"$log_file" 2>&1 &
  echo $! > "$pid_file"
}

health() {
  curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:$port/health"
  curl --fail --silent --show-error --max-time 10 "http://127.0.0.1:$port/v1/models" >/dev/null
  echo
}

infer() {
  curl --fail --silent --show-error --max-time 1800 \
    -H 'content-type: application/json' --data-binary @- \
    "http://127.0.0.1:$port/v1/generate"
  echo
}

stop() {
  if [[ -f "$pid_file" ]]; then
    pid=$(<"$pid_file")
    if kill -0 "$pid" 2>/dev/null; then kill "$pid"; fi
    for _ in $(seq 1 60); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 1
    done
    if kill -0 "$pid" 2>/dev/null; then
      echo "TripoSG server did not stop" >&2
      return 1
    fi
    rm -f "$pid_file"
  fi
  echo "stopped"
}

verify_release() {
  if [[ -f "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    echo "TripoSG server is still running" >&2
    exit 1
  fi
  if curl --silent --max-time 2 "http://127.0.0.1:$port/health" >/dev/null 2>&1; then
    echo "TripoSG API port is still listening" >&2
    exit 1
  fi
  echo "released model=triposg"
}

case "$operation" in
  prepare) prepare ;;
  verify) verify ;;
  start) start ;;
  health) health ;;
  infer) infer ;;
  stop) stop ;;
  verify-release) verify_release ;;
  *) echo "unknown operation: $operation" >&2; exit 64 ;;
esac
