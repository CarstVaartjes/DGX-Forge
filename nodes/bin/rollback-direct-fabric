#!/usr/bin/env bash
set -euo pipefail

configurer="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/configure-direct-fabric"

usage() {
    printf '%s\n' 'Usage: rollback-direct-fabric [--configurer PATH]'
}

while (($#)); do
    case "$1" in
        --configurer)
            (($# >= 2)) || { usage >&2; exit 2; }
            configurer="$2"
            shift 2
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
done

[[ -f "$configurer" ]] || { printf 'FAIL: reviewed fabric configurator is absent: %s\n' "$configurer" >&2; exit 1; }
script_sha256="$(shasum -a 256 "$configurer" | awk '{print $1}')"
[[ -n "$script_sha256" ]] || { printf '%s\n' 'FAIL: cannot calculate configurator checksum' >&2; exit 1; }

stage_and_verify() {
    local host="$1"
    local remote_checksum
    scp -o ForwardAgent=no "$configurer" "$host:/tmp/configure-direct-fabric"
    remote_checksum="$(ssh -o BatchMode=yes -o ForwardAgent=no "$host" 'sha256sum /tmp/configure-direct-fabric')"
    [[ "${remote_checksum%% *}" == "$script_sha256" ]] || {
        printf 'FAIL: staged configurator checksum mismatch on %s\n' "$host" >&2
        exit 1
    }
    printf 'PASS: rollback preflight passed on %s\n' "$host"
}

rollback_and_verify_management() {
    local host="$1"
    local node="$2"
    ssh -t -o BatchMode=yes -o ForwardAgent=no "$host" \
        "sudo bash /tmp/configure-direct-fabric --node $node --rollback"
    ssh -o BatchMode=yes -o ForwardAgent=no "$host" 'hostname && ip -4 route show default | grep -q " dev "'
    printf 'PASS: management reconnection verified on %s\n' "$host"
}

# GPU node 2 is a hard gate. With errexit and pipefail, a transfer, checksum,
# rollback, or management-reconnect failure exits before GPU node 1 is staged.
stage_and_verify vonk-node-2
rollback_and_verify_management vonk-node-2 node2
stage_and_verify vonk-node-1
rollback_and_verify_management vonk-node-1 node1

printf '%s\n' 'PASS: direct fabric rollback completed worker-first'
