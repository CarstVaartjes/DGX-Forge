#!/usr/bin/env bash
set -euo pipefail

cuda_image='nvcr.io/nvidia/cuda:13.0.1-devel-ubuntu24.04'

docker run --rm --gpus=all "$cuda_image" nvidia-smi

if ! kernel_log="$(journalctl -k -b --no-pager)"; then
    printf 'FAIL: could not read the current boot kernel log\n' >&2
    exit 1
fi

if grep -Eai \
    'I/O error|nvme.*(abort|reset|timeout)|EXT4-fs error|XFS.*corrupt|BTRFS.*error' \
    <<<"$kernel_log"
then
    printf 'FAIL: storage or filesystem error in current boot\n' >&2
    exit 1
fi

printf 'PASS: GPU container and current-boot storage checks passed\n'
