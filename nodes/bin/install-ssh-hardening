#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf '%s\n' \
        "Usage: $0 --admin-user USER --admin-key-fingerprint SHA256:..." \
        '       --drop-in FILE [--recovery-marker FILE]' \
        '       --check|--apply|--verify|--rollback' >&2
    exit 64
}

admin_user=''
admin_key_fingerprint=''
drop_in=''
recovery_marker=''
action=''
while (( $# > 0 )); do
    case "$1" in
        --admin-user|--admin-key-fingerprint|--drop-in|--recovery-marker)
            (( $# >= 2 )) || usage
            case "$1" in
                --admin-user) admin_user="$2" ;;
                --admin-key-fingerprint) admin_key_fingerprint="$2" ;;
                --drop-in) drop_in="$2" ;;
                --recovery-marker) recovery_marker="$2" ;;
            esac
            shift 2
            ;;
        --check|--apply|--verify|--rollback)
            [[ -z "$action" ]] || usage
            action="$1"
            shift
            ;;
        *) usage ;;
    esac
done

[[ -n "$admin_user" && -n "$admin_key_fingerprint" && -n "$drop_in" && -n "$action" ]] || usage
[[ "$admin_user" =~ ^[a-z_][a-z0-9_-]*\$?$ ]] || {
    printf '%s\n' 'ERROR: admin user has unsafe syntax' >&2
    exit 64
}
[[ "$admin_key_fingerprint" == SHA256:* && "$admin_key_fingerprint" != *[[:space:]]* ]] || {
    printf '%s\n' 'ERROR: admin key fingerprint must use SHA256 format' >&2
    exit 64
}
[[ -f "$drop_in" && ! -L "$drop_in" ]] || {
    printf '%s\n' 'ERROR: drop-in must be a regular non-symlink file' >&2
    exit 64
}

target_dir="${VONK_SSHD_CONFIG_DIR:-/etc/ssh/sshd_config.d}"
target="$target_dir/90-vonk-admin.conf"
sshd_bin="${VONK_SSHD_BIN:-/usr/sbin/sshd}"
systemctl_bin="${VONK_SYSTEMCTL_BIN:-systemctl}"
getent_bin="${VONK_GETENT_BIN:-getent}"
ssh_keygen_bin="${VONK_SSH_KEYGEN_BIN:-ssh-keygen}"

require_mutation_authority() {
    if [[ "$target_dir" == /etc/ssh/sshd_config.d && "$EUID" -ne 0 ]]; then
        printf '%s\n' 'ERROR: apply and rollback require root' >&2
        exit 1
    fi
    [[ -n "$recovery_marker" && -f "$recovery_marker" && ! -L "$recovery_marker" ]] || {
        printf '%s\n' 'ERROR: a regular recovery marker is required' >&2
        exit 64
    }
    [[ "$(cat "$recovery_marker")" == recovery-channel-verified ]] || {
        printf '%s\n' 'ERROR: recovery channel is not verified' >&2
        exit 64
    }
    marker_mode="$(stat -c '%a' "$recovery_marker")"
    case "$marker_mode" in 400|600) ;; *)
        printf '%s\n' 'ERROR: recovery marker permissions must be 0400 or 0600' >&2
        exit 64
        ;;
    esac
}

admin_home="$($getent_bin passwd "$admin_user" 2>/dev/null | awk -F: 'NR == 1 {print $6}')"
[[ -n "$admin_home" ]] || {
    printf 'ERROR: admin user %s does not exist\n' "$admin_user" >&2
    exit 1
}
authorized_keys="$admin_home/.ssh/authorized_keys"
if [[ ! -f "$authorized_keys" || -L "$authorized_keys" ]] ||
    ! "$ssh_keygen_bin" -lf "$authorized_keys" 2>/dev/null |
        awk '{print $2}' | grep -Fxq "$admin_key_fingerprint"; then
    printf 'ERROR: expected public key is not authorized for %s\n' "$admin_user" >&2
    exit 1
fi

drop_in_sha256="$(sha256sum "$drop_in" | awk '{print $1}')"
emit_result() {
    local status="$1"
    jq -cn \
        --arg status "$status" \
        --arg admin_user "$admin_user" \
        --arg drop_in_sha256 "$drop_in_sha256" \
        '{schema_version:1,status:$status,admin_user:$admin_user,drop_in_sha256:$drop_in_sha256}'
}

target_state() {
    if [[ ! -e "$target" ]]; then
        printf '%s\n' absent
    elif [[ -f "$target" && ! -L "$target" ]] && cmp -s "$drop_in" "$target"; then
        printf '%s\n' managed
    else
        printf '%s\n' foreign
    fi
}

verify_effective() {
    [[ "$(stat -c '%a' "$target")" == 644 ]]
    "$sshd_bin" -t
    effective_config="$($sshd_bin -T)"
    effective_value() {
        local option="$1"
        awk -v option="$option" '$1 == option {print $2; exit}' <<<"$effective_config"
    }
    [[ "$(effective_value passwordauthentication)" == no ]]
    [[ "$(effective_value kbdinteractiveauthentication)" == no ]]
    [[ "$(effective_value pubkeyauthentication)" == yes ]]
    case "$(effective_value permitrootlogin)" in
        prohibit-password|without-password) ;;
        *) return 1 ;;
    esac
    [[ "$($systemctl_bin is-active ssh)" == active ]]
}

state="$(target_state)"
case "$action" in
    --check)
        case "$state" in
            absent) emit_result change-required; exit 2 ;;
            managed)
                if verify_effective; then emit_result unchanged; exit 0; fi
                emit_result noncompliant
                exit 3
                ;;
            foreign)
                printf 'ERROR: refusing foreign SSH path %s\n' "$target" >&2
                exit 3
                ;;
        esac
        ;;
    --verify)
        if [[ "$state" != managed ]] || ! verify_effective; then
            emit_result noncompliant
            exit 3
        fi
        emit_result verified
        ;;
    --apply)
        require_mutation_authority
        case "$state" in
            foreign)
                printf 'ERROR: refusing foreign SSH path %s\n' "$target" >&2
                exit 3
                ;;
            managed)
                if verify_effective; then emit_result unchanged; exit 0; fi
                emit_result noncompliant
                exit 3
                ;;
        esac
        install -d -m 0755 "$target_dir"
        stage="$(mktemp "$target_dir/.90-vonk-admin.conf.XXXXXX")"
        cleanup() { rm -f -- "$stage"; }
        rollback_on_error() {
            local result=$?
            trap - ERR
            rm -f -- "$target"
            "$sshd_bin" -t || true
            cleanup
            exit "$result"
        }
        trap cleanup EXIT
        trap rollback_on_error ERR
        install -m 0644 "$drop_in" "$stage"
        install -m 0644 "$stage" "$target"
        "$sshd_bin" -t
        "$systemctl_bin" reload ssh
        verify_effective
        trap - ERR
        cleanup
        trap - EXIT
        emit_result changed
        ;;
    --rollback)
        require_mutation_authority
        case "$state" in
            foreign)
                printf 'ERROR: refusing foreign SSH path %s\n' "$target" >&2
                exit 3
                ;;
            absent) emit_result unchanged; exit 0 ;;
        esac
        rm -f -- "$target"
        if ! "$sshd_bin" -t; then
            install -m 0644 "$drop_in" "$target"
            printf '%s\n' 'ERROR: rollback made SSH configuration invalid; managed file restored' >&2
            exit 3
        fi
        "$systemctl_bin" reload ssh
        [[ "$($systemctl_bin is-active ssh)" == active ]]
        emit_result rolled-back
        ;;
esac
