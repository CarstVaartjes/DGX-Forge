#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
    printf 'Usage: %s\n' "$0" >&2
    exit 2
fi

json_command() {
    local output

    if ! command -v "$1" >/dev/null 2>&1; then
        printf 'null\n'
        return
    fi

    if ! output="$("$@" 2>/dev/null)" || ! jq -e . >/dev/null 2>&1 <<<"$output"; then
        printf 'null\n'
        return
    fi

    jq -c . <<<"$output"
}

text_command() {
    local output

    if ! command -v "$1" >/dev/null 2>&1 || ! output="$("$@" 2>/dev/null)"; then
        printf 'null\n'
        return
    fi

    jq -Rn --arg value "$output" '$value'
}

memory_snapshot='null'
if [[ -r /proc/meminfo ]]; then
    memory_snapshot="$({
        awk '
            /^(MemTotal|MemAvailable|SwapTotal|SwapFree):/ {
                key = substr($1, 1, length($1) - 1)
                printf "%s %s\n", key, $2 * 1024
            }
        ' /proc/meminfo
    } | jq -Rn '[inputs | split(" ") | {key: .[0], value: (.[1] | tonumber)}] | from_entries')"
fi

if [[ "$memory_snapshot" == 'null' ]]; then
    memory='null'
    swap='null'
else
    memory="$(jq -c '{total_bytes: .MemTotal, available_bytes: .MemAvailable}' <<<"$memory_snapshot")"
    swap="$(jq -c '{total_bytes: .SwapTotal, free_bytes: .SwapFree}' <<<"$memory_snapshot")"
fi

if command -v lsblk >/dev/null 2>&1; then
    disks="$(json_command lsblk -J -b | jq -c 'if . == null then [] else .blockdevices // [] end')"
else
    disks='[]'
fi

if command -v df >/dev/null 2>&1; then
    filesystems="$({
        df -B1 2>/dev/null || true
    } | awk '
        NR > 1 && NF >= 6 {
            print $1 "\t" $2 "\t" $3 "\t" $4 "\t" $5 "\t" $6
        }
    ' | jq -Rn '
        [inputs | split("\t") |
            {
                filesystem: .[0],
                size_bytes: (.[1] | tonumber),
                used_bytes: (.[2] | tonumber),
                available_bytes: (.[3] | tonumber),
                use_percent: .[4],
                mountpoint: .[5]
            }
        ]')"
else
    filesystems='[]'
fi

if command -v systemctl >/dev/null 2>&1; then
    earlyoom="$(jq -n \
        --arg enabled "$(systemctl is-enabled earlyoom 2>&1 || true)" \
        --arg active "$(systemctl is-active earlyoom 2>&1 || true)" \
        '{enabled: $enabled, active: $active}')"
else
    earlyoom='null'
fi

nvidia='null'
thermal='null'
if command -v nvidia-smi >/dev/null 2>&1; then
    if nvidia_raw="$(nvidia-smi --query-gpu=index,name,driver_version,memory.total,memory.used --format=csv,noheader,nounits 2>/dev/null)" \
        && nvidia_parsed="$(jq -Rn '
            [inputs | split(", ") |
                {
                    index: (.[0] | tonumber),
                    name: .[1],
                    driver_version: .[2],
                    memory_total_mib: (.[3] | tonumber),
                    memory_used_mib: (.[4] | tonumber)
                }
            ]' <<<"$nvidia_raw")"
    then
        nvidia="$nvidia_parsed"
    fi

    if thermal_raw="$(nvidia-smi --query-gpu=index,temperature.gpu --format=csv,noheader,nounits 2>/dev/null)" \
        && thermal_parsed="$(jq -Rn '
            [inputs | split(", ") |
                {index: (.[0] | tonumber), temperature_c: (.[1] | tonumber)}
            ]' <<<"$thermal_raw")"
    then
        thermal="$thermal_parsed"
    fi
fi

docker_engine="$(json_command docker version --format '{{json .}}')"
docker_compose="$(json_command docker compose version --format json)"
if [[ "$docker_engine" == 'null' && "$docker_compose" == 'null' ]]; then
    docker='null'
else
    docker="$(jq -n --argjson engine "$docker_engine" --argjson compose "$docker_compose" \
        '{engine: $engine, compose: $compose}')"
fi

if command -v ip >/dev/null 2>&1; then
    interfaces="$(json_command ip -j address | jq -c 'if . == null then [] else . end')"
else
    interfaces='[]'
fi

rdma_links="$(json_command rdma -j)"
rdma_ibstat="$(text_command ibstat)"
if [[ "$rdma_links" == 'null' && "$rdma_ibstat" == 'null' ]]; then
    rdma='null'
else
    rdma="$(jq -n --argjson links "$rdma_links" --argjson ibstat "$rdma_ibstat" \
        '{links: $links, ibstat: $ibstat}')"
fi

os='null'
if [[ -r /etc/os-release ]]; then
    os="$(jq -Rn '
        [inputs |
            select(test("^[A-Za-z_][A-Za-z0-9_]*=")) |
            capture("^(?<key>[A-Za-z_][A-Za-z0-9_]*)=(?<value>.*)$") |
            {key: .key, value: (.value | if startswith("\"") then fromjson else . end)}
        ] | from_entries
    ' </etc/os-release)"
fi

kernel='null'
if kernel_raw="$(uname -srmo 2>/dev/null)"; then
    kernel="$(jq -n --arg uname "$kernel_raw" '{uname: $uname}')"
fi

jq -n \
    --arg hostname "$(hostname)" \
    --arg boot_id "$(cat /proc/sys/kernel/random/boot_id 2>/dev/null || true)" \
    --argjson os "$os" \
    --argjson kernel "$kernel" \
    --argjson memory "$memory" \
    --argjson swap "$swap" \
    --argjson disks "$disks" \
    --argjson filesystems "$filesystems" \
    --argjson earlyoom "$earlyoom" \
    --argjson nvidia "$nvidia" \
    --argjson docker "$docker" \
    --argjson interfaces "$interfaces" \
    --argjson rdma "$rdma" \
    --argjson thermal "$thermal" \
    '{
        hostname: $hostname,
        boot_id: $boot_id,
        os: $os,
        kernel: $kernel,
        memory: $memory,
        swap: $swap,
        disks: $disks,
        filesystems: $filesystems,
        earlyoom: $earlyoom,
        nvidia: $nvidia,
        docker: $docker,
        interfaces: $interfaces,
        rdma: $rdma,
        thermal: $thermal
    }'
