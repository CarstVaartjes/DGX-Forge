#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
    printf 'Usage: %s\n' "$0" >&2
    exit 2
fi

serial_path="${DGX_IDENTITY_SERIAL_PATH:-/sys/class/dmi/id/product_serial}"
machine_id_path="${DGX_IDENTITY_MACHINE_ID_PATH:-/etc/machine-id}"

if [[ ! -r "$serial_path" || ! -r "$machine_id_path" ]]; then
    printf '%s\n' 'required node identity source is unreadable' >&2
    exit 1
fi
command -v jq >/dev/null 2>&1 || {
    printf '%s\n' 'jq is required for identity inspection' >&2
    exit 1
}
command -v sshd >/dev/null 2>&1 || {
    printf '%s\n' 'sshd is required for identity inspection' >&2
    exit 1
}
command -v ssh-keygen >/dev/null 2>&1 || {
    printf '%s\n' 'ssh-keygen is required for identity inspection' >&2
    exit 1
}

serial="$(tr -d '\r\n' < "$serial_path")"
machine_id="$(tr -d '\r\n' < "$machine_id_path")"
[[ -n "$serial" ]] || {
    printf '%s\n' 'product serial is empty' >&2
    exit 1
}

serial_sha256="$(printf '%s' "$serial" | sha256sum | awk '{print $1}')"
machine_id_sha256="$(printf '%s' "$machine_id" | sha256sum | awk '{print $1}')"
requires_console_repair=false
if [[ ! "$machine_id" =~ ^[0-9a-f]{32}$ ]]; then
    requires_console_repair=true
fi

mapfile -t configured_keys < <(
    sshd -T 2>/dev/null | awk 'tolower($1) == "hostkey" {print $2}'
)
fingerprints=()
if (( ${#configured_keys[@]} == 0 )); then
    requires_console_repair=true
fi
for private_key in "${configured_keys[@]}"; do
    public_key="${private_key}.pub"
    if [[ ! -r "$public_key" ]]; then
        requires_console_repair=true
        continue
    fi
    fingerprint="$(ssh-keygen -lf "$public_key" 2>/dev/null | awk 'NR == 1 {print $2}')"
    if [[ "$fingerprint" != SHA256:* ]]; then
        requires_console_repair=true
        continue
    fi
    fingerprints+=("$fingerprint")
done
if (( ${#fingerprints[@]} == 0 )); then
    printf '%s\n' 'no readable configured public host keys' >&2
    exit 1
fi

fingerprints_json="$(printf '%s\n' "${fingerprints[@]}" | jq -Rsc 'split("\n") | map(select(length > 0))')"
jq -n \
    --arg product_serial_sha256 "$serial_sha256" \
    --arg machine_id_sha256 "$machine_id_sha256" \
    --argjson host_key_fingerprints "$fingerprints_json" \
    --argjson requires_console_repair "$requires_console_repair" \
    '{
        schema_version: 1,
        product_serial_sha256: $product_serial_sha256,
        machine_id_sha256: $machine_id_sha256,
        host_key_fingerprints: $host_key_fingerprints,
        requires_console_repair: $requires_console_repair
    }'
