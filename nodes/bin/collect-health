#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C

readonly MAX_OUTPUT_BYTES=262144
readonly MAX_COMMAND_BYTES=8192
readonly MAX_FABRIC_FUNCTIONS=16
readonly MAX_THERMAL_ZONES=64
readonly MAX_TRIP_POINTS=32

readonly RDMA_ERROR_COUNTERS=(
    out_of_buffer
    out_of_sequence
    duplicate_request
    rnr_nak_retry_err
    packet_seq_err
    implied_nak_seq_err
    local_ack_timeout_err
    resp_local_length_error
    resp_cqe_error
    req_cqe_error
    req_remote_invalid_request
    req_remote_access_errors
    resp_remote_access_errors
    resp_cqe_flush_error
    req_cqe_flush_error
    req_transport_retries_exceeded
    req_rnr_retries_exceeded
    roce_adp_retrans
    roce_adp_retrans_to
)

usage() {
    printf 'Usage: %s --json --cpu-sample-ms <milliseconds> --interface <name> --hca <name> [...]\n' "$0" >&2
}

bounded_command() {
    local limit="$1"
    shift
    "$@" 2>/dev/null | head -c "$limit" || true
}

read_string() {
    local path="$1" limit="${2:-256}" value=''
    if [[ -r "$path" ]]; then
        IFS= read -r value <"$path" || true
        printf '%s' "${value:0:limit}"
    fi
}

read_integer_json() {
    local value
    value="$(read_string "$1" 64)"
    if [[ "$value" =~ ^-?[0-9]+$ ]]; then
        printf '%s' "$value"
    else
        printf 'null'
    fi
}

valid_device_name() {
    [[ ${#1} -ge 1 && ${#1} -le 64 && "$1" =~ ^[A-Za-z0-9_.:-]+$ ]]
}

valid_cpu_sample_ms() {
    [[ "$1" =~ ^([1-9][0-9]{0,3}|10000)$ ]]
}

parse_function_arguments() {
    COLLECT_INTERFACES=()
    COLLECT_HCAS=()
    local interface hca existing_index

    while (( $# > 0 )); do
        [[ "$1" == '--interface' && $# -ge 4 && "$3" == '--hca' ]] || return 2
        interface="$2"
        hca="$4"
        valid_device_name "$interface" && valid_device_name "$hca" || return 2
        (( ${#COLLECT_INTERFACES[@]} < MAX_FABRIC_FUNCTIONS )) || return 2

        for (( existing_index=0; existing_index<${#COLLECT_INTERFACES[@]}; existing_index++ )); do
            [[ "${COLLECT_INTERFACES[$existing_index]}" != "$interface" ]] || return 2
        done
        for (( existing_index=0; existing_index<${#COLLECT_HCAS[@]}; existing_index++ )); do
            [[ "${COLLECT_HCAS[$existing_index]}" != "$hca" ]] || return 2
        done

        COLLECT_INTERFACES+=("$interface")
        COLLECT_HCAS+=("$hca")
        shift 4
    done

    (( ${#COLLECT_INTERFACES[@]} > 0 )) || return 2
}

collect_cpu() {
    local proc_root="$1" sample_ms="$2" first='' second='' logical=0 loads=''
    if [[ -r "$proc_root/stat" ]]; then
        first="$(awk '/^cpu[[:space:]]/ {$1=""; sub(/^ +/, ""); print; exit}' "$proc_root/stat")"
        logical="$(awk '/^cpu[0-9]+[[:space:]]/ {count++} END {print count + 0}' "$proc_root/stat")"
        sleep "$(awk -v milliseconds="$sample_ms" 'BEGIN {printf "%.3f", milliseconds / 1000}')"
        second="$(awk '/^cpu[[:space:]]/ {$1=""; sub(/^ +/, ""); print; exit}' "$proc_root/stat")"
    fi
    if [[ -r "$proc_root/loadavg" ]]; then
        IFS= read -r loads <"$proc_root/loadavg" || true
    fi

    jq -cn \
        --arg first "$first" \
        --arg second "$second" \
        --argjson logical "$logical" \
        --arg loads "$loads" '
        def row:
            split(" ") | map(select(length > 0) | tonumber);
        def total:
            .[0:8] | add;
        def optional_number:
            if . == null or . == "" then null else try tonumber catch null end;
        ($loads | split(" ")) as $load |
        (if ($first == "" or $second == "") then null else
            ($first | row) as $a |
            ($second | row) as $b |
            (($b | total) - ($a | total)) as $total_delta |
            (($b[3] + ($b[4] // 0)) - ($a[3] + ($a[4] // 0))) as $idle_delta |
            if $total_delta > 0 then (((($total_delta - $idle_delta) * 1000 / $total_delta) | round) / 10)
            else null end
        end) as $utilization |
        {
            logical_processors: $logical,
            utilization_percent: $utilization,
            load_1: ($load[0] | optional_number),
            load_5: ($load[1] | optional_number),
            load_15: ($load[2] | optional_number)
        }'
}

collect_memory_and_swap() {
    local proc_root="$1" snapshot='{}'
    if [[ -r "$proc_root/meminfo" ]]; then
        snapshot="$(awk '
            /^(MemTotal|MemAvailable|SwapTotal|SwapFree):/ {
                key = substr($1, 1, length($1) - 1)
                printf "%s %s\n", key, $2 * 1024
            }
        ' "$proc_root/meminfo" | jq -Rn '[inputs | split(" ") | {key: .[0], value: (.[1] | tonumber)}] | from_entries')"
    fi

    jq -cn --argjson values "$snapshot" '
        def percent($used; $total):
            if ($used | type) != "number" or ($total | type) != "number" then null
            elif $total == 0 then 0
            else ((($used * 1000 / $total) | round) / 10) end;
        (if (($values.MemTotal | type) == "number" and ($values.MemAvailable | type) == "number")
            then $values.MemTotal - $values.MemAvailable else null end) as $memory_used |
        (if (($values.SwapTotal | type) == "number" and ($values.SwapFree | type) == "number")
            then $values.SwapTotal - $values.SwapFree else null end) as $swap_used |
        {
            memory: {
                total_bytes: ($values.MemTotal // null),
                available_bytes: ($values.MemAvailable // null),
                used_bytes: $memory_used,
                used_percent: percent($memory_used; ($values.MemTotal // null))
            },
            swap: {
                total_bytes: ($values.SwapTotal // null),
                free_bytes: ($values.SwapFree // null),
                used_bytes: $swap_used,
                used_percent: percent($swap_used; ($values.SwapTotal // null))
            }
        }'
}

collect_root_filesystem() {
    local raw=''
    if command -v findmnt >/dev/null 2>&1; then
        raw="$(bounded_command "$MAX_COMMAND_BYTES" findmnt --bytes --noheadings \
            --output SIZE,AVAIL,USED,USE%,OPTIONS --target /)"
    fi
    raw="${raw%%$'\n'*}"

    jq -cn --arg raw "$raw" '
        def optional_integer:
            if test("^[0-9]+$") then tonumber else null end;
        ($raw | split(" ") | map(select(length > 0))) as $fields |
        ($fields[0] // "" | optional_integer) as $total |
        ($fields[1] // "" | optional_integer) as $available |
        ($fields[2] // "" | optional_integer) as $used |
        {
            total_bytes: $total,
            available_bytes: $available,
            used_bytes: $used,
            used_percent: (
                if (($used | type) == "number" and ($total | type) == "number" and $total > 0)
                then ((($used * 1000 / $total) | round) / 10) else null end
            ),
            read_only: (
                if ($fields | length) < 5 then null
                else (($fields[4] | split(",")) | index("ro")) != null end
            )
        }'
}

collect_accelerator() {
    local raw=''
    if command -v nvidia-smi >/dev/null 2>&1; then
        raw="$(bounded_command "$MAX_COMMAND_BYTES" nvidia-smi \
            --query-gpu=name,driver_version,utilization.gpu,temperature.gpu,pstate,power.draw \
            --format=csv,noheader,nounits)"
    fi
    raw="${raw%%$'\n'*}"

    jq -cn --arg raw "$raw" '
        def trim: gsub("^[[:space:]]+|[[:space:]]+$"; "");
        def optional_number:
            trim | if . == "" or . == "N/A" or . == "[N/A]" then null else try tonumber catch null end;
        ($raw | split(",") | map(trim)) as $fields |
        {
            available: ($raw != ""),
            name: (if $raw == "" then null else (($fields[0] // "")[0:256]) end),
            driver_version: (if $raw == "" then null else (($fields[1] // "")[0:64]) end),
            utilization_percent: (if $raw == "" then null else ($fields[2] // "" | optional_number) end),
            temperature_c: (if $raw == "" then null else ($fields[3] // "" | optional_number) end),
            performance_state: (if $raw == "" then null else (($fields[4] // "")[0:32]) end),
            power_watts: (if $raw == "" then null else ($fields[5] // "" | optional_number) end)
        }'
}

collect_thermal_zones() {
    local sys_root="$1" zones='[]' zone_index zone_dir zone_type temperature_milli
    local temperature_c trips trip_index trip_type trip_temperature_milli trip_temperature_c reached trip
    for (( zone_index=0; zone_index<MAX_THERMAL_ZONES; zone_index++ )); do
        zone_dir="$sys_root/class/thermal/thermal_zone$zone_index"
        [[ -d "$zone_dir" ]] || continue
        zone_type="$(read_string "$zone_dir/type" 256)"
        temperature_milli="$(read_string "$zone_dir/temp" 64)"
        [[ -n "$zone_type" && "$temperature_milli" =~ ^-?[0-9]+$ ]] || continue
        temperature_c="$(awk -v value="$temperature_milli" 'BEGIN {printf "%.1f", value / 1000}')"
        trips='[]'

        for (( trip_index=0; trip_index<MAX_TRIP_POINTS; trip_index++ )); do
            trip_type="$(read_string "$zone_dir/trip_point_${trip_index}_type" 64)"
            trip_temperature_milli="$(read_string "$zone_dir/trip_point_${trip_index}_temp" 64)"
            [[ -n "$trip_type" && "$trip_temperature_milli" =~ ^[0-9]+$ ]] || continue
            (( trip_temperature_milli > 0 )) || continue
            trip_temperature_c="$(awk -v value="$trip_temperature_milli" 'BEGIN {printf "%.1f", value / 1000}')"
            if (( temperature_milli >= trip_temperature_milli )); then reached=true; else reached=false; fi
            trip="$(jq -cn --arg type "$trip_type" --argjson temperature "$trip_temperature_c" \
                --argjson reached "$reached" '{type: $type, temperature_c: $temperature, reached: $reached}')"
            trips="$(jq -c --argjson item "$trip" '. + [$item]' <<<"$trips")"
        done

        local zone
        zone="$(jq -cn \
            --arg zone "thermal_zone$zone_index" \
            --arg type "$zone_type" \
            --argjson temperature "$temperature_c" \
            --argjson trips "$trips" \
            '{zone: $zone, type: $type, temperature_c: $temperature, trip_points: $trips}')"
        zones="$(jq -c --argjson item "$zone" '. + [$item]' <<<"$zones")"
    done
    printf '%s\n' "$zones"
}

counter_value() {
    local raw="$1" hca="$2" counter="$3" value
    value="$(awk -v target="$hca/1" -v key="$counter" '
        $1 == "link" && $2 == target {
            for (field_index = 3; field_index < NF; field_index += 2) {
                if ($field_index == key) {print $(field_index + 1); exit}
            }
        }
    ' <<<"$raw")"
    if [[ "$value" =~ ^[0-9]+$ ]]; then printf '%s' "$value"; else printf 'null'; fi
}

collect_fabric() {
    local sys_root="$1" rdma_links='[]' rdma_statistics='' functions='[]'
    local index interface hca net_root operstate carrier speed mtu rdma_interface rdma_state counters counter value item
    if command -v rdma >/dev/null 2>&1; then
        rdma_links="$(bounded_command 32768 rdma -j link show)"
        jq -e 'type == "array"' >/dev/null 2>&1 <<<"$rdma_links" || rdma_links='[]'
        rdma_statistics="$(bounded_command 65536 rdma statistic show)"
    fi

    for (( index=0; index<${#COLLECT_INTERFACES[@]}; index++ )); do
        interface="${COLLECT_INTERFACES[$index]}"
        hca="${COLLECT_HCAS[$index]}"
        net_root="$sys_root/class/net/$interface"
        operstate="$(read_string "$net_root/operstate" 32)"
        carrier="$(read_integer_json "$net_root/carrier")"
        speed="$(read_integer_json "$net_root/speed")"
        mtu="$(read_integer_json "$net_root/mtu")"
        rdma_interface="$(jq -r --arg hca "$hca" \
            '[.[] | select(.ifname == $hca and (.port == 1 or .port == "1"))][0].netdev // empty' \
            <<<"$rdma_links")"
        rdma_state="$(jq -r --arg hca "$hca" \
            '[.[] | select(.ifname == $hca and (.port == 1 or .port == "1"))][0].state // empty' \
            <<<"$rdma_links")"
        counters='{}'
        for counter in "${RDMA_ERROR_COUNTERS[@]}"; do
            value="$(counter_value "$rdma_statistics" "$hca" "$counter")"
            counters="$(jq -c --arg name "$counter" --argjson value "$value" '. + {($name): $value}' <<<"$counters")"
        done
        item="$(jq -cn \
            --arg interface "$interface" \
            --arg hca "$hca" \
            --arg operstate "$operstate" \
            --argjson carrier "$carrier" \
            --argjson speed "$speed" \
            --argjson mtu "$mtu" \
            --arg rdma_interface "$rdma_interface" \
            --arg rdma_state "$rdma_state" \
            --argjson counters "$counters" '
            {
                interface: $interface,
                hca: $hca,
                operstate: (if $operstate == "" then null else $operstate end),
                carrier: $carrier,
                speed_mbps: $speed,
                mtu: $mtu,
                rdma_interface: (if $rdma_interface == "" then null else $rdma_interface end),
                rdma_state: (if $rdma_state == "" then null else $rdma_state end),
                counters: $counters
            }')"
        functions="$(jq -c --argjson item "$item" '. + [$item]' <<<"$functions")"
    done
    jq -cn --argjson functions "$functions" '{functions: $functions}'
}

collect_services() {
    local docker_version='' load_state='' enabled='' active=''
    local docker_available=false earlyoom_enabled=null earlyoom_active=null
    if command -v docker >/dev/null 2>&1; then
        docker_version="$(bounded_command 256 docker version --format '{{.Server.Version}}')"
        docker_version="${docker_version%%$'\n'*}"
        [[ -z "$docker_version" ]] || docker_available=true
    fi
    if command -v systemctl >/dev/null 2>&1; then
        load_state="$(bounded_command 256 systemctl show earlyoom --property=LoadState --value)"
        enabled="$(bounded_command 256 systemctl is-enabled earlyoom)"
        active="$(bounded_command 256 systemctl is-active earlyoom)"
        load_state="${load_state%%$'\n'*}"
        enabled="${enabled%%$'\n'*}"
        active="${active%%$'\n'*}"
        case "$enabled" in
            enabled|enabled-runtime) earlyoom_enabled=true ;;
            disabled|masked|masked-runtime|static|indirect|generated|transient|not-found)
                earlyoom_enabled=false
                ;;
        esac
        case "$active" in
            active) earlyoom_active=true ;;
            inactive|failed|not-found) earlyoom_active=false ;;
        esac
    fi

    jq -cn \
        --argjson docker_available "$docker_available" \
        --arg docker_version "$docker_version" \
        --arg load_state "$load_state" \
        --argjson earlyoom_enabled "$earlyoom_enabled" \
        --argjson earlyoom_active "$earlyoom_active" '
        {
            docker_available: $docker_available,
            docker_version: (if $docker_version == "" then null else $docker_version end),
            earlyoom_load_state: (if $load_state == "" then null else $load_state end),
            earlyoom_enabled: $earlyoom_enabled,
            earlyoom_active: $earlyoom_active
        }'
}

collect_health() {
    (( $# >= 7 )) || return 2
    local proc_root="$1" sys_root="$2" sample_ms="$3"
    shift 3
    valid_cpu_sample_ms "$sample_ms" || return 2
    parse_function_arguments "$@" || return 2

    local captured_at hostname boot_id uptime cpu memory_swap root accelerator thermal fabric services document
    captured_at="$(bounded_command 64 date -u +%Y-%m-%dT%H:%M:%SZ)"
    captured_at="${captured_at%%$'\n'*}"
    hostname="$(bounded_command 256 hostname)"
    hostname="${hostname%%$'\n'*}"
    boot_id="$(read_string "$proc_root/sys/kernel/random/boot_id" 128)"
    uptime="$(read_string "$proc_root/uptime" 128)"
    uptime="${uptime%% *}"
    if [[ "$uptime" =~ ^[0-9]+([.][0-9]+)?$ ]]; then uptime="${uptime%%.*}"; else uptime=null; fi

    cpu="$(collect_cpu "$proc_root" "$sample_ms")"
    memory_swap="$(collect_memory_and_swap "$proc_root")"
    root="$(collect_root_filesystem)"
    accelerator="$(collect_accelerator)"
    thermal="$(collect_thermal_zones "$sys_root")"
    fabric="$(collect_fabric "$sys_root")"
    services="$(collect_services)"

    document="$(jq -cn \
        --arg captured_at "$captured_at" \
        --arg hostname "$hostname" \
        --arg boot_id "$boot_id" \
        --argjson uptime "$uptime" \
        --argjson cpu "$cpu" \
        --argjson memory_swap "$memory_swap" \
        --argjson root "$root" \
        --argjson accelerator "$accelerator" \
        --argjson thermal "$thermal" \
        --argjson fabric "$fabric" \
        --argjson services "$services" '
        {
            schema_version: 1,
            captured_at: $captured_at,
            identity: {
                hostname: $hostname,
                boot_id: (if $boot_id == "" then null else $boot_id end),
                uptime_seconds: $uptime
            },
            cpu: $cpu,
            memory: $memory_swap.memory,
            swap: $memory_swap.swap,
            root_filesystem: $root,
            accelerator: $accelerator,
            thermal_zones: $thermal,
            fabric: $fabric,
            services: $services
        }')"
    (( ${#document} <= MAX_OUTPUT_BYTES )) || return 1
    printf '%s\n' "$document"
}

main() {
    local json_seen=0 sample_ms='' sample_seen=0
    local -a function_arguments=()
    while (( $# > 0 )); do
        case "$1" in
            --json)
                (( json_seen == 0 )) || { usage; return 2; }
                json_seen=1
                shift
                ;;
            --cpu-sample-ms)
                (( sample_seen == 0 && $# >= 2 )) || { usage; return 2; }
                sample_seen=1
                sample_ms="$2"
                shift 2
                ;;
            --interface)
                (( $# >= 4 )) && [[ "$3" == '--hca' ]] || { usage; return 2; }
                function_arguments+=("$1" "$2" "$3" "$4")
                shift 4
                ;;
            *)
                usage
                return 2
                ;;
        esac
    done

    (( json_seen == 1 && sample_seen == 1 )) || { usage; return 2; }
    if ! valid_cpu_sample_ms "$sample_ms"; then
        usage
        return 2
    fi
    (( ${#function_arguments[@]} > 0 )) || { usage; return 2; }
    parse_function_arguments "${function_arguments[@]}" || { usage; return 2; }
    collect_health /proc /sys "$sample_ms" "${function_arguments[@]}"
}

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]:-}" == "$0" ]]; then
    main "$@"
fi
