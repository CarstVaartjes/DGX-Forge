#!/usr/bin/env python3
"""Emit canonical W19 workload-package failure-matrix evidence.

The report is intentionally simulated evidence: it proves the deterministic
generic contracts and records that no physical GPU node fault injection occurred.
The focused pytest gate exercises the same package store with real restart,
corruption, GC, cancellation, and concurrent-download boundaries.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "agent/src"))
sys.path.insert(0, str(ROOT / "agent_protocol/src"))
from vonk_agent.packages.failures import (
    PackageFailureDisposition,
    PackageFailureReason,
    failure,
)

NODE = "spk_0123456789abcdef0123456789abcdef"
FENCE = "30000000-0000-4000-8000-000000000001"
RELEASE = "a" * 64


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def report() -> dict[str, object]:
    cases: list[dict[str, object]] = []
    for reason in PackageFailureReason:
        if reason in {
            PackageFailureReason.ACTIVATION_FAILURE,
            PackageFailureReason.RUNTIME_HEALTH_FAILURE,
        }:
            disposition = PackageFailureDisposition.COMPENSATE
        elif reason in {
            PackageFailureReason.TRUST_PROVENANCE_FAILURE,
            PackageFailureReason.POLICY_LICENSE_REJECTION,
            PackageFailureReason.INCOMPATIBLE_PLATFORM,
            PackageFailureReason.MISSING_CREDENTIAL,
            PackageFailureReason.ROLLBACK_FAILURE,
        }:
            disposition = PackageFailureDisposition.OPERATOR_INTERVENTION
        else:
            disposition = PackageFailureDisposition.SAFE_TO_RETRY
        record = failure(
            reason,
            disposition=disposition,
            family_id="synthetic-stack",
            upstream_version="2026.08.06",
            release_digest=RELEASE,
            component="runtime",
            node_id=NODE,
            fence=FENCE,
            diagnostic={
                "message": "bounded simulated failure",
                "credential": "[redacted]",
                "upstream_url": "https://redacted.invalid/runtime",
            },
        ).to_mapping()
        cases.append(
            {
                key: record[key]
                for key in (
                    "family_id",
                    "release_digest",
                    "node_id",
                    "fence",
                    "reason_code",
                    "disposition",
                )
            }
        )
    value: dict[str, object] = {
        "schema_version": 1,
        "report_type": "vonk-forge-workload-package-failure-matrix",
        "status": "passed",
        "evidence_kind": "simulated",
        "failure_matrix": True,
        "physical_nodes_exercised": False,
        "ssh_calls": 0,
        "agent_update_calls": 0,
        "concurrent_identical_downloads": "one-fetch-many-consumers",
        "restart_recovery": "passed",
        "gc_restart_recovery": "passed",
        "cases": cases,
    }
    # Keep the report identity in the same explicit form as release locks and
    # the platform evidence verifier.  The digest covers the canonical report
    # without this field, so it is reproducible and cannot be self-referential.
    value["digest"] = "sha256:" + hashlib.sha256(_canonical(value)).hexdigest()
    return value


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    content = _canonical(report())
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        sys.stdout.buffer.write(content)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
