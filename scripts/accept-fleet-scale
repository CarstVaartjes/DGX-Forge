#!/usr/bin/env python3
"""Emit deterministic scale and failure-injection acceptance evidence."""

from __future__ import annotations

import argparse
import dataclasses
import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if os.environ.get("DGX_ACCEPTANCE_LOCKED_ENV") != "1":
    environment = dict(os.environ)
    environment["DGX_ACCEPTANCE_LOCKED_ENV"] = "1"
    raise SystemExit(subprocess.run(["uv", "run", "--project", str(ROOT / "control"), "python", __file__, *sys.argv[1:]], env=environment, check=False).returncode)
sys.path.insert(0, str(ROOT / "control/src"))
from dgx_control.acceptance import simulate  # noqa: E402

COUNTS = (1, 2, 16, 64)
FAULTS = ("postgres", "worker", "caddy", "litellm", "git", "ssh", "host")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    scale = [dataclasses.asdict(simulate(count)) for count in COUNTS]
    failures = [dataclasses.asdict(simulate(2, fault)) for fault in FAULTS]
    ok = all(item["planned_nodes"] == item["nodes"] and item["duplicate_mutations"] == 0 and item["route_state"] == "published" for item in scale)
    ok = ok and all(item["terminal_job_state"] == "failed" and item["route_state"] == "maintenance" for item in failures)
    report = {"schema_version": 1, "environment": "deterministic-simulator", "node_counts": list(COUNTS), "faults": list(FAULTS), "scale": scale, "failure_injection": failures, "status": "passed" if ok else "failed", "physical_fault_injection_exercised": False}
    content = (json.dumps(report, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        print(content.decode(), end="")
    return 0 if ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
