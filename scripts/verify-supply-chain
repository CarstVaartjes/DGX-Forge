#!/usr/bin/env python3
"""Generate or offline-verify dependency SBOM and image-lock evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
import tomllib
from pathlib import Path

IMAGE = re.compile(r"^[^\s@]+(?::[^\s@]+)?@sha256:[0-9a-f]{64}$")


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def packages_python(lock: bytes) -> list[tuple[str, str]]:
    raw = tomllib.loads(lock.decode())
    return sorted({(package["name"], package["version"]) for package in raw.get("package", []) if package.get("name") and package.get("version")})


def packages_web(lock: bytes) -> list[tuple[str, str]]:
    raw = json.loads(lock)
    packages = set()
    for path, package in raw.get("packages", {}).items():
        if not path or not package.get("version"):
            continue
        name = package.get("name") or path.removeprefix("node_modules/")
        packages.add((name, package["version"]))
    return sorted(packages)


def spdx(name: str, lock: bytes, packages: list[tuple[str, str]]) -> bytes:
    lock_digest = digest(lock)
    described = []
    relationships = []
    for package_name, version in packages:
        identity = hashlib.sha256(f"{package_name}\0{version}".encode()).hexdigest()[:16]
        spdx_id = f"SPDXRef-Package-{identity}"
        described.append({
            "SPDXID": spdx_id,
            "name": package_name,
            "versionInfo": version,
            "downloadLocation": "NOASSERTION",
            "filesAnalyzed": False,
            "licenseConcluded": "NOASSERTION",
            "licenseDeclared": "NOASSERTION",
            "supplier": "NOASSERTION",
        })
        relationships.append({"spdxElementId": "SPDXRef-DOCUMENT", "relationshipType": "DESCRIBES", "relatedSpdxElement": spdx_id})
    return canonical({
        "spdxVersion": "SPDX-2.3",
        "dataLicense": "CC0-1.0",
        "SPDXID": "SPDXRef-DOCUMENT",
        "name": name,
        "documentNamespace": f"https://dgx-forge.invalid/sbom/{name}/{lock_digest}",
        "creationInfo": {"created": "1970-01-01T00:00:00Z", "creators": ["Tool: DGX-Forge verify-supply-chain"]},
        "packages": described,
        "relationships": relationships,
    })


def expected(root: Path) -> tuple[dict[str, bytes], dict[str, object]]:
    python_lock = (root / "control/uv.lock").read_bytes()
    web_lock = (root / "control/web/package-lock.json").read_bytes()
    sboms = {
        "inventory/sbom/control-python.spdx.json": spdx("control-python", python_lock, packages_python(python_lock)),
        "inventory/sbom/control-web.spdx.json": spdx("control-web", web_lock, packages_web(web_lock)),
    }
    input_paths = (
        "control/uv.lock", "control/web/package-lock.json", "control/Dockerfile",
        "deploy/compose/compose.yaml", "deploy/compose/images.lock.json",
        "deploy/compose/trust/litellm-cosign.pub",
    )
    manifest = {
        "schema_version": 1,
        "inputs": {path: digest((root / path).read_bytes()) for path in input_paths},
        "sboms": {path: digest(content) for path, content in sboms.items()},
        "image_lock_sha256": digest((root / "deploy/compose/images.lock.json").read_bytes()),
        "signature_key_sha256": digest((root / "deploy/compose/trust/litellm-cosign.pub").read_bytes()),
    }
    return sboms, manifest


def image_errors(root: Path) -> list[str]:
    errors: list[str] = []
    try:
        lock = json.loads((root / "deploy/compose/images.lock.json").read_bytes())
    except Exception:
        return ["image lock is unreadable"]
    compose = (root / "deploy/compose/compose.yaml").read_text()
    for name, reference in {**lock.get("images", {}), **lock.get("build_bases", {})}.items():
        if not isinstance(reference, str) or IMAGE.fullmatch(reference) is None:
            errors.append(f"{name} image is not pinned by digest")
        if name in lock.get("images", {}) and reference not in compose:
            errors.append(f"{name} Compose default is not the locked digest-pinned image")
    if re.search(r"(?m)^\s*image:\s*[^$\n]*(?::latest|:main|:edge)(?:\s|$)", compose):
        errors.append("Compose contains a floating image tag without digest")
    release = lock.get("release_image", {})
    if release != {"environment": "CONTROL_IMAGE", "required": True} or "${CONTROL_IMAGE:?" not in compose:
        errors.append("control release image must be explicitly digest-pinned at deployment")
    dockerfile = (root / "control/Dockerfile").read_text()
    if "ARG NODE_IMAGE" not in dockerfile or "ARG PYTHON_IMAGE" not in dockerfile:
        errors.append("control build bases are not explicit locked arguments")
    return errors


def verify(root: Path, generate: bool) -> tuple[list[str], dict[str, object]]:
    errors = image_errors(root)
    try:
        sboms, manifest = expected(root)
    except (OSError, ValueError, KeyError, json.JSONDecodeError, tomllib.TOMLDecodeError) as error:
        return [*errors, f"could not generate expected supply-chain evidence: {type(error).__name__}"], {}
    manifest_path = root / "inventory/sbom/manifest.json"
    if generate:
        for path, content in sboms.items():
            target = root / path
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_bytes(content)
        manifest_path.write_bytes(canonical(manifest))
    else:
        for path, content in sboms.items():
            target = root / path
            if not target.is_file() or target.read_bytes() != content:
                errors.append(f"SBOM is missing or stale: {path}")
        if not manifest_path.is_file() or manifest_path.read_bytes() != canonical(manifest):
            errors.append("supply-chain manifest is missing or stale")
    result = {"ok": not errors, "images": len(json.loads((root / "deploy/compose/images.lock.json").read_bytes()).get("images", {})), "sboms": sorted(sboms), "manifest_sha256": digest(canonical(manifest))}
    return errors, result


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--generate", action="store_true")
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    errors, result = verify(args.root.resolve(), args.generate)
    result["errors"] = errors
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    else:
        for error in errors:
            print(f"verify-supply-chain: {error}", file=sys.stderr)
    return 1 if errors else 0


if __name__ == "__main__":
    raise SystemExit(main())
