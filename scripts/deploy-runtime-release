#!/usr/bin/env python3
"""Validate and atomically deploy an immutable runtime release to both Sparks."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import secrets
import shlex
import stat
import subprocess
import sys
import tomllib
from dataclasses import dataclass
from pathlib import Path, PurePosixPath

repository_src = Path(__file__).resolve().parents[1] / "src"
if str(repository_src) not in sys.path:
    sys.path.insert(0, str(repository_src))

from spark_profiles.ssh_transport import select_transport

_SHA256 = re.compile(r"^[0-9a-f]{64}$")
_SAFE_NAME = re.compile(r"^[A-Za-z0-9._/-]+$")
_WORKLOAD_NAME = re.compile(r"^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$")
_REMOTE_RELEASE_ROOT = "/opt/spark/model-adapters"
_SSH_OPTIONS = (
    "-o",
    "BatchMode=yes",
    "-o",
    "ForwardAgent=no",
    "-o",
    "IdentitiesOnly=yes",
    "-o",
    "StrictHostKeyChecking=yes",
    "-o",
    "ConnectTimeout=10",
)

_REMOTE_PATH_FUNCTIONS = r"""
require_real_directory() {
  local directory=$1
  local current= component
  local -a components
  [[ "$directory" == /* ]] || return 1
  IFS='/' read -r -a components <<<"$directory"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current="$current/$component"
    [[ -d "$current" && ! -L "$current" ]] || return 1
  done
}

require_safe_parent() {
  local trusted_root=$1
  local path=$2
  local parent suffix current component
  local -a components
  [[ "$path" == "$trusted_root/"* ]] || return 1
  require_real_directory "$trusted_root"
  parent=${path%/*}
  suffix=${parent#"$trusted_root"}
  current=$trusted_root
  IFS='/' read -r -a components <<<"$suffix"
  for component in "${components[@]}"; do
    [[ -n "$component" ]] || continue
    current="$current/$component"
    if [[ -e "$current" || -L "$current" ]]; then
      [[ -d "$current" && ! -L "$current" ]] || return 1
    else
      break
    fi
  done
}
"""

_VERIFY_FUNCTION = _REMOTE_PATH_FUNCTIONS + r"""
verify_tree() {
  local base=$1
  local file_count=$2
  local directory_count=$3
  shift 3
  require_real_directory "$base" || return 1
  local index directory relative expected actual expected_mode actual_mode
  for ((index = 0; index < directory_count; index++)); do
    directory=$1
    shift
    [[ -d "$base/$directory" && ! -L "$base/$directory" ]] || return 1
  done
  [[ $(find "$base" -mindepth 1 -type d -print | wc -l) -eq $directory_count ]] || return 1
  [[ -z $(find "$base" -mindepth 1 ! -type f ! -type d -print -quit) ]] || return 1
  for ((index = 0; index < file_count; index++)); do
    relative=$1
    expected=$2
    shift 2
    [[ -f "$base/$relative" && ! -L "$base/$relative" ]] || return 1
    actual=$(sha256sum -- "$base/$relative")
    actual=${actual%% *}
    [[ "$actual" == "$expected" ]] || return 1
    case "$relative" in
      bin/*) expected_mode=755 ;;
      *) expected_mode=644 ;;
    esac
    actual_mode=$(stat -c '%a' -- "$base/$relative")
    [[ "$actual_mode" == "$expected_mode" ]] || return 1
  done
  [[ $(find "$base" -type f -print | wc -l) -eq $file_count ]] || return 1
}
"""

_PROBE_SCRIPT = (
    "# deploy-runtime-release: probe\n"
    "set -euo pipefail\n"
    + _VERIFY_FUNCTION
    + r"""
trusted_root=$1
destination=$2
shift 2
require_safe_parent "$trusted_root" "$destination"
if [[ ! -O "$trusted_root" || ! -w "$trusted_root" ]]; then
  printf 'trusted release root is not owned and writable: %s\n' "$trusted_root" >&2
  exit 1
fi
if [[ ! -e "$destination" && ! -L "$destination" ]]; then
  printf 'absent\n'
  exit 0
fi
if verify_tree "$destination" "$@"; then
  printf 'identical\n'
  exit 0
fi
printf 'installed release differs\n' >&2
exit 43
"""
)

_PREPARE_SCRIPT = (
    "# deploy-runtime-release: prepare\n"
    "set -euo pipefail\n"
    + _REMOTE_PATH_FUNCTIONS
    + r"""
trusted_root=$1
temporary=$2
shift 2
if [[ "$temporary" != "$trusted_root"/*/releases/.*.tmp-* ]]; then
  printf 'unsafe temporary release path: %s\n' "$temporary" >&2
  exit 1
fi
require_safe_parent "$trusted_root" "$temporary"
if [[ ! -O "$trusted_root" || ! -w "$trusted_root" ]]; then
  printf 'trusted release root is not owned and writable: %s\n' "$trusted_root" >&2
  exit 1
fi
if [[ -e "$temporary" || -L "$temporary" ]]; then
  printf 'temporary release path already exists: %s\n' "$temporary" >&2
  exit 1
fi
install -d -m 0755 -- "$temporary"
require_real_directory "$temporary"
for directory in "$@"; do
  install -d -m 0755 -- "$temporary/$directory"
done
"""
)

_MODE_SCRIPT = (
    "# deploy-runtime-release: mode\n"
    "set -euo pipefail\n"
    + _REMOTE_PATH_FUNCTIONS
    + r'''
trusted_root=$1
temporary=$2
relative=$3
expected_mode=$4
if [[ "$temporary" != "$trusted_root"/*/releases/.*.tmp-* ]]; then
  printf 'unsafe temporary release path: %s\n' "$temporary" >&2
  exit 1
fi
require_safe_parent "$trusted_root" "$temporary"
require_real_directory "$temporary"
[[ "$relative" =~ ^[A-Za-z0-9._/-]+$ ]] || {
  printf 'unsafe release file path: %s\n' "$relative" >&2
  exit 1
}
IFS='/' read -r -a components <<<"$relative"
for component in "${components[@]}"; do
  [[ -n "$component" && "$component" != . && "$component" != .. ]] || {
    printf 'unsafe release file path: %s\n' "$relative" >&2
    exit 1
  }
done
case "$relative" in
  bin/*) required_mode=0755 ;;
  *) required_mode=0644 ;;
esac
[[ "$expected_mode" == "$required_mode" ]] || {
  printf 'invalid release file mode: %s %s\n' "$relative" "$expected_mode" >&2
  exit 1
}
path="$temporary/$relative"
require_safe_parent "$temporary" "$path"
[[ -f "$path" && ! -L "$path" ]] || {
  printf 'release file is missing or unsafe: %s\n' "$relative" >&2
  exit 1
}
chmod -- "$expected_mode" "$path"
'''
)

_FINALIZE_SCRIPT = (
    "# deploy-runtime-release: finalize\n"
    "set -euo pipefail\n"
    + _VERIFY_FUNCTION
    + r"""
trusted_root=$1
destination=$2
temporary=$3
shift 3
require_safe_parent "$trusted_root" "$destination"
require_safe_parent "$trusted_root" "$temporary"
if [[ ! -O "$trusted_root" || ! -w "$trusted_root" ]]; then
  printf 'trusted release root is not owned and writable: %s\n' "$trusted_root" >&2
  exit 1
fi
verify_tree "$temporary" "$@"
python3 -c '
import ctypes
import os
import sys

at_fdcwd = -100
rename_noreplace = 1
libc = ctypes.CDLL(None, use_errno=True)
renameat2 = libc.renameat2
renameat2.argtypes = [ctypes.c_int, ctypes.c_char_p, ctypes.c_int, ctypes.c_char_p, ctypes.c_uint]
renameat2.restype = ctypes.c_int
source = os.fsencode(sys.argv[1])
destination = os.fsencode(sys.argv[2])
if renameat2(at_fdcwd, source, at_fdcwd, destination, rename_noreplace) != 0:
    error = ctypes.get_errno()
    raise OSError(error, os.strerror(error), sys.argv[2])
' "$temporary" "$destination"
"""
)


class DeployError(RuntimeError):
    """Raised when a release cannot be validated or safely deployed."""


@dataclass(frozen=True)
class Release:
    workload: str
    digest: str
    manifest: Path
    prefix: PurePosixPath
    files: tuple[tuple[PurePosixPath, Path, str], ...]
    aliases: tuple[str, ...]

    @property
    def destination(self) -> str:
        return f"/opt/spark/model-adapters/{self.workload}/releases/{self.digest}"


def _sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _relative_path(value: object, context: str) -> PurePosixPath:
    if not isinstance(value, str) or not value or not _SAFE_NAME.fullmatch(value):
        raise DeployError(f"unsafe {context}: {value!r}")
    path = PurePosixPath(value)
    if path.is_absolute() or any(part in {"", ".", ".."} for part in path.parts):
        raise DeployError(f"unsafe {context}: {value!r}")
    return path


def _regular_file(root: Path, reference: PurePosixPath, context: str) -> Path:
    candidate = root
    for position, component in enumerate(reference.parts):
        candidate /= component
        try:
            details = candidate.lstat()
        except FileNotFoundError as error:
            raise DeployError(f"{context} does not exist: {reference}") from error
        if stat.S_ISLNK(details.st_mode):
            raise DeployError(f"{context} path must not contain symlinks: {reference}")
        if position < len(reference.parts) - 1:
            if not stat.S_ISDIR(details.st_mode):
                raise DeployError(
                    f"{context} parent must be a directory: {reference}"
                )
        elif not stat.S_ISREG(details.st_mode):
            raise DeployError(f"{context} must be a regular file: {reference}")
    return candidate


def _load_release(root: Path, workload_name: str) -> Release:
    if not _WORKLOAD_NAME.fullmatch(workload_name):
        raise DeployError(f"unsafe workload name: {workload_name!r}")
    workload_reference = PurePosixPath("config/workloads") / f"{workload_name}.toml"
    try:
        workload_path = _regular_file(root, workload_reference, "workload")
        with workload_path.open("rb") as source:
            workload = tomllib.load(source)
    except (FileNotFoundError, tomllib.TOMLDecodeError) as error:
        raise DeployError(f"cannot load workload: {workload_name}") from error
    if workload.get("id") != workload_name:
        raise DeployError("workload id does not match requested release")
    nodes = workload.get("nodes")
    if (
        not isinstance(nodes, list)
        or not nodes
        or any(not isinstance(node, str) for node in nodes)
        or len(nodes) != len(set(nodes))
        or not set(nodes).issubset({"spark1", "spark2"})
    ):
        raise DeployError("workload nodes must be a non-empty unique Spark node subset")
    runtime = workload.get("runtime_release")
    if not isinstance(runtime, dict):
        raise DeployError("workload has no runtime_release")
    digest = runtime.get("sha256")
    if not isinstance(digest, str) or not _SHA256.fullmatch(digest):
        raise DeployError("runtime manifest digest is invalid")
    manifest_reference = _relative_path(runtime.get("manifest"), "runtime manifest path")
    manifest_path = _regular_file(root, manifest_reference, "runtime manifest")
    if _sha256(manifest_path) != digest:
        raise DeployError("runtime manifest digest does not match workload")
    try:
        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise DeployError("runtime manifest is not valid JSON") from error
    files = manifest.get("files") if isinstance(manifest, dict) else None
    if (
        not isinstance(manifest, dict)
        or set(manifest) != {"files"}
        or not isinstance(files, dict)
        or not files
    ):
        raise DeployError("runtime manifest must contain a non-empty files object")

    prefix = manifest_reference.parent
    validated: list[tuple[PurePosixPath, Path, str]] = []
    for raw_reference, expected in sorted(files.items()):
        reference = _relative_path(raw_reference, "runtime payload path")
        if not isinstance(expected, str) or not _SHA256.fullmatch(expected):
            raise DeployError(f"invalid payload digest: {reference}")
        try:
            installed = reference.relative_to(prefix)
        except ValueError as error:
            raise DeployError(
                "runtime payloads must share the manifest-parent prefix"
            ) from error
        if installed == PurePosixPath("."):
            raise DeployError("runtime payload cannot be the release directory")
        source = _regular_file(root, reference, "runtime payload")
        if _sha256(source) != expected:
            raise DeployError(f"runtime payload digest mismatch: {reference}")
        validated.append((installed, source, expected))

    try:
        inventory_path = _regular_file(
            root, PurePosixPath("inventory/cluster.toml"), "inventory"
        )
        with inventory_path.open("rb") as source:
            inventory = tomllib.load(source)
        aliases = tuple(
            inventory["hosts"][node]["ssh_alias"] for node in nodes
        )
    except (FileNotFoundError, KeyError, TypeError, tomllib.TOMLDecodeError) as error:
        raise DeployError("inventory must declare SSH aliases for workload nodes") from error
    if any(
        not isinstance(alias, str)
        or not re.fullmatch(r"[A-Za-z0-9._-]+", alias)
        for alias in aliases
    ):
        raise DeployError("inventory contains an unsafe SSH alias")
    return Release(
        workload_name,
        digest,
        manifest_path,
        prefix,
        tuple(validated),
        aliases,
    )


def _tree_arguments(release: Release) -> tuple[str, ...]:
    directories = sorted(
        {
            str(parent)
            for installed, _, _ in release.files
            for parent in installed.parents
            if parent != PurePosixPath(".")
        }
    )
    payloads = tuple(
        value
        for installed, _, digest in release.files
        for value in (str(installed), digest)
    )
    return (
        str(len(release.files)),
        str(len(directories)),
        *directories,
        *payloads,
    )


def _remote_command(arguments: tuple[str, ...]) -> str:
    if any("\0" in value or "\n" in value or "\r" in value for value in arguments):
        raise DeployError("remote argument contains a forbidden character")
    return shlex.join(("bash", "-s", "--", *arguments))


def _ssh(
    alias: str,
    script: str,
    arguments: tuple[str, ...],
    *,
    ssh_bin: str,
) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        (ssh_bin, *_SSH_OPTIONS, alias, _remote_command(arguments)),
        input=script,
        check=False,
        capture_output=True,
        text=True,
        shell=False,
    )


def _require_remote_success(
    completed: subprocess.CompletedProcess[str], context: str
) -> None:
    if completed.returncode != 0:
        detail = completed.stderr.strip() or f"exit {completed.returncode}"
        raise DeployError(f"{context}: {detail}")


def _scp_source_argument(source: Path, path_style: str) -> str:
    """Render a local source path in the selected SCP transport's syntax."""
    if path_style == "posix":
        return str(source)
    if path_style != "windows":
        raise DeployError(f"unsupported SCP path style: {path_style}")
    try:
        converted = subprocess.run(
            ("wslpath", "-w", str(source)),
            check=False,
            capture_output=True,
            text=True,
            shell=False,
        )
    except OSError as error:
        raise DeployError(f"cannot translate WSL release path: {error}") from error
    translated = converted.stdout.strip()
    if converted.returncode != 0 or not translated:
        detail = converted.stderr.strip() or f"exit {converted.returncode}"
        raise DeployError(f"cannot translate WSL release path: {detail}")
    return translated


def _deploy_host(
    release: Release,
    alias: str,
    *,
    ssh_bin: str,
    scp_bin: str,
    scp_path_style: str,
) -> str:
    tree_arguments = _tree_arguments(release)
    probe = _ssh(
        alias,
        _PROBE_SCRIPT,
        (_REMOTE_RELEASE_ROOT, release.destination, *tree_arguments),
        ssh_bin=ssh_bin,
    )
    state = probe.stdout.strip()
    if probe.returncode == 43:
        raise DeployError(f"refusing to replace different release on {alias}")
    _require_remote_success(probe, f"release probe failed on {alias}")
    if state == "identical":
        return "already installed"
    if state != "absent":
        raise DeployError(f"release probe returned an invalid state on {alias}")

    temporary = (
        f"{release.destination.rsplit('/', 1)[0]}/.{release.digest}.tmp-"
        f"{secrets.token_hex(8)}"
    )
    directories = tree_arguments[2 : 2 + int(tree_arguments[1])]
    prepared = _ssh(
        alias,
        _PREPARE_SCRIPT,
        (_REMOTE_RELEASE_ROOT, temporary, *directories),
        ssh_bin=ssh_bin,
    )
    _require_remote_success(prepared, f"temporary release creation failed on {alias}")

    for installed, source, _ in release.files:
        destination = f"{alias}:{temporary}/{installed}"
        source_argument = _scp_source_argument(source, scp_path_style)
        copied = subprocess.run(
            (scp_bin, *_SSH_OPTIONS, "-p", "--", source_argument, destination),
            check=False,
            capture_output=True,
            text=True,
            shell=False,
        )
        if copied.returncode != 0:
            detail = copied.stderr.strip() or f"exit {copied.returncode}"
            raise DeployError(f"release transfer failed on {alias}: {detail}")
        expected_mode = "0755" if installed.parts[0] == "bin" else "0644"
        mode_applied = _ssh(
            alias,
            _MODE_SCRIPT,
            (
                _REMOTE_RELEASE_ROOT,
                temporary,
                str(installed),
                expected_mode,
            ),
            ssh_bin=ssh_bin,
        )
        _require_remote_success(
            mode_applied,
            f"release mode application failed on {alias}",
        )

    finalized = _ssh(
        alias,
        _FINALIZE_SCRIPT,
        (
            _REMOTE_RELEASE_ROOT,
            release.destination,
            temporary,
            *tree_arguments,
        ),
        ssh_bin=ssh_bin,
    )
    _require_remote_success(finalized, f"release verification failed on {alias}")
    return "installed"


def _deploy(release: Release) -> None:
    try:
        ssh_transport = select_transport("ssh")
        scp_transport = select_transport("scp")
    except ValueError as error:
        raise DeployError(str(error)) from error
    for alias in release.aliases:
        result = _deploy_host(
            release,
            alias,
            ssh_bin=ssh_transport.binary,
            scp_bin=scp_transport.binary,
            scp_path_style=scp_transport.path_style,
        )
        print(f"{alias}: {result} {release.destination}")


def _main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("workload")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parents[1])
    parser.add_argument("--apply", action="store_true")
    args = parser.parse_args()
    try:
        release = _load_release(args.root.resolve(), args.workload)
        if args.apply:
            _deploy(release)
        else:
            print(
                json.dumps(
                    {
                        "action": "dry-run",
                        "workload": release.workload,
                        "manifest_sha256": release.digest,
                        "destination": release.destination,
                        "hosts": release.aliases,
                        "files": [str(path) for path, _, _ in release.files],
                    },
                    sort_keys=True,
                )
            )
        return 0
    except DeployError as error:
        parser.error(str(error))
        return 2


if __name__ == "__main__":
    raise SystemExit(_main())
