#!/usr/bin/env python3
"""Build the deterministic Spark-side payload set for one platform release."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import secrets
import shutil
import stat
import struct
import sys
import tarfile
from pathlib import Path

_MACHINES = {"linux-arm64": 183, "linux-x86_64": 62}
_MAX_FILE_BYTES = 256 * 1024 * 1024
_MAX_TOOLING_BYTES = 64 * 1024 * 1024


class BuildError(RuntimeError):
    """The reviewed payload inputs cannot produce a safe release set."""


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read_file(path: Path, label: str, *, executable: bool) -> tuple[bytes, int]:
    if not path.is_absolute():
        raise BuildError(f"{label} path must be absolute")
    try:
        descriptor = os.open(
            path, os.O_RDONLY | os.O_CLOEXEC | os.O_NONBLOCK | os.O_NOFOLLOW
        )
    except OSError as error:
        raise BuildError(f"{label} is unavailable or unsafe") from error
    try:
        before = os.fstat(descriptor)
        mode = stat.S_IMODE(before.st_mode)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or before.st_uid not in {0, os.geteuid()}
            or mode & 0o022
            or (executable and mode & 0o111 == 0)
            or not 0 < before.st_size <= _MAX_FILE_BYTES
        ):
            raise BuildError(f"{label} is unavailable or unsafe")
        raw = b""
        while len(raw) < before.st_size:
            chunk = os.read(descriptor, before.st_size - len(raw))
            if not chunk:
                raise BuildError(f"{label} changed while read")
            raw += chunk
        after = os.fstat(descriptor)
        identity = lambda value: (
            value.st_dev,
            value.st_ino,
            value.st_size,
            value.st_mtime_ns,
            value.st_ctime_ns,
        )
        if identity(before) != identity(after):
            raise BuildError(f"{label} changed while read")
        return raw, mode
    finally:
        os.close(descriptor)


def _verify_agent(raw: bytes, architecture: str) -> None:
    if architecture not in _MACHINES:
        raise BuildError("payload architecture is unsupported")
    if len(raw) < 64 or raw[:7] != b"\x7fELF\x02\x01\x01":
        raise BuildError("agent payload is not ELF64 little-endian")
    elf_type, machine = struct.unpack_from("<HH", raw, 16)
    if elf_type not in {2, 3} or machine != _MACHINES[architecture]:
        raise BuildError("agent payload architecture is incompatible")


def _tooling_members(root: Path, prefix: str, *, executable: bool) -> list[tuple[str, bytes, int]]:
    if not root.is_absolute():
        raise BuildError("tooling path must be absolute")
    try:
        root_metadata = root.lstat()
    except OSError as error:
        raise BuildError("tooling input is unavailable or unsafe") from error
    if not stat.S_ISDIR(root_metadata.st_mode) or root.is_symlink():
        raise BuildError("tooling input is unavailable or unsafe")
    members: list[tuple[str, bytes, int]] = []
    for path in sorted(root.rglob("*"), key=lambda item: item.relative_to(root).as_posix()):
        try:
            metadata = path.lstat()
        except OSError as error:
            raise BuildError("tooling member is unavailable or unsafe") from error
        if stat.S_ISDIR(metadata.st_mode):
            continue
        if not stat.S_ISREG(metadata.st_mode) or path.is_symlink():
            raise BuildError("tooling member is unavailable or unsafe")
        raw, mode = _read_file(path, "tooling member", executable=executable)
        target = f"{prefix}/{path.relative_to(root).as_posix()}"
        members.append((target, raw, 0o555 if executable else mode & 0o444))
    if not members or sum(len(raw) for _, raw, _ in members) > _MAX_TOOLING_BYTES:
        raise BuildError("tooling payload is empty or too large")
    return members


def _tooling_archive(bin_root: Path, policy_root: Path) -> bytes:
    members = _tooling_members(bin_root, "bin", executable=True)
    members.extend(_tooling_members(policy_root, "policy", executable=False))
    members.sort(key=lambda item: item[0])
    buffer = io.BytesIO()
    with tarfile.open(fileobj=buffer, mode="w", format=tarfile.GNU_FORMAT) as archive:
        for name, raw, mode in members:
            info = tarfile.TarInfo(name)
            info.size = len(raw)
            info.mode = mode
            info.uid = 0
            info.gid = 0
            info.uname = "root"
            info.gname = "root"
            info.mtime = 0
            archive.addfile(info, io.BytesIO(raw))
    return buffer.getvalue()


def _write(path: Path, raw: bytes, mode: int) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        mode,
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fchmod(descriptor, mode)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def _payload(name: str, raw: bytes) -> dict[str, object]:
    return {
        "name": name,
        "sha256": hashlib.sha256(raw).hexdigest(),
        "size": len(raw),
    }


def build(
    agent_path: Path,
    supervisor_path: Path,
    tooling_bin: Path,
    tooling_policy: Path,
    architecture: str,
    output: Path,
) -> None:
    if not output.is_absolute() or output.exists() or not output.parent.is_dir():
        raise BuildError("output already exists or is unsafe")
    agent, _ = _read_file(agent_path, "agent payload", executable=True)
    _verify_agent(agent, architecture)
    supervisor, _ = _read_file(
        supervisor_path, "supervisor payload", executable=True
    )
    if not supervisor.startswith(b"#!/usr/bin/python3 -I\n"):
        raise BuildError("supervisor payload interpreter is invalid")
    tooling = _tooling_archive(tooling_bin, tooling_policy)
    payloads = {
        "agent": ("dgx-agent", agent, 0o555),
        "supervisor": ("dgx-agent-supervisor", supervisor, 0o555),
        "tooling": ("dgx-forge-tooling", tooling, 0o444),
    }
    receipt = {
        "architecture": architecture,
        "payloads": {
            key: _payload(name, raw) for key, (name, raw, _) in payloads.items()
        },
        "schema_version": 1,
    }
    temporary = output.parent / f".{output.name}.{secrets.token_hex(8)}.tmp"
    try:
        temporary.mkdir(mode=0o700)
        for name, raw, mode in payloads.values():
            _write(temporary / name, raw, mode)
        _write(temporary / "spark-platform-payloads.json", _canonical(receipt), 0o444)
        directory = os.open(temporary, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(directory)
        finally:
            os.close(directory)
        os.rename(temporary, output)
        parent = os.open(output.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
        try:
            os.fsync(parent)
        finally:
            os.close(parent)
    except OSError as error:
        raise BuildError("payload set could not be published") from error
    finally:
        if temporary.exists():
            shutil.rmtree(temporary)


def main() -> int:
    parser = argparse.ArgumentParser(prog="build-spark-platform-payloads")
    parser.add_argument("--agent", required=True, type=Path)
    parser.add_argument("--supervisor", required=True, type=Path)
    parser.add_argument("--tooling-bin", required=True, type=Path)
    parser.add_argument("--tooling-policy", required=True, type=Path)
    parser.add_argument("--architecture", required=True)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args()
    try:
        build(
            args.agent,
            args.supervisor,
            args.tooling_bin,
            args.tooling_policy,
            args.architecture,
            args.output,
        )
    except BuildError as error:
        print(f"build-spark-platform-payloads: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
