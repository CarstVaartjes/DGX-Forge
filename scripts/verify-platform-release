#!/usr/bin/env python3
"""Aggregate release evidence without inventing external acceptance."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import subprocess
import uuid
from pathlib import Path

from cryptography.exceptions import InvalidSignature
from cryptography.hazmat.primitives.asymmetric import ed25519

REPORTS = ("control-plane-recovery", "control-plane-scale", "platform-lifecycle")
WORKLOAD_REPORTS = {
    "workload-package-acceptance": "workload-package-acceptance.json",
    "workload-package-failure-matrix": "workload-package-failure-matrix.json",
}
UPDATE_REPORT = "platform-update"
UPDATE_PHYSICAL_GATES = {
    "control_host_update_recovery": "physical-control-host-update-recovery",
    "signed_platform_update_manifest": "signed-platform-update-manifest-evidence",
    "spark_canary_and_rollback": "physical-spark-canary-rollback",
}
UPDATE_PHYSICAL_REPORTS = {
    "control_host_update_recovery": (
        "platform-update-control-host-recovery.json",
        "control-host-update-recovery",
    ),
    "signed_platform_update_manifest": (
        "platform-update-signed-manifest.json",
        "signed-platform-update-manifest",
    ),
    "spark_canary_and_rollback": (
        "platform-update-spark-canary-rollback.json",
        "spark-canary-and-rollback",
    ),
}
_MAX_PHYSICAL_EVIDENCE_BYTES = 1024 * 1024
_MAX_REPORT_BYTES = 1024 * 1024
_SHA256 = re.compile(r"[0-9a-f]{64}\Z")
_PREFIXED_SHA256 = re.compile(r"sha256:[0-9a-f]{64}\Z")
_COMMIT = re.compile(r"[0-9a-f]{40}\Z")
_SIGNATURE = re.compile(r"[0-9a-f]{128}\Z")
_SEMVER = re.compile(r"[0-9]+\.[0-9]+\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?\Z")
_OBSERVED_AT = re.compile(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\Z")
_GENERATION = re.compile(r"gen-[0-9a-f]{24}\Z")
_NODE_ID = re.compile(r"spk_[0-9a-f]{32}\Z")
_ARCHITECTURE = re.compile(r"linux-(?:amd64|arm64)\Z")
_WORKLOAD_DIGEST = re.compile(r"sha256:[0-9a-f]{64}\Z")
_WORKLOAD_BARE_DIGEST = re.compile(r"[0-9a-f]{64}\Z")


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read_bounded_regular(path: Path, *, maximum: int) -> bytes | None:
    """Read one stable, non-linked regular file without following a symlink."""

    descriptor: int | None = None
    try:
        descriptor = os.open(
            path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
        )
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or not 0 < before.st_size <= maximum
        ):
            return None
        chunks: list[bytes] = []
        remaining = before.st_size
        while remaining:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                return None
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            return None
        after = os.fstat(descriptor)
        if (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ) != (
            before.st_dev,
            before.st_ino,
            before.st_size,
            before.st_mtime_ns,
        ):
            return None
        return b"".join(chunks)
    except OSError:
        return None
    finally:
        if descriptor is not None:
            os.close(descriptor)


def _evidence_kind(report: dict[str, object]) -> str:
    explicit = report.get("evidence_kind")
    if explicit in {"simulated", "physical", "assertion"}:
        return str(explicit)
    environment = report.get("environment")
    if isinstance(environment, str) and any(
        marker in environment for marker in ("simulat", "disposable", "fake")
    ):
        return "simulated"
    return "unclassified"


def _physical_artifact_claims(
    root: Path,
    *,
    name: str,
    evidence_type: str,
    expected_sha256: str,
    candidate: str,
    release_digest: str,
    run_id: str,
    public_key: ed25519.Ed25519PublicKey,
    key_id: str,
) -> dict[str, object] | None:
    path = root / "inventory/reports" / name
    try:
        metadata = path.lstat()
        if (
            path.is_symlink()
            or not path.is_file()
            or not 0 < metadata.st_size <= _MAX_PHYSICAL_EVIDENCE_BYTES
        ):
            return None
        raw = path.read_bytes()
    except OSError:
        return None
    if hashlib.sha256(raw).hexdigest() != expected_sha256:
        return None
    try:
        document = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None
    if (
        not isinstance(document, dict)
        or raw != canonical(document)
        or set(document) != {"evidence", "schema_version", "signature"}
        or document.get("schema_version") != 1
    ):
        return None
    evidence = document.get("evidence")
    signature = document.get("signature")
    if (
        not isinstance(evidence, dict)
        or set(evidence)
        != {
            "candidate",
            "claims",
            "details_sha256",
            "evidence_kind",
            "evidence_type",
            "observed_at",
            "physical_exercised",
            "release_digest",
            "run_id",
            "schema_version",
            "status",
        }
        or evidence.get("schema_version") != 1
        or evidence.get("evidence_kind") != "physical"
        or evidence.get("evidence_type") != evidence_type
        or evidence.get("physical_exercised") is not True
        or evidence.get("status") != "passed"
        or evidence.get("candidate") != candidate
        or evidence.get("release_digest") != release_digest
        or evidence.get("run_id") != run_id
        or not _physical_claims_valid(
            evidence.get("claims"),
            evidence_type=evidence_type,
            candidate=candidate,
            release_digest=release_digest,
        )
        or not isinstance(evidence.get("details_sha256"), str)
        or _SHA256.fullmatch(evidence["details_sha256"]) is None
        or not isinstance(evidence.get("observed_at"), str)
        or _OBSERVED_AT.fullmatch(evidence["observed_at"]) is None
        or not isinstance(signature, dict)
        or set(signature) != {"algorithm", "key_id", "value"}
        or signature.get("algorithm") != "ed25519"
        or signature.get("key_id") != key_id
        or not isinstance(signature.get("value"), str)
        or _SIGNATURE.fullmatch(signature["value"]) is None
    ):
        return None
    try:
        public_key.verify(bytes.fromhex(signature["value"]), canonical(evidence))
    except (InvalidSignature, ValueError):
        return None
    return dict(evidence["claims"])


def _physical_claims_valid(
    value: object, *, evidence_type: str, candidate: str, release_digest: str
) -> bool:
    if not isinstance(value, dict):
        return False
    if evidence_type == "signed-platform-update-manifest":
        if set(value) != {
            "agent_payload_sha256",
            "build_digest",
            "platform_target_name",
            "platform_target_sha256",
            "tuf_targets_version",
        }:
            return False
        target_sha256 = value.get("platform_target_sha256")
        payloads = value.get("agent_payload_sha256")
        return (
            isinstance(payloads, dict)
            and 1 <= len(payloads) <= 16
            and all(
                isinstance(architecture, str)
                and _ARCHITECTURE.fullmatch(architecture) is not None
                and isinstance(digest, str)
                and _SHA256.fullmatch(digest) is not None
                for architecture, digest in payloads.items()
            )
            and isinstance(value.get("build_digest"), str)
            and _PREFIXED_SHA256.fullmatch(value["build_digest"]) is not None
            and isinstance(target_sha256, str)
            and _SHA256.fullmatch(target_sha256) is not None
            and release_digest == "sha256:" + target_sha256
            and value.get("platform_target_name")
            == f"platform/releases/{candidate}/{target_sha256}.json"
            and isinstance(value.get("tuf_targets_version"), int)
            and not isinstance(value.get("tuf_targets_version"), bool)
            and value["tuf_targets_version"] >= 1
        )
    if evidence_type == "control-host-update-recovery":
        if set(value) != {
            "candidate_generation",
            "from_generation",
            "recovered_generation",
            "recovery_evidence_sha256",
            "rollback_evidence_sha256",
            "rolled_back_generation",
        }:
            return False
        candidate_generation = value.get("candidate_generation")
        from_generation = value.get("from_generation")
        return (
            isinstance(candidate_generation, str)
            and _GENERATION.fullmatch(candidate_generation) is not None
            and candidate_generation
            == "gen-" + release_digest.removeprefix("sha256:")[:24]
            and isinstance(from_generation, str)
            and _GENERATION.fullmatch(from_generation) is not None
            and candidate_generation != from_generation
            and value.get("recovered_generation") == candidate_generation
            and isinstance(value.get("recovery_evidence_sha256"), str)
            and _SHA256.fullmatch(value["recovery_evidence_sha256"]) is not None
            and isinstance(value.get("rollback_evidence_sha256"), str)
            and _SHA256.fullmatch(value["rollback_evidence_sha256"]) is not None
            and value.get("rolled_back_generation") == from_generation
        )
    if evidence_type == "spark-canary-and-rollback":
        if set(value) != {
            "architecture",
            "canary_node",
            "from_agent_sha256",
            "from_platform_version",
            "from_slot",
            "rollback_evidence_sha256",
            "rollback_slot",
            "ssh_used_for_standard_path",
            "supervisor_generation",
            "target_agent_sha256",
            "target_build_digest",
            "target_platform_version",
            "target_slot",
            "transport",
        }:
            return False
        from_slot = value.get("from_slot")
        from_agent_sha256 = value.get("from_agent_sha256")
        target_agent_sha256 = value.get("target_agent_sha256")
        return (
            isinstance(value.get("architecture"), str)
            and _ARCHITECTURE.fullmatch(value["architecture"]) is not None
            and isinstance(value.get("canary_node"), str)
            and _NODE_ID.fullmatch(value["canary_node"]) is not None
            and isinstance(from_agent_sha256, str)
            and _SHA256.fullmatch(from_agent_sha256) is not None
            and isinstance(value.get("from_platform_version"), str)
            and _SEMVER.fullmatch(value["from_platform_version"]) is not None
            and from_slot in {"A", "B"}
            and value.get("target_slot") in {"A", "B"}
            and value.get("target_slot") != from_slot
            and value.get("rollback_slot") == from_slot
            and value.get("ssh_used_for_standard_path") is False
            and value.get("transport") == "outbound-mtls-agent-channel"
            and isinstance(value.get("supervisor_generation"), int)
            and not isinstance(value.get("supervisor_generation"), bool)
            and value["supervisor_generation"] >= 1
            and isinstance(target_agent_sha256, str)
            and _SHA256.fullmatch(target_agent_sha256) is not None
            and target_agent_sha256 != from_agent_sha256
            and isinstance(value.get("target_build_digest"), str)
            and _PREFIXED_SHA256.fullmatch(value["target_build_digest"]) is not None
            and value.get("target_platform_version") == candidate
            and isinstance(value.get("rollback_evidence_sha256"), str)
            and _SHA256.fullmatch(value["rollback_evidence_sha256"]) is not None
        )
    return False


def _spark_claim_matches_manifest(manifest: object, spark: object) -> bool:
    if not isinstance(manifest, dict) or not isinstance(spark, dict):
        return False
    payloads = manifest.get("agent_payload_sha256")
    architecture = spark.get("architecture")
    return (
        isinstance(payloads, dict)
        and isinstance(architecture, str)
        and payloads.get(architecture) == spark.get("target_agent_sha256")
        and manifest.get("build_digest") == spark.get("target_build_digest")
    )


def _read_workload_report(root: Path, name: str) -> tuple[dict[str, object] | None, str | None]:
    """Read one canonical, bounded workload acceptance report.

    Workload evidence is intentionally supplied by the acceptance harness and
    not synthesized by this aggregate verifier.  Requiring a canonical file
    also makes the digest recorded in release evidence reproducible in hosted
    CI and on the NAS.
    """

    path = root / "inventory/reports" / WORKLOAD_REPORTS[name]
    raw = _read_bounded_regular(path, maximum=_MAX_REPORT_BYTES)
    if raw is None:
        return None, None
    digest = hashlib.sha256(raw).hexdigest()
    try:
        report = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return None, digest
    if not isinstance(report, dict) or raw != canonical(report):
        return None, digest
    declared = report.get("digest")
    without_digest = dict(report)
    without_digest.pop("digest", None)
    expected = "sha256:" + hashlib.sha256(canonical(without_digest)).hexdigest()
    if not isinstance(declared, str) or declared != expected:
        return None, digest
    return report, digest


def _secret_free(value: object) -> bool:
    """Reject obvious secret-bearing evidence fields without inspecting payloads."""

    if isinstance(value, dict):
        for key, item in value.items():
            key_text = str(key).lower()
            if any(marker in key_text for marker in ("password", "private_key", "secret_value", "access_token")) and item not in (None, "", False):
                return False
            if not _secret_free(item):
                return False
    elif isinstance(value, list):
        return all(_secret_free(item) for item in value)
    return True


def _workload_acceptance_valid(report: object) -> bool:
    if not isinstance(report, dict):
        return False
    required = {
        "schema_version",
        "report_type",
        "status",
        "evidence_kind",
        "physical_sparks_exercised",
        "unknown_family_without_agent_update",
        "agent_digest_unchanged",
        "release_two_activated",
        "offline_release_one_rollback",
        "unsigned_release_rejected",
        "unapproved_release_rejected",
        "ssh_calls",
        "agent_update_calls",
    }
    return not (
        not required <= set(report)
        or report.get("schema_version") != 1
        or report.get("report_type") not in {
            "dgx-forge-workload-package-acceptance",
            "workload-package-acceptance",
        }
        or report.get("status") != "passed"
        or report.get("evidence_kind") not in {"assertion", "simulated", "physical"}
        or report.get("physical_sparks_exercised") not in {True, False}
        or not all(report.get(field) is True for field in (
            "unknown_family_without_agent_update",
            "agent_digest_unchanged",
            "release_two_activated",
            "offline_release_one_rollback",
            "unsigned_release_rejected",
            "unapproved_release_rejected",
        ))
        or report.get("ssh_calls") != 0
        or report.get("agent_update_calls") != 0
        or not _secret_free(report)
    )


def _failure_matrix_valid(report: object) -> bool:
    if not isinstance(report, dict):
        return False
    if (
        report.get("schema_version") != 1
        or report.get("report_type") not in {
            "dgx-forge-workload-package-failure-matrix",
            "workload-package-failure-matrix",
        }
        or report.get("status") != "passed"
        or report.get("evidence_kind") not in {"assertion", "simulated", "physical"}
        or report.get("failure_matrix") is not True
        or report.get("physical_sparks_exercised") not in {True, False}
        or report.get("ssh_calls") != 0
        or report.get("agent_update_calls") != 0
        or report.get("restart_recovery") != "passed"
        or report.get("gc_restart_recovery") != "passed"
        or report.get("concurrent_identical_downloads") != "one-fetch-many-consumers"
        or not _secret_free(report)
    ):
        return False
    cases = report.get("cases")
    if not isinstance(cases, list) or not cases:
        return False
    required_case = {"family_id", "release_digest", "node_id", "fence", "reason_code", "disposition"}
    dispositions = {"safe-to-retry", "compensate", "operator-intervention"}
    for case in cases:
        if not isinstance(case, dict) or not required_case <= set(case):
            return False
        if (
            not isinstance(case["family_id"], str)
            or not isinstance(case["release_digest"], str)
            or not (
                _WORKLOAD_DIGEST.fullmatch(case["release_digest"])
                or _WORKLOAD_BARE_DIGEST.fullmatch(case["release_digest"])
            )
            or not isinstance(case["node_id"], str)
            or not isinstance(case["fence"], str)
            or not isinstance(case["reason_code"], str)
            or case["disposition"] not in dispositions
        ):
            return False
    return True


def _workload_evidence(root: Path) -> tuple[dict[str, object], dict[str, str], list[str]]:
    """Validate the independent workload acceptance artifacts."""

    digests: dict[str, str] = {}
    kinds: dict[str, str] = {}
    missing: list[str] = []
    acceptance, acceptance_digest = _read_workload_report(root, "workload-package-acceptance")
    failure, failure_digest = _read_workload_report(root, "workload-package-failure-matrix")
    if acceptance_digest is not None:
        digests["workload-package-acceptance"] = acceptance_digest
    if failure_digest is not None:
        digests["workload-package-failure-matrix"] = failure_digest
    if acceptance is None:
        kinds["workload-package-acceptance"] = "missing"
        missing.append("workload-package-acceptance")
    elif not _workload_acceptance_valid(acceptance):
        kinds["workload-package-acceptance"] = "invalid"
        missing.append("workload-package-acceptance:valid")
    else:
        kinds["workload-package-acceptance"] = str(acceptance["evidence_kind"])
    if failure is None:
        kinds["workload-package-failure-matrix"] = "missing"
        missing.append("workload-package-failure-matrix")
    elif not _failure_matrix_valid(failure):
        kinds["workload-package-failure-matrix"] = "invalid"
        missing.append("workload-package-failure-matrix:valid")
    else:
        kinds["workload-package-failure-matrix"] = str(failure["evidence_kind"])
    acceptance_ok = acceptance is not None and _workload_acceptance_valid(acceptance)
    failure_ok = failure is not None and _failure_matrix_valid(failure)
    return (
        {
            "unknown_family_without_agent_update": bool(
                acceptance_ok and acceptance["unknown_family_without_agent_update"]
            ),
            "agent_digest_unchanged": bool(acceptance_ok and acceptance["agent_digest_unchanged"]),
            "release_two_activated": bool(acceptance_ok and acceptance["release_two_activated"]),
            "offline_release_one_rollback": bool(
                acceptance_ok and acceptance["offline_release_one_rollback"]
            ),
            "unsigned_release_rejected": bool(
                acceptance_ok and acceptance["unsigned_release_rejected"]
            ),
            "unapproved_release_rejected": bool(
                acceptance_ok and acceptance["unapproved_release_rejected"]
            ),
            "ssh_calls": acceptance.get("ssh_calls") if acceptance_ok else None,
            "agent_update_calls": acceptance.get("agent_update_calls") if acceptance_ok else None,
            "failure_matrix": failure_ok,
            "evidence_sha256": dict(sorted(digests.items())),
            "missing_gates": sorted(set(missing)),
        },
        kinds,
        missing,
    )


def _code_host_pr_lifecycle_valid(
    value: object, required_checks: object
) -> bool:
    """Validate optional evidence that a protected PR path was exercised."""

    if not isinstance(value, dict) or value.get("status") != "passed":
        return False
    pull_request = value.get("pull_request")
    merge_commit = value.get("merge_commit")
    checks = value.get("checks")
    if (
        isinstance(pull_request, bool)
        or not isinstance(pull_request, int)
        or pull_request < 1
        or not isinstance(merge_commit, str)
        or _COMMIT.fullmatch(merge_commit) is None
        or not isinstance(required_checks, list)
        or not required_checks
        or not isinstance(checks, list)
    ):
        return False
    observed = {
        item.get("name")
        for item in checks
        if isinstance(item, dict)
        and item.get("conclusion") == "SUCCESS"
        and isinstance(item.get("name"), str)
    }
    return (
        all(isinstance(item, str) and item for item in required_checks)
        and set(required_checks) <= observed
    )


def _physical_evidence_key(
    path: Path | None,
) -> tuple[ed25519.Ed25519PublicKey | None, str | None]:
    if path is None or not path.is_absolute():
        return None, None
    descriptor: int | None = None
    try:
        for parent in path.parents:
            parent_metadata = parent.lstat()
            if (
                parent.is_symlink()
                or not stat.S_ISDIR(parent_metadata.st_mode)
                or parent_metadata.st_uid != 0
                or stat.S_IMODE(parent_metadata.st_mode) & 0o022
            ):
                return None, None
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
        metadata = os.fstat(descriptor)
        if (
            not stat.S_ISREG(metadata.st_mode)
            or metadata.st_nlink != 1
            or metadata.st_uid != 0
            or not 0 < metadata.st_size <= 4096
            or stat.S_IMODE(metadata.st_mode) & 0o022
        ):
            return None, None
        chunks: list[bytes] = []
        remaining = metadata.st_size
        while remaining:
            chunk = os.read(descriptor, remaining)
            if not chunk:
                return None, None
            chunks.append(chunk)
            remaining -= len(chunk)
        if os.read(descriptor, 1):
            return None, None
        after = os.fstat(descriptor)
        if (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ) != (
            metadata.st_dev,
            metadata.st_ino,
            metadata.st_size,
            metadata.st_mtime_ns,
        ):
            return None, None
        raw = b"".join(chunks)
        document = json.loads(raw)
    except (OSError, UnicodeDecodeError, json.JSONDecodeError):
        return None, None
    finally:
        if descriptor is not None:
            os.close(descriptor)
    if (
        not isinstance(document, dict)
        or raw != canonical(document)
        or set(document) != {"algorithm", "key_id", "public_key", "schema_version"}
        or document.get("algorithm") != "ed25519"
        or document.get("schema_version") != 1
        or not isinstance(document.get("key_id"), str)
        or _SHA256.fullmatch(document["key_id"]) is None
        or not isinstance(document.get("public_key"), str)
        or re.fullmatch(r"[0-9a-f]{64}", document["public_key"]) is None
    ):
        return None, None
    public = bytes.fromhex(document["public_key"])
    key_id = hashlib.sha256(public).hexdigest()
    if key_id != document["key_id"]:
        return None, None
    try:
        return ed25519.Ed25519PublicKey.from_public_bytes(public), key_id
    except ValueError:
        return None, None


def _update_evidence(
    root: Path,
    candidate: str,
    public_key: ed25519.Ed25519PublicKey | None,
    key_id: str | None,
) -> tuple[str, str | None, dict[str, bool], list[str]]:
    path = root / f"inventory/reports/{UPDATE_REPORT}.json"
    gates = {name: False for name in UPDATE_PHYSICAL_GATES}
    missing: list[str] = []
    if not path.is_file():
        return "missing", None, gates, [UPDATE_REPORT, *UPDATE_PHYSICAL_GATES.values()]
    raw = _read_bounded_regular(path, maximum=_MAX_REPORT_BYTES)
    if raw is None:
        return (
            "invalid",
            None,
            gates,
            [f"{UPDATE_REPORT}:readable", *UPDATE_PHYSICAL_GATES.values()],
        )
    digest = hashlib.sha256(raw).hexdigest()
    try:
        report = json.loads(raw)
    except (UnicodeDecodeError, json.JSONDecodeError):
        return (
            "invalid",
            digest,
            gates,
            [f"{UPDATE_REPORT}:valid-json", *UPDATE_PHYSICAL_GATES.values()],
        )
    if not isinstance(report, dict):
        return (
            "invalid",
            digest,
            gates,
            [f"{UPDATE_REPORT}:valid-report", *UPDATE_PHYSICAL_GATES.values()],
        )
    kind = _evidence_kind(report)
    declared_digest = report.get("digest")
    undigested = dict(report)
    undigested.pop("digest", None)
    expected_digest = "sha256:" + hashlib.sha256(canonical(undigested)).hexdigest()
    content_addressed = (
        isinstance(declared_digest, str)
        and _PREFIXED_SHA256.fullmatch(declared_digest) is not None
        and declared_digest == expected_digest
        and raw == canonical(report)
    )
    if not content_addressed:
        missing.append(f"{UPDATE_REPORT}:content-addressed")
    if (
        report.get("schema_version") != 1
        or report.get("report_type") != "dgx-forge-platform-update"
    ):
        missing.append(f"{UPDATE_REPORT}:schema")
    if report.get("status") != "passed":
        missing.append(f"{UPDATE_REPORT}:passed")
    physical = report.get("physical_evidence")
    if not isinstance(physical, dict) or set(physical) != set(UPDATE_PHYSICAL_GATES):
        missing.append(f"{UPDATE_REPORT}:physical-evidence-schema")
        physical = {}
    report_candidate = report.get("candidate")
    release_digest = report.get("release_digest")
    run_id = report.get("run_id")
    physical_binding_valid = False
    if kind == "physical":
        try:
            parsed_run_id = uuid.UUID(str(run_id))
        except ValueError:
            parsed_run_id = None
        physical_binding_valid = (
            report_candidate == candidate
            and isinstance(release_digest, str)
            and _PREFIXED_SHA256.fullmatch(release_digest) is not None
            and isinstance(run_id, str)
            and parsed_run_id is not None
            and parsed_run_id.version == 4
            and str(parsed_run_id) == run_id
        )
        if not physical_binding_valid:
            missing.append(f"{UPDATE_REPORT}:candidate-binding")
        if public_key is None or key_id is None:
            missing.append(f"{UPDATE_REPORT}:trusted-physical-evidence-key")
    if (
        content_addressed
        and kind == "physical"
        and report.get("status") == "passed"
        and physical_binding_valid
        and public_key is not None
        and key_id is not None
    ):
        assert isinstance(release_digest, str)
        assert isinstance(run_id, str)
        physical_claims: dict[str, dict[str, object]] = {}
        for name in UPDATE_PHYSICAL_GATES:
            item = physical.get(name)
            valid_item = (
                isinstance(item, dict)
                and set(item) == {"evidence_sha256", "exercised"}
                and item.get("exercised") is True
                and isinstance(item.get("evidence_sha256"), str)
                and _SHA256.fullmatch(item["evidence_sha256"]) is not None
            )
            if valid_item:
                claims = _physical_artifact_claims(
                    root,
                    name=UPDATE_PHYSICAL_REPORTS[name][0],
                    evidence_type=UPDATE_PHYSICAL_REPORTS[name][1],
                    expected_sha256=item["evidence_sha256"],
                    candidate=candidate,
                    release_digest=release_digest,
                    run_id=run_id,
                    public_key=public_key,
                    key_id=key_id,
                )
            else:
                claims = None
            if claims is not None:
                physical_claims[name] = claims
                gates[name] = True
        manifest_claims = physical_claims.get("signed_platform_update_manifest")
        spark_claims = physical_claims.get("spark_canary_and_rollback")
        if gates["spark_canary_and_rollback"] and not _spark_claim_matches_manifest(
            manifest_claims, spark_claims
        ):
            gates["spark_canary_and_rollback"] = False
    declared_remaining = report.get("remaining_release_gates")
    if isinstance(declared_remaining, list) and all(
        isinstance(item, str) and item for item in declared_remaining
    ):
        missing.extend(declared_remaining)
    else:
        missing.append(f"{UPDATE_REPORT}:remaining-gates")
    missing.extend(
        gate for name, gate in UPDATE_PHYSICAL_GATES.items() if not gates[name]
    )
    return kind, digest, gates, missing


def verify(
    root: Path,
    candidate: str,
    physical_evidence_public_key: Path | None = None,
) -> tuple[dict[str, object], list[str]]:
    missing: list[str] = []
    digests: dict[str, str] = {}
    evidence_kinds: dict[str, str] = {}
    code_host_pr_lifecycle = False
    if _SEMVER.fullmatch(candidate) is None:
        missing.append("candidate-semver")
    for name in REPORTS:
        path = root / f"inventory/reports/{name}.json"
        if not path.is_file():
            missing.append(name)
            continue
        content = _read_bounded_regular(path, maximum=_MAX_REPORT_BYTES)
        if content is None:
            missing.append(f"{name}:readable")
            continue
        digests[name] = hashlib.sha256(content).hexdigest()
        try:
            report = json.loads(content)
        except (UnicodeDecodeError, json.JSONDecodeError):
            missing.append(f"{name}:valid-json")
            continue
        if not isinstance(report, dict):
            evidence_kinds[name] = "invalid"
            missing.append(f"{name}:valid-report")
            continue
        evidence_kinds[name] = _evidence_kind(report)
        if report.get("status") != "passed":
            missing.append(f"{name}:passed")
        remaining = report.get("remaining_release_gates", [])
        if not isinstance(remaining, list) or not all(
            isinstance(gate, str) and gate for gate in remaining
        ):
            missing.append(f"{name}:remaining-gates")
        else:
            missing.extend(remaining)
    protection = root / "inventory/reports/code-host-protection.json"
    if not protection.is_file():
        missing.append("protected-code-host")
    else:
        raw = _read_bounded_regular(protection, maximum=_MAX_REPORT_BYTES)
        if raw is None:
            missing.append("protected-code-host")
        else:
            digests["code-host-protection"] = hashlib.sha256(raw).hexdigest()
        try:
            if raw is None:
                raise ValueError("unsafe or oversized code-host report")
            assertion = json.loads(raw)
            if (
                not isinstance(assertion, dict)
                or assertion.get("status") != "passed"
                or not assertion.get("protected_branch")
                or not assertion.get("required_checks")
            ):
                missing.append("protected-code-host")
            else:
                code_host_pr_lifecycle = _code_host_pr_lifecycle_valid(
                    assertion.get("pr_lifecycle"), assertion.get("required_checks")
                )
        except (ValueError, UnicodeDecodeError, json.JSONDecodeError):
            missing.append("protected-code-host")
    evidence_kinds["code-host-protection"] = "assertion"
    physical_public_key, physical_key_id = _physical_evidence_key(
        physical_evidence_public_key
    )
    update_kind, update_digest, physical_update_gates, update_missing = (
        _update_evidence(root, candidate, physical_public_key, physical_key_id)
    )
    evidence_kinds[UPDATE_REPORT] = update_kind
    if update_digest is not None:
        digests[UPDATE_REPORT] = update_digest
    missing.extend(update_missing)
    workload, workload_kinds, workload_missing = _workload_evidence(root)
    evidence_kinds.update(workload_kinds)
    missing.extend(workload_missing)
    if code_host_pr_lifecycle:
        missing = [
            gate
            for gate in missing
            if gate != "protected-code-host-pr-lifecycle"
        ]
    supply = subprocess.run(
        [root / "scripts/verify-supply-chain", "--root", root, "--json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if supply.returncode != 0:
        missing.append("supply-chain")
    report = {
        "schema_version": 1,
        "candidate": candidate,
        "status": "passed" if not missing else "blocked",
        "evidence_sha256": dict(sorted(digests.items())),
        "evidence_kinds": dict(sorted(evidence_kinds.items())),
        "physical_evidence_key_id": physical_key_id,
        "physical_update_gates": physical_update_gates,
        "workload_packages": workload,
        "missing_gates": sorted(set(missing)),
    }
    report["digest"] = hashlib.sha256(canonical(report)).hexdigest()
    return report, missing


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--candidate", required=True)
    parser.add_argument(
        "--root", type=Path, default=Path(__file__).resolve().parents[1]
    )
    parser.add_argument("--output", type=Path)
    parser.add_argument("--physical-evidence-public-key", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    report, missing = verify(
        args.root.resolve(),
        args.candidate,
        (
            (
                args.physical_evidence_public_key
                if args.physical_evidence_public_key.is_absolute()
                else Path.cwd() / args.physical_evidence_public_key
            )
            if args.physical_evidence_public_key is not None
            else None
        ),
    )
    content = canonical(report)
    if args.output:
        target = args.output if args.output.is_absolute() else args.root / args.output
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(content)
    if args.json or not args.output:
        print(content.decode(), end="")
    return 2 if missing else 0


if __name__ == "__main__":
    raise SystemExit(main())
