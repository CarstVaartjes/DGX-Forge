#!/usr/bin/env python3
"""Exercise portable backup/restore primitives and emit sanitized evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import sys
import tempfile
from datetime import UTC, datetime
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "control/src"))

from vonk_control.offline import create_backup, extract_backup, inspect_backup  # noqa: E402


def canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def accept(source_date_epoch: int) -> dict[str, object]:
    with tempfile.TemporaryDirectory(prefix="vonk-recovery-") as raw:
        workspace = Path(raw)
        source = workspace / "source-host"
        target = workspace / "replacement-host"
        source.mkdir(mode=0o700)
        database = source / "database.dump"
        config = source / "compose-config.json"
        database.write_bytes(b"users=2\njobs=3\naudit=7\nroute=published\n")
        config.write_bytes(b'{"repository_commit":"0123456789abcdef","schema":1}\n')
        backup = workspace / "control.backup"

        # /bin/cat is an intentionally transparent test transform. Production
        # scripts require an authenticated encryption/decryption command.
        create_backup(database, (config,), backup, encrypt_command=("/bin/cat",))
        manifest = inspect_backup(backup, decrypt_command=("/bin/cat",))
        extract_backup(backup, target, decrypt_command=("/bin/cat",))
        restored_database = (target / database.name).read_bytes()
        restored_config = (target / config.name).read_bytes()
        route_before_health = "maintenance"
        integrity_ok = restored_database == database.read_bytes() and restored_config == config.read_bytes()
        return {
            "schema_version": 1,
            "generated_at": datetime.fromtimestamp(source_date_epoch, UTC).isoformat().replace("+00:00", "Z"),
            "environment": "disposable-filesystem",
            "production_encryption_exercised": False,
            "physical_replacement_host_exercised": False,
            "source_version": "pre-release",
            "target_version": "pre-release",
            "backup_sha256": hashlib.sha256(backup.read_bytes()).hexdigest(),
            "manifest_file_count": len(manifest["files"]),
            "restore_integrity": "passed" if integrity_ok else "failed",
            "migration_result": "covered-by-control-migration-tests",
            "audit_record_count": 7,
            "repository_commit": "0123456789abcdef",
            "route_before_health": route_before_health,
            "route_after_health": "published" if integrity_ok else "maintenance",
            "status": "passed" if integrity_ok and route_before_health == "maintenance" else "failed",
            "remaining_release_gates": ["authenticated-encryption-drill", "physical-replacement-host-drill"],
        }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--output", type=Path)
    parser.add_argument("--source-date-epoch", type=int, default=int(os.environ.get("SOURCE_DATE_EPOCH", "0")))
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    report = accept(args.source_date_epoch)
    content = canonical(report)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        print(content.decode(), end="")
    return 0 if report["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
