#!/usr/bin/env python3
"""Emit deterministic, explicitly simulated GPU node-agent lifecycle evidence."""

from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if os.environ.get("VONK_AGENT_SIMULATOR_LOCKED_ENV") != "1":
    environment = dict(os.environ)
    environment["VONK_AGENT_SIMULATOR_LOCKED_ENV"] = "1"
    environment.pop("VIRTUAL_ENV", None)
    raise SystemExit(
        subprocess.run(
            [
                "uv",
                "run",
                "--quiet",
                "--project",
                str(ROOT / "agent"),
                "python",
                __file__,
                *sys.argv[1:],
            ],
            env=environment,
            check=False,
        ).returncode
    )

sys.path.insert(0, str(ROOT / "agent/src"))

from vonk_agent.simulator import (
    acceptance_argument_parser,
    canonical_report,
    simulate_agent_lifecycle,
    validate_cli_fleet_size,
)


def main() -> int:
    parser = acceptance_argument_parser()
    args = parser.parse_args()

    try:
        validate_cli_fleet_size(
            nodes=args.nodes,
            allow_large_fleet=args.allow_large_fleet,
        )
        report = simulate_agent_lifecycle(nodes=args.nodes, seed=args.seed)
    except (TypeError, ValueError) as error:
        parser.error(str(error))
    content = canonical_report(report)
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        sys.stdout.buffer.write(content)
    return 0 if report["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
