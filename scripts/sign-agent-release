#!/usr/bin/python3
"""Create deterministic Ed25519 slot manifests and helper artifact signature."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import struct
import subprocess
import tempfile
from pathlib import Path

MANIFEST_DOMAIN = b"VONK-AGENT-SLOT-MANIFEST-V1\x00"
ARTIFACT_DOMAIN = b"VONK-HOST-ARTIFACT-V1\x00agent\x00"
SPKI_PREFIX = bytes.fromhex("302a300506032b6570032100")
MAX_ARTIFACT_BYTES = 512 * 1024 * 1024


class SigningError(RuntimeError):
    pass


def checked_file(path: Path, maximum: int, *, private: bool = False) -> bytes:
    metadata = path.lstat()
    if (
        not stat.S_ISREG(metadata.st_mode)
        or metadata.st_nlink != 1
        or not 1 <= metadata.st_size <= maximum
        or metadata.st_mode & 0o022
        or (private and metadata.st_mode & 0o077)
    ):
        raise SigningError(f"unsafe input: {path}")
    before = (metadata.st_dev, metadata.st_ino, metadata.st_size, metadata.st_mtime_ns)
    raw = path.read_bytes()
    after_metadata = path.stat()
    after = (
        after_metadata.st_dev,
        after_metadata.st_ino,
        after_metadata.st_size,
        after_metadata.st_mtime_ns,
    )
    if before != after:
        raise SigningError(f"input changed while read: {path}")
    return raw


def openssl(argv: list[str], *, input_bytes: bytes | None = None) -> bytes:
    completed = subprocess.run(
        ["/usr/bin/openssl", *argv],
        input=input_bytes,
        capture_output=True,
        cwd="/",
        env={"LANG": "C.UTF-8", "LC_ALL": "C.UTF-8", "PATH": "/usr/bin:/bin"},
        timeout=15,
        check=False,
    )
    if completed.returncode != 0:
        raise SigningError("OpenSSL rejected the release signing operation")
    return completed.stdout


def signature(private_key: Path, message: bytes) -> bytes:
    with tempfile.NamedTemporaryFile(prefix="vonk-signing-", mode="w+b") as source:
        source.write(message)
        source.flush()
        value = openssl(
            [
                "pkeyutl",
                "-sign",
                "-inkey",
                str(private_key),
                "-rawin",
                "-in",
                source.name,
            ]
        )
    if len(value) != 64:
        raise SigningError("release signature is invalid")
    return value


def atomic_write(path: Path, raw: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.new")
    descriptor = os.open(
        temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, mode
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)
    os.replace(temporary, path)
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC)
    try:
        os.fsync(directory)
    finally:
        os.close(directory)


def sign(
    artifact: Path,
    private_key: Path,
    output: Path,
    writes_schema: int,
    minimum_schema: int,
    maximum_schema: int,
) -> dict[str, object]:
    artifact_raw = checked_file(artifact, MAX_ARTIFACT_BYTES)
    checked_file(private_key, 16 * 1024, private=True)
    if (
        len(artifact_raw) < 64
        or artifact_raw[:7] != b"\x7fELF\x02\x01\x01"
        or struct.unpack_from("<H", artifact_raw, 18)[0] != 183
    ):
        raise SigningError("agent artifact is not AArch64 ELF")
    if not 1 <= minimum_schema <= writes_schema <= maximum_schema <= 2**31 - 1:
        raise SigningError("state schema compatibility is invalid")
    public_der = openssl(
        ["pkey", "-in", str(private_key), "-pubout", "-outform", "DER"]
    )
    if (
        not public_der.startswith(SPKI_PREFIX)
        or len(public_der) != len(SPKI_PREFIX) + 32
    ):
        raise SigningError("release key is not Ed25519")
    public_key = public_der[len(SPKI_PREFIX) :]
    key_id = hashlib.sha256(public_key).hexdigest()
    digest = hashlib.sha256(artifact_raw).hexdigest()
    for slot in ("a", "b"):
        claims = {
            "architecture": "aarch64",
            "artifact_sha256": digest,
            "artifact_size": len(artifact_raw),
            "max_readable_state_schema": maximum_schema,
            "min_readable_state_schema": minimum_schema,
            "schema_version": 1,
            "slot": slot,
            "writes_state_schema": writes_schema,
        }
        signing = (
            MANIFEST_DOMAIN
            + json.dumps(claims, sort_keys=True, separators=(",", ":")).encode()
        )
        document = {
            "claims": claims,
            "schema_version": 1,
            "signature": {
                "algorithm": "ed25519",
                "key_id": key_id,
                "value": signature(private_key, signing).hex(),
            },
        }
        atomic_write(
            output / f"manifest-{slot}.json",
            json.dumps(document, sort_keys=True, separators=(",", ":")).encode(),
            0o644,
        )
    artifact_signature = signature(private_key, ARTIFACT_DOMAIN + bytes.fromhex(digest))
    atomic_write(
        output / "artifact.sig", artifact_signature.hex().encode() + b"\n", 0o644
    )
    atomic_write(output / "release.pub", public_key.hex().encode() + b"\n", 0o644)
    return {"artifact_sha256": digest, "key_id": key_id}


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--artifact", type=Path, required=True)
    parser.add_argument("--private-key", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    parser.add_argument("--writes-state-schema", type=int, default=1)
    parser.add_argument("--min-readable-state-schema", type=int, default=1)
    parser.add_argument("--max-readable-state-schema", type=int, default=1)
    arguments = parser.parse_args()
    result = sign(
        arguments.artifact.absolute(),
        arguments.private_key.absolute(),
        arguments.output.absolute(),
        arguments.writes_state_schema,
        arguments.min_readable_state_schema,
        arguments.max_readable_state_schema,
    )
    print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
