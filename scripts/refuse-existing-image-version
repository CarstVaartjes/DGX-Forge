#!/usr/bin/env python3
"""Fail closed unless every requested container version is known to be absent."""

from __future__ import annotations

import re
import subprocess
import sys
from collections.abc import Sequence

VERSION = re.compile(r"^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$")
IMAGE = re.compile(r"^[a-z0-9.-]+(?::[0-9]+)?/[a-z0-9._/-]+$")


def normalized(output: str) -> str:
    return "\n".join(line.strip() for line in output.splitlines() if line.strip())


def known_absent(reference: str, output: str, error: str) -> bool:
    return not normalized(output) and normalized(error) == f"ERROR: {reference}: not found"


def main(argv: Sequence[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    if len(arguments) < 2:
        print("release image version check is invalid", file=sys.stderr)
        return 64
    version, *images = arguments
    if VERSION.fullmatch(version) is None or any(
        IMAGE.fullmatch(image) is None for image in images
    ):
        print("release image version check is invalid", file=sys.stderr)
        return 64

    for image in images:
        reference = f"{image}:{version}"
        try:
            result = subprocess.run(
                ["docker", "buildx", "imagetools", "inspect", reference],
                check=False,
                capture_output=True,
                text=True,
                encoding="utf-8",
                errors="replace",
            )
        except OSError:
            print(f"unable to establish release image absence: {reference}", file=sys.stderr)
            return 1
        if result.returncode == 0:
            print(f"release image already exists: {reference}", file=sys.stderr)
            return 1
        if not known_absent(reference, result.stdout, result.stderr):
            print(f"unable to establish release image absence: {reference}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
