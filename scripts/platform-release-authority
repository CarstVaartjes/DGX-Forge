#!/usr/bin/env python3
"""Publish platform release state through the delegated GitHub OIDC authority."""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
from pathlib import Path

repository_src = Path(__file__).resolve().parents[1] / "src"
if str(repository_src) not in sys.path:
    sys.path.insert(0, str(repository_src))

from spark_profiles.platform_authority_client import (
    AuthorityError,
    DelegatedPlatformAuthority,
    github_actions_oidc_token,
)

_MAX_TARGET_BYTES = 1024 * 1024
_MAX_CHANNEL_BYTES = 64 * 1024


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read_regular(path: Path, limit: int) -> bytes:
    try:
        descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    except OSError as error:
        raise AuthorityError("publication input is unsafe") from error
    try:
        details = os.fstat(descriptor)
        if (
            not stat.S_ISREG(details.st_mode)
            or details.st_nlink != 1
            or not 0 < details.st_size <= limit
        ):
            raise AuthorityError("publication input is unsafe")
        chunks: list[bytes] = []
        remaining = details.st_size
        while remaining:
            chunk = os.read(descriptor, min(remaining, 1024 * 1024))
            if not chunk:
                raise AuthorityError("publication input changed while read")
            chunks.append(chunk)
            remaining -= len(chunk)
        return b"".join(chunks)
    finally:
        os.close(descriptor)


def _authority() -> DelegatedPlatformAuthority:
    names = (
        "DGX_PLATFORM_AUTHORITY_URL",
        "DGX_PLATFORM_AUTHORITY_AUDIENCE",
        "ACTIONS_ID_TOKEN_REQUEST_URL",
        "ACTIONS_ID_TOKEN_REQUEST_TOKEN",
    )
    values = {name: os.environ.get(name) for name in names}
    if any(not value for value in values.values()):
        raise AuthorityError("delegated authority configuration is incomplete")
    return DelegatedPlatformAuthority(
        values["DGX_PLATFORM_AUTHORITY_URL"] or "",
        token=lambda: github_actions_oidc_token(
            values["ACTIONS_ID_TOKEN_REQUEST_URL"] or "",
            values["ACTIONS_ID_TOKEN_REQUEST_TOKEN"] or "",
            values["DGX_PLATFORM_AUTHORITY_AUDIENCE"] or "",
        ),
    )


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="platform-release-authority")
    subcommands = parser.add_subparsers(dest="command", required=True)
    target = subcommands.add_parser("publish-target")
    target.add_argument("--target-name", required=True)
    target.add_argument("--target-sha256", required=True)
    target.add_argument("--target-file", required=True, type=Path)
    target.add_argument("--retain-target", action="append", default=[])
    channel = subcommands.add_parser("publish-channel")
    channel.add_argument("--channel", required=True)
    channel.add_argument("--document", required=True, type=Path)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    try:
        if args.command == "publish-target":
            raw = _read_regular(args.target_file, _MAX_TARGET_BYTES)
            result = _authority().publish_target(
                args.target_name,
                args.target_sha256,
                raw,
                args.retain_target,
            )
        else:
            raw = _read_regular(args.document, _MAX_CHANNEL_BYTES)
            result = _authority().publish_channel(args.channel, raw)
    except AuthorityError as error:
        print(f"platform-release-authority: {error}", file=sys.stderr)
        return 2
    print(_canonical(result).decode(), end="")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
