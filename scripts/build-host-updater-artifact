#!/usr/bin/env python3
"""Build the deterministic offline wheel closure for the root host updater."""

from __future__ import annotations

import argparse
import hashlib
import io
import json
import os
import re
import stat
import sys
import tarfile
from pathlib import Path


_WHEEL = re.compile(
    r"(?:dgx_control-0\.1\.0|spark_profiles-0\.1\.0|"
    r"dgx_agent_protocol-2\.1\.0)-py3-none-any\.whl\Z"
)
_MAX_WHEEL = 256 * 1024 * 1024


class ArtifactError(RuntimeError):
    pass


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read(path: Path) -> bytes:
    if _WHEEL.fullmatch(path.name) is None:
        raise ArtifactError("host updater wheel identity is invalid")
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or not 0 < before.st_size <= _MAX_WHEEL
        ):
            raise ArtifactError("host updater wheel is unsafe")
        raw = b""
        while len(raw) < before.st_size:
            chunk = os.read(descriptor, min(1024 * 1024, before.st_size - len(raw)))
            if not chunk:
                raise ArtifactError("host updater wheel changed")
            raw += chunk
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            raise ArtifactError("host updater wheel changed")
        return raw
    finally:
        os.close(descriptor)


def _member(name: str, raw: bytes) -> tarfile.TarInfo:
    info = tarfile.TarInfo(name)
    info.size = len(raw)
    info.mode = 0o444
    info.uid = 0
    info.gid = 0
    info.uname = ""
    info.gname = ""
    info.mtime = 0
    return info


def _write_new(path: Path, raw: bytes) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    try:
        offset = 0
        while offset < len(raw):
            offset += os.write(descriptor, raw[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="build-host-updater-artifact")
    parser.add_argument("--control-wheel", required=True, type=Path)
    parser.add_argument("--platform-wheel", required=True, type=Path)
    parser.add_argument("--protocol-wheel", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)
    try:
        paths = (args.control_wheel, args.platform_wheel, args.protocol_wheel)
        if len({path.name for path in paths}) != 3:
            raise ArtifactError("host updater wheel closure overlaps")
        contents = {path.name: _read(path) for path in paths}
        manifest = _canonical(
            {
                "entry_point": "dgx-control-offline",
                "install_mode": "offline-wheel-closure",
                "schema_version": 1,
                "wheels": {
                    name: hashlib.sha256(raw).hexdigest()
                    for name, raw in sorted(contents.items())
                },
            }
        )
        contents["host-updater.json"] = manifest
        output = io.BytesIO()
        with tarfile.open(fileobj=output, mode="w", format=tarfile.USTAR_FORMAT) as tar:
            for name, raw in sorted(contents.items()):
                tar.addfile(_member(name, raw), io.BytesIO(raw))
        _write_new(args.output, output.getvalue())
    except (ArtifactError, OSError) as error:
        print(f"build-host-updater-artifact: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
