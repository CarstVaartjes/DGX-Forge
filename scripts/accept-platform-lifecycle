#!/usr/bin/env python3
"""Exercise the repository-to-profile lifecycle without touching hardware."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import tempfile
from datetime import UTC, datetime, timedelta
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
if os.environ.get("DGX_LIFECYCLE_LOCKED_ENV") != "1":
    environment = dict(os.environ)
    environment["DGX_LIFECYCLE_LOCKED_ENV"] = "1"
    raise SystemExit(subprocess.run(["uv", "run", "--project", str(ROOT / "control"), "--with", "jsonschema==4.26.0", "python", __file__, *sys.argv[1:]], env=environment, check=False).returncode)
sys.path[:0] = [str(ROOT / "src"), str(ROOT / "control/src")]

from dgx_control.agent_jobs import AgentJobService
from dgx_control.agent_reconciliation import AgentReconciliationService
from dgx_control.auth import AgentIdentity, AgentSource
from dgx_control.desired_state import (
    DesiredStateObservation,
    DesiredStateResolver,
    durable_desired_state_observations,
)
from dgx_control.git_policy import Eligibility
from dgx_control.jobs import JobService
from dgx_control.models import AgentCertificate, AgentNode, Base
from dgx_control.orchestration import ReconciliationOrchestrator
from dgx_control.presence import AgentPresenceService, ManagementAddressPolicy
from dgx_control.reconcile import Reconciler
from dgx_control.repository import RepositoryService
from dgx_control.route_runtime import (
    AtomicRouteBundlePublisher,
    FileSupervisorAcknowledger,
)
from sqlalchemy import create_engine
from sqlalchemy.orm import sessionmaker

from spark_profiles.fleet import ManagementEndpoint, NodeId
from spark_profiles.fleet.install_contracts import InstallationRequest
from spark_profiles.install.orchestrator import (
    FileEvidenceStore,
    NodeInstaller,
    StepResult,
)
from spark_profiles.install.proposal import build_node_proposal
from spark_profiles.install.store import InstallStore

STEPS = ("identity", "pre-inventory", "public-key", "ssh-hardening", "node-policy", "post-inventory", "acceptance")


class Policy:
    def eligible(self, commit: str) -> Eligibility:
        return Eligibility(commit, True, ())


CAPABILITIES = (
    "node.probe",
    "release.install",
    "workload.health",
    "workload.prepare",
    "workload.start",
    "workload.stop",
    "workload.verify",
)


def _operation_result(claim) -> dict[str, object]:
    if claim.operation.value == "node.probe":
        evidence = {
            "dgx_forge": {
                "schema_version": 1,
                "memory": {"available_bytes": 1_000, "total_bytes": 4_000},
                "storage": {"available_bytes": 2_000, "total_bytes": 8_000},
                "accelerator": {
                    "available": True,
                    "active_nvidia_compute_processes": 0,
                },
            },
            "nvidia": {"tools": {}},
        }
    elif claim.operation.value == "release.install":
        evidence = {
            "status": "installed",
            "release_digest": claim.payload["target_digest"],
            "manifest_digest": claim.payload["oci_manifest_digest"],
            "adapter_id": claim.payload["adapter_id"],
        }
    else:
        action = claim.operation.value.removeprefix("workload.")
        evidence = {
            "status": {
                "prepare": "prepared",
                "start": "started",
                "stop": "stopped",
                "health": "healthy",
                "verify": "verified",
            }[action],
            "action": action,
            "workload_id": claim.payload["workload_id"],
            "release_digest": claim.payload["release_digest"],
            "evidence_digest": claim.payload.get("expected_digest", "f" * 64),
        }
    return {"status": "ok", "evidence": evidence}


def _drive_reconciliation(
    service: AgentReconciliationService,
    operations: AgentJobService,
    sessions,
    reconciliation_id: str,
    node_id: str,
) -> int:
    claimed = 0
    for _ in range(128):
        advanced = service.tick(reconciliation_id)
        claim = operations.claim(
            node_id,
            "simulated-certificate",
            30,
            protocol_version=1,
            capabilities=CAPABILITIES,
        )
        if claim is not None:
            operations.succeed(claim, _operation_result(claim))
            claimed += 1
            continue
        with sessions() as session:
            from dgx_control.models import Reconciliation

            reconciliation = session.get(Reconciliation, reconciliation_id)
            if reconciliation is not None and reconciliation.current_phase == "completed":
                return claimed
        if not advanced:
            raise RuntimeError("production reconciliation service made no progress")
    raise RuntimeError("production reconciliation service exceeded its phase bound")


def _git(root: Path, *arguments: str) -> str:
    return subprocess.run(
        ["git", "-C", str(root), *arguments],
        check=True,
        capture_output=True,
        text=True,
        env=os.environ
        | {
            "GIT_AUTHOR_NAME": "Lifecycle Acceptance",
            "GIT_AUTHOR_EMAIL": "lifecycle@example.invalid",
            "GIT_COMMITTER_NAME": "Lifecycle Acceptance",
            "GIT_COMMITTER_EMAIL": "lifecycle@example.invalid",
        },
    ).stdout.strip()


def _repository(workspace: Path, node_id: str, host: str, display_name: str) -> tuple[RepositoryService, str]:
    root = workspace / "model-repository"
    host_literal = json.dumps(host)
    display_name_literal = json.dumps(display_name)
    documents: dict[str, str] = {
        "inventory/fleet.toml": f'''schema_version = 2

[nodes."{node_id}"]
display_name = {display_name_literal}
hostname = {host_literal}
lifecycle = "ready"

[nodes."{node_id}".management]
host = {host_literal}
user = "operator"
port = 22

[nodes."{node_id}".labels]
pool = "default"
''',
        "inventory/topology.json": json.dumps({"schema_version": 1, "nodes": [node_id], "links": []}),
        "inventory/reports/inference.json": json.dumps({"schema_version": 1, "accepted": True}),
        "config/cluster-profiles/inference.toml": f'''schema_version = 2
id = "inference"
accepted_evidence = "inventory/reports/inference.json"
workloads = ["test-model"]

[[requirements]]
workload = "test-model"
definition_hash = "{'d' * 64}"
node_count = 1
min_memory_bytes = 100
min_disk_bytes = 200
exclusive = true
distributed_supported = true

[requirements.required_labels]
pool = "default"

[endpoints]
chat = "test-model"

[quotas.chat]
requests_per_minute = 30
tokens_per_minute = 10000

[lifecycle]
start_order = "independent"
stop_order = "independent"
''',
        "config/workloads/test-model.toml": f'''schema_version = 2
id = "test-model"
adapter = "spark-runtime-v1"
definition_hash = "{'d' * 64}"
conflicts = []
distributed_supported = true
''',
    }
    workload_requests = {}
    for action, extra in {
        "prepare": {"profile_digest": "c" * 64},
        "start": {"preparation_digest": "c" * 64},
        "stop": {},
        "health": {},
        "verify": {"expected_digest": "e" * 64},
    }.items():
        workload_requests[action] = {
            "schema_version": 1,
            "workload_id": "test-model",
            "release_digest": "a" * 64,
            "adapter_id": "spark-runtime-v1",
        } | extra
    documents["manifests/releases/test-model.json"] = json.dumps(
        {
            "schema_version": 1,
            "workload_id": "test-model",
            "definition_hash": "d" * 64,
            "release_request": {
                "schema_version": 1,
                "target_name": "test-model",
                "oci_manifest_digest": "sha256:" + "9" * 64,
                "target_digest": "a" * 64,
                "provenance_digest": "b" * 64,
                "adapter_id": "spark-runtime-v1",
            },
            "workload_requests": workload_requests,
            "endpoint": {"scheme": "http", "port": 8000, "path": "/v1"},
        }
    )
    for path, content in documents.items():
        target = root / path
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(content)
    _git(root, "init", "-q")
    _git(root, "add", ".")
    _git(root, "commit", "-qm", "repository lifecycle fixture")
    return RepositoryService(root), _git(root, "rev-parse", "HEAD")


def run(host: str, display_name: str) -> dict[str, object]:
    node_id = NodeId.parse("spk_00000000000000000000000000000001")
    with tempfile.TemporaryDirectory(prefix="dgx-lifecycle-") as raw:
        workspace = Path(raw)
        now = datetime(2026, 8, 3, tzinfo=UTC)
        handler = lambda _request: StepResult(b"accepted", b"")
        installer = NodeInstaller(
            store=InstallStore(workspace / "install-state", clock=lambda: now),
            evidence_store=FileEvidenceStore(workspace / "install-evidence"),
            handlers={step: handler for step in STEPS},
            clock=lambda: now,
        )
        request = InstallationRequest(node_id, display_name, ManagementEndpoint(host, "operator", credential_ref="secret://ssh/admin"), {"pool": "default"})
        installer.start(request)
        journal = installer.run(node_id)
        proposal = build_node_proposal("0" * 40, journal, {"hostname": host})
        repository, commit = _repository(workspace, node_id.value, host, display_name)
        audit = [f"install:{journal.state}", f"proposal:{proposal.sha256}", f"merge:{commit}"]

        engine = create_engine(f"sqlite:///{workspace / 'control.sqlite'}")
        Base.metadata.create_all(engine)
        sessions = sessionmaker(engine, expire_on_commit=False)
        with sessions.begin() as session:
            session.add(
                AgentNode(
                    node_id=node_id.value,
                    state="active",
                    protocol_version=1,
                    capabilities=list(CAPABILITIES),
                    last_seen_at=now,
                )
            )
            session.add(
                AgentCertificate(
                    serial="simulated-certificate",
                    node_id=node_id.value,
                    not_before=now,
                    not_after=now.replace(year=2027),
                    fingerprint="simulated-fingerprint",
                    state="active",
                    generation=1,
                )
            )
        observation = DesiredStateObservation(
            node_id=node_id.value,
            observed_at=now,
            healthy=True,
            memory_available_bytes=1_000,
            disk_available_bytes=2_000,
            memory_total_bytes=4_000,
            disk_total_bytes=8_000,
            occupied=False,
            agent_state="active",
            protocol_version=1,
            capabilities=CAPABILITIES,
            compute_occupancy="clean",
        )
        jobs = JobService(sessions, clock=lambda: now)
        orchestrator = ReconciliationOrchestrator(sessions, clock=lambda: now)
        reconciler = Reconciler(
            Policy(),
            DesiredStateResolver(repository, clock=lambda: now),
            jobs=jobs,
            observations=lambda: (observation,),
            orchestrator=orchestrator,
        )
        plan = reconciler.plan(commit, "inference")
        queued = reconciler.enqueue(plan.digest, "administrator", "lifecycle-reconcile")
        assert plan.operation_graph is not None
        management_policy = ManagementAddressPolicy.parse("192.0.2.0/24")
        presence = AgentPresenceService(
            sessions, management_policy, clock=lambda: now
        )
        identity = AgentIdentity(
            node_id.value,
            "simulated-certificate",
            "simulated-fingerprint",
            True,
        )
        presence.observe(AgentSource(identity, "192.0.2.10"))
        ack_path = workspace / "supervisor/ack.json"
        ack_path.parent.mkdir(mode=0o750)
        ack_validator = FileSupervisorAcknowledger(
            ack_path, clock=lambda: now
        )

        def acknowledge(marker) -> None:
            acknowledgement = {
                "acknowledged_at": now.isoformat(),
                "activation_sha256": marker.digest,
                "child_pid": os.getpid(),
                "expires_at": marker.expires_at,
                "generation": marker.generation,
                "litellm_sha256": marker.litellm_sha256,
                "schema_version": 1,
                "state": marker.state,
            }
            temporary = ack_path.with_suffix(".tmp")
            temporary.write_text(
                json.dumps(
                    acknowledgement, sort_keys=True, separators=(",", ":")
                )
                + "\n"
            )
            os.replace(temporary, ack_path)
            ack_validator(marker)

        route_runtime = AtomicRouteBundlePublisher(
            workspace / "route-runtime",
            management_policy=management_policy,
            clock=lambda: now,
            maximum_lease_seconds=300,
            await_supervisor_ack=acknowledge,
        )
        operations = AgentJobService(sessions, clock=lambda: now)

        def endpoint(session, target: str):
            observed = presence.latest_in_session(
                session, target, maximum_age_seconds=300
            )
            return observed.address, observed.observed_at

        current_commit = [commit]
        execution = AgentReconciliationService(
            sessions,
            agent_jobs=operations,
            publisher=route_runtime,
            endpoint_resolver=endpoint,
            clock=lambda: now,
            commit_eligible=lambda _commit: True,
            current_commit=lambda: current_commit[0],
        )
        operations.set_result_consumer(execution.consume_result)
        claimed = _drive_reconciliation(
            execution,
            operations,
            sessions,
            plan.operation_graph.reconciliation_id,
            node_id.value,
        )

        # A periodic post-start probe observes the now-running managed workload.
        # Keep it later than the pre-mutation zero-compute gate so durable replay
        # cannot mistake the gate evidence for the current runtime state.
        now += timedelta(seconds=1)
        probe_job = jobs.enqueue(
            "node-probe",
            "administrator",
            commit,
            [node_id.value],
            {},
            request_id="lifecycle-probe",
        )
        operations.enqueue(probe_job.id, node_id.value, "node.probe", commit, {})
        probe = operations.claim(node_id.value, "simulated-certificate", 30)
        assert probe is not None
        operations.succeed(
            probe,
            {
                "status": "ok",
                "evidence": {
                    "dgx_forge": {
                        "schema_version": 1,
                        "memory": {
                            "available_bytes": 1_000,
                            "total_bytes": 4_000,
                        },
                        "storage": {
                            "available_bytes": 2_000,
                            "total_bytes": 8_000,
                        },
                        "accelerator": {
                            "available": True,
                            "active_nvidia_compute_processes": 1,
                        },
                    },
                    "nvidia": {"tools": {}},
                },
            },
        )
        claimed += 1
        durable = durable_desired_state_observations(sessions)
        assert len(durable) == 1 and len(durable[0].current_workloads) == 1
        first_current = durable[0].current_workloads[0]
        assert first_current.release_digest == "a" * 64
        manifest_path = repository.root / "manifests/releases/test-model.json"
        replacement = json.loads(manifest_path.read_text())
        replacement["release_request"]["target_digest"] = "7" * 64
        for request_payload in replacement["workload_requests"].values():
            request_payload["release_digest"] = "7" * 64
        manifest_path.write_text(
            json.dumps(replacement, sort_keys=True, separators=(",", ":"))
        )
        _git(repository.root, "add", ".")
        _git(repository.root, "commit", "-qm", "replace release A with B")
        replacement_commit = _git(repository.root, "rev-parse", "HEAD")
        replacement_reconciler = Reconciler(
            Policy(),
            DesiredStateResolver(repository, clock=lambda: now),
            jobs=jobs,
            observations=lambda: durable,
            orchestrator=orchestrator,
        )
        replacement_plan = replacement_reconciler.plan(
            replacement_commit, "inference"
        )
        replacement_job = replacement_reconciler.enqueue(
            replacement_plan.digest,
            "administrator",
            "lifecycle-reconcile-replacement",
        )
        assert replacement_plan.operation_graph is not None
        current_commit[0] = replacement_commit
        replacement_claimed = _drive_reconciliation(
            execution,
            operations,
            sessions,
            replacement_plan.operation_graph.reconciliation_id,
            node_id.value,
        )
        replaced_durable = durable_desired_state_observations(sessions)
        assert (
            len(replaced_durable) == 1
            and len(replaced_durable[0].current_workloads) == 1
            and replaced_durable[0].current_workloads[0].release_digest == "7" * 64
        )
        current = replaced_durable[0].current_workloads[0]
        claimed += replacement_claimed
        audit.extend(
            (
                f"plan:{plan.digest}",
                f"persist:{plan.operation_graph.reconciliation_id}",
                f"replace-commit:{replacement_commit}",
                f"replace-plan:{replacement_plan.digest}",
                f"replace-persist:{replacement_plan.operation_graph.reconciliation_id}",
                f"claims:{claimed}",
                "probe:observed",
                "release:a-to-b",
            )
        )

        published = route_runtime.inspect()
        audit.append("routes:published")
        served_status = 200 if published.state == "published" else 503
        withdrawn = route_runtime.withdraw(
            reconciliation_id=replacement_plan.operation_graph.reconciliation_id,
            plan_digest=replacement_plan.digest,
            targets=(node_id.value,),
            reason="profile withdrawn",
        )
        audit.append("routes:withdrawn")
        withdrawn_status = 503 if withdrawn.state == "maintenance" else 200
        ok = journal.state == "accepted" and durable[0].occupied and served_status == 200 and withdrawn_status == 503
        return {
            "schema_version": 1, "environment": "simulated-node-and-code-host", "status": "passed" if ok else "failed",
            "dynamic_input": {"host": host, "display_name": display_name}, "node_id": node_id.value,
            "installation_state": journal.state, "installation_gate_count": len(journal.steps),
            "proposal_sha256": proposal.sha256, "eligible_commit": replacement_commit, "profile_source": "model-repository/revision",
            "reconciliation": "succeeded", "route_generation": published.generation, "litellm_generation": published.generation,
            "planner": "DesiredStateResolver",
            "persisted_operation_count": len(plan.operation_graph.nodes) + len(replacement_plan.operation_graph.nodes),
            "claimed_operation_count": claimed,
            "release_transition": {"from": "a" * 64, "to": "7" * 64},
            "durable_observation": {
                "current_workload": current.workload_id,
                "current_release": current.release_digest,
                "occupied": durable[0].occupied,
            },
            "served_status": served_status, "withdrawn_status": withdrawn_status, "audit_events": audit,
            "physical_spark_exercised": False, "code_host_pr_merge_exercised": False,
            "remaining_release_gates": ["approved-physical-spark-lifecycle", "protected-code-host-pr-lifecycle"],
        }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--host", default="new-spark.local")
    parser.add_argument("--display-name", default="new-spark")
    parser.add_argument("--output", type=Path)
    parser.add_argument("--json", action="store_true")
    args = parser.parse_args()
    report = run(args.host, args.display_name)
    content = (json.dumps(report, sort_keys=True, separators=(",", ":")) + "\n").encode()
    if args.output:
        args.output.parent.mkdir(parents=True, exist_ok=True)
        args.output.write_bytes(content)
    if args.json or not args.output:
        print(content.decode(), end="")
    return 0 if report["status"] == "passed" else 1


if __name__ == "__main__":
    raise SystemExit(main())
