#!/usr/bin/env python3
"""Build one canonical Vonk Forge control deployment bundle."""

from __future__ import annotations

import argparse
import hashlib
import os
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))

from cluster_profiles.deployment_bundle import (
    DeploymentBundleError,
    build_deployment_bundle,
)


def _write_new(path: Path, content: bytes) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    try:
        offset = 0
        while offset < len(content):
            offset += os.write(descriptor, content[offset:])
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="build-control-deployment-bundle")
    parser.add_argument("--source-root", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args(argv)
    try:
        raw = build_deployment_bundle(args.source_root)
        _write_new(args.output, raw)
    except (DeploymentBundleError, OSError) as error:
        print(f"build-control-deployment-bundle: {error}", file=sys.stderr)
        return 2
    print("sha256:" + hashlib.sha256(raw).hexdigest())
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
