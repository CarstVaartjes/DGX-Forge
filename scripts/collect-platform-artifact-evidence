#!/usr/bin/env python3
"""Bind one published OCI manifest to canonical SBOM/provenance evidence."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path


_REFERENCE = re.compile(r"[^\s]{1,1900}@sha256:(?P<digest>[0-9a-f]{64})\Z")
_LOCATOR = re.compile(
    r"(?:control\.images\.(?:api|worker)|control\.assets\.[a-z0-9][a-z0-9._-]{0,126})\Z"
)
_NAME = re.compile(r"[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?\Z")
_MAX_MANIFEST = 16 * 1024 * 1024
_MAX_EVIDENCE = 16 * 1024 * 1024


class EvidenceError(RuntimeError):
    pass


def _canonical(value: object) -> bytes:
    return (json.dumps(value, sort_keys=True, separators=(",", ":")) + "\n").encode()


def _read(path: Path, *, maximum: int, canonical: bool) -> bytes:
    descriptor = os.open(path, os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW)
    try:
        before = os.fstat(descriptor)
        if (
            not stat.S_ISREG(before.st_mode)
            or before.st_nlink != 1
            or not 0 < before.st_size <= maximum
        ):
            raise EvidenceError("artifact evidence input is unsafe")
        raw = b""
        while len(raw) < before.st_size:
            chunk = os.read(descriptor, before.st_size - len(raw))
            if not chunk:
                raise EvidenceError("artifact evidence input changed")
            raw += chunk
        after = os.fstat(descriptor)
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (
            after.st_dev,
            after.st_ino,
            after.st_size,
            after.st_mtime_ns,
        ):
            raise EvidenceError("artifact evidence input changed")
    finally:
        os.close(descriptor)
    if canonical:
        try:
            document = json.loads(raw)
        except (UnicodeDecodeError, json.JSONDecodeError) as error:
            raise EvidenceError("attestation is invalid") from error
        if not isinstance(document, dict) or raw != _canonical(document):
            raise EvidenceError("attestation must use canonical JSON")
    return raw


def _write_new(path: Path, raw: bytes) -> None:
    descriptor = os.open(
        path,
        os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC | os.O_NOFOLLOW,
        0o644,
    )
    try:
        os.write(descriptor, raw)
        os.fsync(descriptor)
    finally:
        os.close(descriptor)


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="collect-platform-artifact-evidence")
    parser.add_argument("--locator", required=True)
    parser.add_argument("--name", required=True)
    parser.add_argument("--reference", required=True)
    parser.add_argument("--manifest", required=True, type=Path)
    parser.add_argument("--sbom", required=True, type=Path)
    parser.add_argument("--provenance", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    args = parser.parse_args(argv)
    try:
        reference = _REFERENCE.fullmatch(args.reference)
        if (
            reference is None
            or _LOCATOR.fullmatch(args.locator) is None
            or _NAME.fullmatch(args.name) is None
        ):
            raise EvidenceError("artifact evidence identity is invalid")
        manifest = _read(args.manifest, maximum=_MAX_MANIFEST, canonical=False)
        if hashlib.sha256(manifest).hexdigest() != reference.group("digest"):
            raise EvidenceError("OCI manifest digest does not match reference")
        sbom = _read(args.sbom, maximum=_MAX_EVIDENCE, canonical=True)
        provenance = _read(args.provenance, maximum=_MAX_EVIDENCE, canonical=True)
        document = {
            "artifact": {
                "name": args.name,
                "provenance_sha256": hashlib.sha256(provenance).hexdigest(),
                "reference": args.reference,
                "sbom_sha256": hashlib.sha256(sbom).hexdigest(),
                "sha256": reference.group("digest"),
                "size": len(manifest),
            },
            "locator": args.locator,
            "schema_version": 1,
        }
        _write_new(args.output, _canonical(document))
    except (EvidenceError, OSError) as error:
        print(f"collect-platform-artifact-evidence: {error}", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
