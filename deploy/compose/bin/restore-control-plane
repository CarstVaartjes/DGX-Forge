#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s BACKUP DECRYPT_COMMAND --apply\n' "$0" >&2
    exit 2
}

(( $# == 3 )) || usage
[[ $3 == --apply ]] || usage
backup=$1
decrypt_command=$2
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../../.." && pwd)
state_path=${DGX_STATE_PATH:-/srv/dgx-forge/state}
hermes_data_root=${HERMES_DATA_ROOT:?set Hermes data root}
hermes_uid=${HERMES_UID:-1100}
hermes_gid=${HERMES_GID:-1100}
[[ $hermes_data_root == /* && $hermes_data_root != / && ! -L $hermes_data_root ]] || {
    printf 'restore: Hermes data root is unsafe\n' >&2
    exit 2
}
[[ $hermes_uid =~ ^[1-9][0-9]*$ && $hermes_gid =~ ^[1-9][0-9]*$ ]] || {
    printf 'restore: Hermes UID/GID are invalid\n' >&2
    exit 2
}
temporary=$(mktemp -d)
cleanup() { rm -r -- "$temporary"; }
trap cleanup EXIT

docker compose -f "$repo_root/deploy/compose/compose.yaml" stop control-api control-worker hermes-agent
mkdir -p -- "$state_path"
exec 9>"$state_path/offline.lock"
if ! flock -n 9; then
    printf 'restore: an API, worker, or maintenance operation still holds the state lock\n' >&2
    exit 3
fi

uv run --project "$repo_root/control" python -m dgx_control.offline \
    --state-path "$state_path" extract-backup "$backup" "$temporary/verified" \
    --decrypt-command "$decrypt_command"

docker compose -f "$repo_root/deploy/compose/compose.yaml" exec -T postgres \
    pg_restore --clean --if-exists -U control -d control \
    <"$temporary/verified/database.dump"

install -d -m 0700 -o "$hermes_uid" -g "$hermes_gid" -- "$hermes_data_root"
restore_hermes_tree() {
    local name=$1
    local source="$temporary/verified/$name"
    local target="$hermes_data_root/$name"
    local staged="$hermes_data_root/.$name.restore.$$"
    local previous="$hermes_data_root/.$name.previous.$$"
    [[ -d $source && ! -L $source && ! -L $target ]] || {
        printf 'restore: verified Hermes %s tree is unsafe or missing\n' "$name" >&2
        exit 2
    }
    install -d -m 0700 -o "$hermes_uid" -g "$hermes_gid" -- "$staged"
    cp -a -- "$source/." "$staged/"
    chown -R -- "$hermes_uid:$hermes_gid" "$staged"
    chmod -R go-rwx -- "$staged"
    if [[ -e $target ]]; then
        mv -- "$target" "$previous"
    fi
    mv -- "$staged" "$target"
    if [[ -e $previous ]]; then
        rm -rf -- "$previous"
    fi
}

restore_hermes_tree data
restore_hermes_tree workspaces

# Hermes deliberately remains stopped. Normal startup must first restore fresh
# presence observations and a valid LiteLLM route lease.
