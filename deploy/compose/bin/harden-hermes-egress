#!/usr/bin/env bash
set -Eeuo pipefail

usage() {
    printf 'Usage: %s [--check|--apply|--verify]\n' "$0" >&2
    exit 2
}

mode=${1:---check}
(( $# <= 1 )) || usage
[[ $mode == --check || $mode == --apply || $mode == --verify ]] || usage

docker_bin=${DOCKER_BIN:-docker}
iptables_bin=${IPTABLES_BIN:-iptables}
project=${COMPOSE_PROJECT_NAME:-vonk-forge-control}
chain=VONK_HERMES_EGRESS

[[ $project =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,62}$ ]] || {
    printf 'ERROR: invalid Compose project name\n' >&2
    exit 1
}
[[ -x $docker_bin || -n $(command -v -- "$docker_bin" 2>/dev/null) ]] || {
    printf 'ERROR: Docker CLI is unavailable\n' >&2
    exit 1
}
[[ -x $iptables_bin || -n $(command -v -- "$iptables_bin" 2>/dev/null) ]] || {
    printf 'ERROR: iptables is unavailable\n' >&2
    exit 1
}

normalize_cidr() {
    python3 - "$1" <<'PY'
import ipaddress
import sys

try:
    network = ipaddress.ip_network(sys.argv[1], strict=True)
except ValueError:
    raise SystemExit(1)
if network.version != 4 or network.prefixlen < 8 or network.network_address.is_unspecified:
    raise SystemExit(1)
print(network)
PY
}

network_name="${project}_hermes-egress"
source_output=$("$docker_bin" network inspect "$network_name" \
    --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}') || {
    printf 'ERROR: Hermes egress network is unavailable\n' >&2
    exit 1
}
[[ -n $source_output ]] || {
    printf 'ERROR: Hermes egress network has no subnet\n' >&2
    exit 1
}
mapfile -t source_rows <<<"$source_output"
(( ${#source_rows[@]} == 1 )) || {
    printf 'ERROR: Hermes egress network must have exactly one subnet\n' >&2
    exit 1
}
source_cidr=$(normalize_cidr "${source_rows[0]}") || {
    printf 'ERROR: Hermes egress subnet is invalid\n' >&2
    exit 1
}

destinations=()
add_destination() {
    local candidate normalized existing
    candidate=$1
    normalized=$(normalize_cidr "$candidate") || {
        printf 'ERROR: unsafe egress destination CIDR: %s\n' "$candidate" >&2
        exit 1
    }
    [[ $normalized != "$source_cidr" ]] || return 0
    for existing in "${destinations[@]:-}"; do
        [[ $existing != "$normalized" ]] || return 0
    done
    destinations+=("$normalized")
}

add_csv() {
    local raw item
    raw=$1
    [[ $raw != *'$'* && $raw != *'{'* && $raw != *'}'* ]] || {
        printf 'ERROR: unresolved CIDR value\n' >&2
        exit 1
    }
    IFS=',' read -r -a values <<<"$raw"
    for item in "${values[@]}"; do
        [[ -n $item ]] && add_destination "$item"
    done
}

add_csv "${VONK_MANAGEMENT_CIDRS:-10.0.0.0/24}"
add_csv "${VONK_DIRECT_FABRIC_CIDRS:-}"
add_destination 169.254.0.0/16

project_output=$("$docker_bin" network ls \
    --filter "name=^${project}_" \
    --format '{{.Name}}') || {
    printf 'ERROR: Compose project networks cannot be resolved\n' >&2
    exit 1
}
project_networks=()
[[ -z $project_output ]] || mapfile -t project_networks <<<"$project_output"
for name in "${project_networks[@]}"; do
    [[ $name == "${project}_"* && $name =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$ ]] || {
        printf 'ERROR: Docker returned an unsafe project network name\n' >&2
        exit 1
    }
    [[ $name != "$network_name" ]] || continue
    rows_output=$("$docker_bin" network inspect "$name" \
        --format '{{range .IPAM.Config}}{{println .Subnet}}{{end}}') || {
        printf 'ERROR: project network %s cannot be inspected\n' "$name" >&2
        exit 1
    }
    [[ -n $rows_output ]] || {
        printf 'ERROR: project network %s has no subnet\n' "$name" >&2
        exit 1
    }
    mapfile -t rows <<<"$rows_output"
    (( ${#rows[@]} == 1 )) || {
        printf 'ERROR: project network %s must have exactly one subnet\n' "$name" >&2
        exit 1
    }
    add_destination "${rows[0]}"
done

render_plan() {
    printf '%q ' "$iptables_bin" -N "$chain"
    printf '\n'
    printf '%q ' "$iptables_bin" -F "$chain"
    printf '\n'
    for destination in "${destinations[@]}"; do
        printf '%q ' "$iptables_bin" -A "$chain" -s "$source_cidr" -d "$destination" -j REJECT
        printf '\n'
    done
    printf '%q ' "$iptables_bin" -A "$chain" -j RETURN
    printf '\n'
    printf '%q ' "$iptables_bin" -I DOCKER-USER 1 -s "$source_cidr" -j "$chain"
    printf '\n'
}

if [[ $mode == --check ]]; then
    render_plan
    exit 0
fi

if [[ $mode == --apply ]]; then
    "$iptables_bin" -N "$chain" 2>/dev/null || "$iptables_bin" -L "$chain" >/dev/null
    "$iptables_bin" -F "$chain"
    for destination in "${destinations[@]}"; do
        "$iptables_bin" -A "$chain" -s "$source_cidr" -d "$destination" -j REJECT
    done
    "$iptables_bin" -A "$chain" -j RETURN
    "$iptables_bin" -D DOCKER-USER -s "$source_cidr" -j "$chain" >/dev/null 2>&1 || true
    "$iptables_bin" -I DOCKER-USER 1 -s "$source_cidr" -j "$chain"
    exit 0
fi

"$iptables_bin" -C DOCKER-USER -s "$source_cidr" -j "$chain"
for destination in "${destinations[@]}"; do
    "$iptables_bin" -C "$chain" -s "$source_cidr" -d "$destination" -j REJECT
done
"$iptables_bin" -C "$chain" -j RETURN
