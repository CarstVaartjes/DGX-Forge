#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s OUTPUT ENCRYPT_COMMAND\n' "$0" >&2
    exit 2
}

(( $# == 2 )) || usage
output=$1
encrypt_command=$2
script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
repo_root=$(cd -- "$script_dir/../../.." && pwd)
temporary=$(mktemp -d)
cleanup() { rm -r -- "$temporary"; }
trap cleanup EXIT

docker compose -f "$repo_root/deploy/compose/compose.yaml" exec -T postgres \
    pg_dump -Fc -U control control >"$temporary/database.dump"

uv run --project "$repo_root/control" python -m dgx_control.offline backup \
    --database-dump "$temporary/database.dump" \
    --config "$repo_root/deploy/compose" \
    --output "$output" \
    --encrypt-command "$encrypt_command"

state_path=${DGX_STATE_PATH:-/srv/dgx-forge/state}
mkdir -p -- "$state_path"
marker=$(mktemp "$state_path/.last-backup.XXXXXX")
chmod 600 -- "$marker"
date +%s >"$marker"
mv -f -- "$marker" "$state_path/last-successful-backup.epoch"
