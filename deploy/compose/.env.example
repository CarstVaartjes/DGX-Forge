# Every production image reference must contain @sha256:<digest>.
POSTGRES_IMAGE=postgres:17@sha256:REPLACE_WITH_VERIFIED_DIGEST
CADDY_IMAGE=caddy:2@sha256:REPLACE_WITH_VERIFIED_DIGEST
CONTROL_IMAGE=ghcr.io/OWNER/dgx-control:VERSION@sha256:REPLACE_WITH_RELEASE_DIGEST
REPOSITORY_PATH=/srv/dgx-forge/repository
DATABASE_URL_FILE=/srv/dgx-forge/secrets/database-url
POSTGRES_PASSWORD_FILE=/srv/dgx-forge/secrets/postgres-password
TOKEN_SIGNING_KEY_FILE=/srv/dgx-forge/secrets/token-signing-key
HTTPS_BIND=0.0.0.0:443
