{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DGX Spark raw inventory",
  "type": "object",
  "required": [
    "hostname",
    "boot_id",
    "os",
    "kernel",
    "memory",
    "swap",
    "disks",
    "earlyoom",
    "nvidia",
    "docker",
    "interfaces",
    "rdma",
    "thermal"
  ],
  "properties": {
    "hostname": {"type": "string", "minLength": 1},
    "boot_id": {"type": "string"},
    "os": {"type": ["object", "null"]},
    "kernel": {"type": ["object", "null"]},
    "memory": {
      "type": ["object", "null"],
      "properties": {
        "total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "available_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "swap": {
      "type": ["object", "null"],
      "properties": {
        "total_bytes": {"type": ["integer", "null"], "minimum": 0},
        "free_bytes": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "disks": {"type": "array"},
    "filesystems": {"type": "array"},
    "earlyoom": {"type": ["object", "null"]},
    "nvidia": {"type": ["array", "null"]},
    "docker": {"type": ["object", "null"]},
    "interfaces": {"type": "array"},
    "rdma": {"type": ["object", "null"]},
    "thermal": {"type": ["array", "null"]}
  },
  "additionalProperties": false
}
