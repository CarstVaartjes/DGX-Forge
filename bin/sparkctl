#!/usr/bin/env python3
"""Repository-local launcher for the developer Spark profile controller."""

from pathlib import Path
import sys


REPOSITORY_ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(REPOSITORY_ROOT / "src"))

from spark_profiles.cli import main  # noqa: E402


if __name__ == "__main__":
    raise SystemExit(main(root=REPOSITORY_ROOT))
